{%- render 'blko-fonts-veil', tokens: s.tokens -%}
{%- comment -%}
  Before after 13, two faces and a benefit list (ported from registry/before-after/before-after-13.tsx). Veil.
  Two arch-topped photos of the same person side by side, each with a solid label chip at its foot ("Before";
  "After" + "Wearing [shade]"). Beside them: a heading, the benefit lines (blocks, large and light, hairlines between),
  and the shade row: product name, shade, price, Add to bag and "Shop this shade".
  1440: lines and the shade row on the left (5 of 12 cols), photos on the right (7 cols). Phones: photos first, then
  the heading and lines, then the shade row.
  Live: the Product setting (blank on a product page: the page's product). The shade setting is matched to a variant by
  title or option value (no match: the selected or first available variant, and the editor shows a note). Add posts
  that variant to cart/add.js (routes.root_url): Adding, then Added + View bag and cart:refresh; an error shows the
  message and the button comes back; a sold-out variant locks the button and says why. No JS: the row is a native
  /cart/add form, so Add still works. No product: the preview name and price, and Add is simulated.
  Motion (html.blko-ui-motion, no reduced motion): the lines fade in one after another once in view. Static = this
  layout. Buttons never move: the label swaps.
{%- endcomment -%}
{%- liquid
  assign main = s.product | default: product
  assign live = false
  if main != blank
    assign live = true
  endif
  assign shade = s.shade | strip
  assign shade_l = shade | downcase
  assign v = nil
  assign matched = false
  if live
    for x in main.variants
      assign xt = x.title | downcase
      if xt == shade_l
        assign v = x
        assign matched = true
        break
      endif
      for o in x.options
        assign ol = o | downcase
        if ol == shade_l
          assign v = x
          assign matched = true
        endif
      endfor
      if matched
        break
      endif
    endfor
    if v == nil
      assign v = main.selected_or_first_available_variant
    endif
    assign p_name = main.title
    assign p_price = v.price
    assign p_url = main.url | append: '?variant=' | append: v.id
    assign sold = false
    unless v.available
      assign sold = true
    endunless
  else
    assign p_name = s.preview_title
    assign p_price = s.preview_price | times: 100 | round
    assign p_url = s.preview_url | default: '#'
    assign sold = s.preview_sold
  endif
  capture m_price
    render 'blko-ui-money', amount: p_price, cents: true
  endcapture
  assign after_sub = s.after_shade_text | replace: '[shade]', shade
  assign sold_line = s.sold_text | replace: '[shade]', shade
-%}
<div class="bbeforeafter13" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-bbeforeafter13
  ><section class="bbeforeafter13__wrap" aria-label="{{ s.heading | escape }}"
    ><div class="bbeforeafter13__pair"
      >{%- for k in (1..2) -%}
        {%- liquid
          if k == 1
            assign im = s.before_image
            assign lab = s.before_label
            assign sub = ''
          else
            assign im = s.after_image
            assign lab = s.after_label
            assign sub = after_sub
          endif
        -%}
        <figure class="bbeforeafter13__fig"
          >{%- if im != blank -%}
            {{ im | image_url: width: 1000 | image_tag: class: 'bbeforeafter13__img', loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 1024px) 30vw, 50vw', alt: im.alt -}}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'bbeforeafter13__img bbeforeafter13__img--ph' -}}
          {%- endif -%}
          <figcaption class="bbeforeafter13__cap"><span class="bbeforeafter13__chip"><b>{{ lab | escape }}</b>{% if sub != blank %}<span>{{ sub | escape }}</span>{% endif %}</span></figcaption
        ></figure
      >{%- endfor -%}
    </div
    ><div class="bbeforeafter13__text"
      ><h2 class="bbeforeafter13__heading">{{ s.heading | escape }}</h2
      >{%- assign n = 0 -%}
      {%- for b in section.blocks -%}{%- if b.type == 'line' and b.settings.text != blank -%}{%- assign n = n | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if n > 0 -%}
        <ul class="bbeforeafter13__lines" role="list" aria-label="{{ 'blko.before_after_13.benefits' | t }}"
          >{%- assign i = 0 -%}
          {%- for b in section.blocks -%}
            {%- if b.type == 'line' and b.settings.text != blank -%}
              <li class="bbeforeafter13__line" style="--i: {{ i }}" {{ b.shopify_attributes }}>{{ b.settings.text | escape }}</li
              >{%- assign i = i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </ul
      >{%- endif -%}
      <blko-ba-add class="bbeforeafter13__buy"{% if live %} data-live{% endif %}{% if request.design_mode %} data-editor{% endif %} data-root="{{ routes.root_url }}" data-t-add="{{ s.add_label | escape }}" data-t-adding="{{ s.adding_label | escape }}" data-t-added="{{ s.added_label | escape }}" data-t-sold="{{ s.sold_label | escape }}" data-t-in-bag="{{ s.in_bag_text | replace: '[shade]', shade | escape }}" data-t-view="{{ s.view_label | escape }}" data-t-error="{{ s.error_text | escape }}" data-cart-url="{{ routes.cart_url }}"
        ><p class="bbeforeafter13__product"><b>{{ p_name | escape }}</b> {{ s.in_word | escape }} {{ shade | escape }}, <span class="bbeforeafter13__price">{{ m_price }}</span></p
        ><form class="bbeforeafter13__row" action="{{ routes.cart_add_url }}" method="post"
          >{%- if live -%}<input type="hidden" name="id" value="{{ v.id }}"><input type="hidden" name="quantity" value="1">{%- endif -%}
          {%- capture lbl -%}<span data-cta>{% if sold %}{{ s.sold_label | escape }}{% else %}{{ s.add_label | escape }}{% endif %}</span>{%- endcapture -%}
          {%- capture at -%}data-add{% if sold %} disabled{% endif %}{%- endcapture -%}
          {%- render 'blko-ui-button', size: 'lg', type: 'submit', children: lbl, attrs: at -%}
          <a class="bbeforeafter13__shop" href="{{ p_url }}">{{ s.shop_label | escape }}</a
        ></form
        ><p class="bbeforeafter13__status" role="status" data-status>{% if sold %}{{ sold_line | escape }}{% endif %}</p
        >{%- if request.design_mode and live and matched == false -%}
          <p class="bbeforeafter13__note">{{ s.nomatch_note | replace: '[shade]', shade | escape }}</p
        >{%- endif -%}
      </blko-ba-add
    ></div
  ></section
></div

>

