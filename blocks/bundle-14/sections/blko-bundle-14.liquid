      "id": "discount_pct",
      "label": "Full kit, % off",
      "info": "Shown only. Set the same discount as an automatic discount in Shopify admin. 0 hides the sale price and the savings line.",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "text",
      "id": "sold",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "variant_aria",
      "label": "Variant menu (screen readers)",
      "default": "Choose a variant of [name]"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Isle)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Travel pouch",
      "blocks": [
        {
          "type": "mini",
          "settings": {
            "title": "Foaming cleanser",
            "ml": 50,
            "price": 10,
            "selected": false
          }
        },
        {
          "type": "mini",
          "settings": {
            "title": "Vitamin C serum",
            "ml": 15,
            "price": 16,
            "selected": true
          }
        },
        {
          "type": "mini",
          "settings": {
            "title": "Gel cream",
            "ml": 30,
            "price": 14,
            "selected": true
          }
        },
        {
          "type": "mini",
          "settings": {
            "title": "Daily SPF 30 lotion",
            "ml": 30,
            "price": 13,
            "selected": false
          }
        },
        {
          "type": "mini",
          "settings": {
            "title": "Night face oil",
            "ml": 20,
            "price": 15,
            "selected": false
          }
        },
        {
          "type": "mini",
          "settings": {
            "title": "Rose lip and cheek balm",
            "ml": 15,
            "price": 12,
            "selected": false
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "mini",
      "name": "Mini",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mini"
        },
        {
          "type": "number",
          "id": "ml",
          "label": "Ml",
          "default": 15
        },
        {
          "type": "number",
