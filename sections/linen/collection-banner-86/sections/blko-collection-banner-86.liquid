{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
<script data-blko-kit="linen">try { if (!new URLSearchParams(location.search).has('static') && !navigator.webdriver && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('blko-kit-linen'); } catch (e) {}</script>
{{ 'blko-linen-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-linen-motion.js' | asset_url }}" defer="defer"></script>

<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
{{ 'blko-collection-banner-86.css' | asset_url | stylesheet_tag }}
{%- render 'blko-fonts-linen', mode: 'faces', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font -%}
{%- capture blko_style -%}{% render 'blko-fonts-linen', mode: 'vars', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font %}--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px{%- endcapture -%}
{%- capture blko_class -%}bcollectionbanner86{% if s.tokens == 'theme' %} bcollectionbanner86--theme{% endif %}{% if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}{%- endcapture -%}
{%- liquid
  assign c = collection
  assign title = s.heading
  assign text = s.text
  assign img = s.image
  assign count = s.demo_count
  if c.title != blank
    assign title = c.title
    assign count = c.products_count
    if c.description != blank
      assign text = c.description | strip_html | truncatewords: 24
    endif
    if c.image != blank and s.image == blank
      assign img = c.image
    endif
  endif
  assign crumbs_label = 'blko.collection_banner_86.breadcrumb' | t
  assign region = 'blko.collection_banner_86.label' | t
-%}
{%- capture blko_body -%}
    <nav aria-label="{{ crumbs_label }}"><ol class="bcollectionbanner86__crumbs"><li><a href="{{ routes.root_url }}" class="bcollectionbanner86__crumb">{{ s.home_label | escape }}</a></li><li aria-hidden="true">/</li><li aria-current="page">{{ title | escape }}</li></ol></nav>
    <div class="bcollectionbanner86__book">
      <div class="bcollectionbanner86__copy"><div class="bcollectionbanner86__intro"><p class="bcollectionbanner86__kicker">{{ s.kicker | escape }}</p><h1 class="bcollectionbanner86__title">{% render 'blko-linen-mixed', text: title %}</h1>{% if text != blank %}<p class="bx-body bcollectionbanner86__text">{{ text | escape }}</p>{% endif %}</div><div class="bcollectionbanner86__foot">{% if s.show_count %}<p class="bcollectionbanner86__count">{{ 'blko.collection_banner_86.count_html' | t: count: count }}</p>{% endif %}<p class="bcollectionbanner86__cap">{{ s.footnote | escape }}</p></div></div>
      <figure class="bcollectionbanner86__plate"><div class="bcollectionbanner86__photo">{% if img != blank %}{{ img | image_url: width: 1600 | image_tag: class: 'bcollectionbanner86__img', loading: 'eager', widths: '500, 800, 1200, 1600', sizes: '(min-width: 768px) 65vw, 100vw', alt: img.alt }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'bcollectionbanner86__img' }}{% endif %}</div><figcaption class="bcollectionbanner86__ledger"><p class="bcollectionbanner86__captions"><span>{{ s.tones_label | escape }}</span><span>{{ s.tones_caption | escape }}</span></p><ol class="bcollectionbanner86__samples">{% for i in (1..4) %}{% assign ck = 'tone_' | append: i %}{% assign nk = 'tone_name_' | append: i %}{% if s[nk] != blank %}<li><span class="bcollectionbanner86__sample" aria-hidden="true" style="background:{{ s[ck] }}"></span><span class="bcollectionbanner86__sampletext"><span>{{ s[nk] | escape }}</span><span>0{{ i }}</span></span></li>{% endif %}{% endfor %}</ol></figcaption></figure>
    </div>
{%- endcapture -%}
{%- render 'blko-ui-section', surface: 'bg', bleed: false, full: false, label: region, className: blko_class, style: blko_style, inner: 'bx-pad bcollectionbanner86__in', children: blko_body -%}

{% schema %}
{
  "name": "Collection, cloth book",
  "tag": "div",
  "class": "blko-collection-banner-86-wrap",
  "settings": [
    {
      "type": "paragraph",
      "content": "On a collection page the title, description, image and product count come from the collection. The fields below fill in elsewhere."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Index label",
      "default": "The cloth room / 01"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Natural cloth. An everyday wardrobe."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Overrides the collection image."
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home crumb",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All clothing"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Linen, cotton and wool, cut to be worn for years."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "range",
      "id": "demo_count",
      "label": "Demo count",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Cloth tones"
    },
    {
      "type": "text",
      "id": "tones_label",
      "label": "Swatch list label",
      "default": "Cloth tones",
      "info": "Read by screen readers."
    },
    {
      "type": "text",
      "id": "tones_caption",
      "label": "Caption",
      "default": "Chalk \u00b7 Oat \u00b7 Sand \u00b7 Sky"
    },
    {
      "type": "color",
      "id": "tone_1",
      "label": "Tone 1",
      "default": "#f2eee6"
    },
    {
      "type": "text",
      "id": "tone_name_1",
      "label": "Tone 1 name",
      "default": "Chalk"
    },
    {
      "type": "color",
      "id": "tone_2",
      "label": "Tone 2",
      "default": "#d8c9ad"
    },
    {
      "type": "text",
      "id": "tone_name_2",
      "label": "Tone 2 name",
      "default": "Oat"
    },
    {
      "type": "color",
      "id": "tone_3",
      "label": "Tone 3",
      "default": "#b49c78"
    },
    {
      "type": "text",
      "id": "tone_name_3",
      "label": "Tone 3 name",
      "default": "Sand"
    },
    {
      "type": "color",
      "id": "tone_4",
      "label": "Tone 4",
      "default": "#8ea6c1"
    },
    {
      "type": "text",
      "id": "tone_name_4",
      "label": "Tone 4 name",
      "default": "Sky"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Fonts",
      "options": [
        {
          "value": "bundled",
          "label": "Bundled (EB Garamond + Albert Sans)"
        },
        {
          "value": "picker",
          "label": "Pick from the font library"
        },
        {
          "value": "theme",
          "label": "Use the theme's fonts"
        }
      ],
      "default": "bundled"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Colors and shapes"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, corners, type style",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Linen)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-radius-card, --blko-theme-button-case\u2026). Other themes: keep the preset."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blko.linen.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Collection, cloth book"
    }
  ]
}
{% endschema %}
