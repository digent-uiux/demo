{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-reviews-31.css' | asset_url | stylesheet_tag }}
{%- render 'blko-fonts-linen', mode: 'faces', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font -%}
{%- capture blko_style -%}{% render 'blko-fonts-linen', mode: 'vars', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font %}--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px{%- endcapture -%}
{%- capture blko_class -%}breviews31{% if s.tokens == 'theme' %} breviews31--theme{% endif %}{% if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}{%- endcapture -%}
<script src="{{ 'blko-reviews-31.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign label = 'blko.reviews_31.label' | t
  assign stages = section.blocks | where: 'type', 'stage'
  assign reviews = section.blocks | where: 'type', 'review'
  assign start = 'all'
  for st in stages
    if st.settings.start
      assign start = forloop.index0
    endif
  endfor
  assign total = s.n5 | plus: s.n4 | plus: s.n3 | plus: s.n2 | plus: s.n1
  assign total_safe = total | at_least: 1
  assign counts = '5,4,3,2,1' | split: ','
-%}
{%- capture blko_body -%}
  <blko-reviews-31 class="breviews31__app" data-start="{{ start }}" data-one="{{ s.one | escape }}" data-many="{{ s.many | escape }}" data-at="{{ s.at | escape }}" data-stars="{{ s.stars_word | escape }}" data-more="{{ s.more_label | escape }}">
    <div class="breviews31__top">
      <header class="breviews31__head">
        <h2 class="breviews31__title">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p class="bx-body bx-muted breviews31__lead">{{ s.text | escape }}</p>{%- endif -%}
      </header>
      <div class="breviews31__score">
        <div class="breviews31__sum">
          <span class="breviews31__num">{{ s.score }}</span>
          <span class="breviews31__sumr">
            {%- assign stars_label = 'blko.reviews_31.stars' | t: count: s.score -%}
            {%- render 'blko-reviews-31-stars', value: s.score, label: stars_label -%}
            <span class="bx-small bx-muted">{{ total }} {{ s.many | escape }}</span>
          </span>
        </div>
        <div aria-hidden="true" class="breviews31__bar">
          {%- for c in counts -%}
            {%- assign key = 'n' | append: c -%}
            {%- assign w = s[key] | times: 100.0 | divided_by: total_safe -%}
            <span class="breviews31__seg breviews31__t{{ forloop.index }}" data-seg="{{ c }}" style="width:{{ w }}%"></span>
          {%- endfor -%}
        </div>
        <div role="group" aria-label="{{ s.rating_label | escape }}" class="breviews31__chips">
          {%- for c in counts -%}
            {%- assign key = 'n' | append: c -%}
            <button type="button" class="breviews31__chip" aria-pressed="false" data-star="{{ c }}"><span aria-hidden="true" class="breviews31__dot breviews31__t{{ forloop.index }}"></span>{{ c }}★ {{ s[key] }}</button>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="breviews31__board">
      <div class="breviews31__track">
        <div role="group" aria-label="{{ s.stage_label | escape }}" class="breviews31__thread" style="--n:{{ stages.size | plus: 1 }}">
          <span aria-hidden="true" class="breviews31__line"></span>
          <button type="button" class="breviews31__stage" aria-pressed="{% if start == 'all' %}true{% else %}false{% endif %}" data-stage="all">
            <span class="breviews31__knot">{%- render 'blko-ui-icon', name: 'droplets', size: 16 -%}</span>
            <span class="bx-small breviews31__sl">{{ s.all_label | escape }}</span>
            <span class="bx-label bx-muted breviews31__sc">{{ reviews.size }} {{ s.many | escape }}</span>
          </button>
          {%- for st in stages -%}
            {%- assign n = 0 -%}
            {%- assign me = forloop.index0 -%}
            {%- for r in reviews -%}
              {%- assign si = 0 -%}
              {%- for x in stages -%}{%- if r.settings.washes >= x.settings.min -%}{%- assign si = forloop.index0 -%}{%- endif -%}{%- endfor -%}
              {%- if si == me -%}{%- assign n = n | plus: 1 -%}{%- endif -%}
            {%- endfor -%}
            <button type="button" class="breviews31__stage" aria-pressed="{% if start == me %}true{% else %}false{% endif %}" data-stage="{{ me }}" data-label="{{ st.settings.label | escape }}" {{ st.shopify_attributes }}>
              <span class="breviews31__knot"><span class="bx-label breviews31__kn">{{ st.settings.knot | escape }}</span></span>
              <span class="bx-small breviews31__sl">{{ st.settings.label | escape }}</span>
              <span class="bx-label bx-muted breviews31__sc">{{ n }} {{ s.many | escape }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>
      {%- for st in stages -%}
        <div class="breviews31__panel" data-panel="{{ forloop.index0 }}"{% unless start == forloop.index0 %} hidden{% endunless %}>
          <p class="breviews31__say">{{ st.settings.intro | escape }}: {{ st.settings.line | escape }}</p>
          <dl class="breviews31__meters">
            {%- assign mk = 'soft,colour,shape' | split: ',' -%}
            {%- for k in mk -%}
              {%- assign lk = 'm_' | append: k -%}
              <div class="breviews31__meter">
                <dt class="bx-small breviews31__mt"><span>{{ s[lk] | escape }}</span><span class="bx-muted">{{ st.settings[k] }}%</span></dt>
                <dd class="breviews31__mb"><span style="width:{{ st.settings[k] }}%"></span></dd>
              </div>
            {%- endfor -%}
          </dl>
        </div>
      {%- endfor -%}
      <p class="bx-small bx-muted breviews31__panel breviews31__allp" data-panel="all"{% unless start == 'all' %} hidden{% endunless %}>{{ s.all_text | escape }}</p>
    </div>

    <div class="breviews31__bar2">
      <p aria-live="polite" class="bx-small bx-muted" data-count>{{ reviews.size }} {{ s.many | escape }}</p>
      <label class="bx-small breviews31__sort">
        {{ s.sort_label | escape }}
        <span class="bx-select breviews31__sel">
          <select class="bx-input" data-sort>
            <option value="washes">{{ s.sort_washes | escape }}</option>
            <option value="recent">{{ s.sort_recent | escape }}</option>
            <option value="helpful">{{ s.sort_helpful | escape }}</option>
          </select>
          {%- render 'blko-ui-icon', name: 'chevron-down', size: 16 -%}
        </span>
      </label>
    </div>

    <ul class="breviews31__list" data-list>
      {%- for r in reviews -%}
        {%- assign rs = r.settings -%}
        {%- assign si = 0 -%}
        {%- for x in stages -%}{%- if rs.washes >= x.settings.min -%}{%- assign si = forloop.index0 -%}{%- endif -%}{%- endfor -%}
        {%- assign has_photo = false -%}
        {%- if rs.photo != blank or rs.placeholder -%}{%- assign has_photo = true -%}{%- endif -%}
        <li class="breviews31__card{% if has_photo %} breviews31__card--photo{% endif %}" data-review data-stage="{{ si }}" data-stars="{{ rs.stars }}" data-washes="{{ rs.washes }}" data-order="{{ forloop.index0 }}" data-helpful="{{ rs.helpful }}" {{ r.shopify_attributes }}>
          {%- if has_photo -%}
            <div class="breviews31__ph">
              {%- if rs.photo != blank -%}
                {{ rs.photo | image_url: width: 800 | image_tag: class: 'breviews31__img', loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 768px) 50vw, 100vw', alt: rs.photo.alt }}
              {%- else -%}
                {{ 'apparel-1' | placeholder_svg_tag: 'breviews31__img' }}
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="breviews31__row">
            <span class="bx-label breviews31__wash">{{ s.wash_label | escape }} {{ rs.washes }}</span>
            {%- assign stars_label = 'blko.reviews_31.stars' | t: count: rs.stars -%}
            {%- render 'blko-reviews-31-stars', value: rs.stars, label: stars_label -%}
          </div>
          <h3 class="breviews31__rt">{{ rs.title | escape }}</h3>
          <p class="bx-body bx-muted breviews31__rb">{{ rs.body | escape }}</p>
          <ul aria-label="{{ s.care_label | escape }}" class="bx-label breviews31__care">
            {%- if rs.colour != blank -%}<li>{{ rs.colour | escape }}</li>{%- endif -%}
            {%- assign care = rs.care | split: ',' -%}
            {%- for c in care -%}{%- assign cc = c | strip -%}{%- if cc != blank -%}<li>{{ cc | escape }}</li>{%- endif -%}{%- endfor -%}
          </ul>
          <div class="breviews31__foot">
            <span class="bx-small"><span class="breviews31__who">{{ rs.who | escape }}</span> <span class="bx-muted">· {{ rs.place | escape }} · {{ rs.date | escape }}</span></span>
            <button type="button" class="breviews31__use" aria-pressed="false" data-useful data-n="{{ rs.helpful }}">
              {%- render 'blko-ui-icon', name: 'check', size: 16, className: 'breviews31__uc' -%}
              <span>{{ s.useful_label | escape }} · <span data-un>{{ rs.helpful }}</span></span>
            </button>
          </div>
        </li>
      {%- endfor -%}
      <li class="breviews31__card breviews31__empty" data-empty hidden>
        <p class="breviews31__et">{{ s.empty_title | escape }}</p>
        <button type="button" class="bx-small breviews31__reset" data-reset>{{ s.empty_reset | escape }}</button>
      </li>
    </ul>

    <div class="breviews31__morew" data-morew hidden>
      <button type="button" class="breviews31__more" data-moreb>{{ s.more_label | escape }}</button>
    </div>
  </blko-reviews-31>
{%- endcapture -%}
{%- render 'blko-ui-section', surface: 'soft-2', bleed: true, label: label, className: blko_class, style: blko_style, inner: 'bx-pad breviews31__in', children: blko_body -%}

{% schema %}
