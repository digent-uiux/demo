{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-4'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
<script data-blko-kit="linen">try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-kit-linen')}catch(e){}</script>
{{ 'blko-linen-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-linen-motion.js' | asset_url }}" defer></script>

{{ 'blko-contact-54.css' | asset_url | stylesheet_tag }}
{%- render 'blko-fonts-linen', mode: 'faces', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font -%}
{%- capture blko_style -%}{% render 'blko-fonts-linen', mode: 'vars', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font %}--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px{%- endcapture -%}
{%- capture blko_class -%}bcontact54{% if s.tokens == 'theme' %} bcontact54--theme{% endif %}{% if blko_sid != 'scheme-4' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}{%- endcapture -%}
<script src="{{ 'blko-contact-54.js' | asset_url }}" defer="defer"></script>
{%- assign label = 'blko.contact_54.label' | t -%}
{%- capture blko_body -%}
  <blko-contact-54 data-alert="{{ s.alert | escape }}">
    {%- form 'contact', id: 'blko-c54-form', class: 'bcontact54__form' -%}
      <div class="bcontact54__row">
        <div class="bcontact54__lead">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 1200 | image_tag: class: 'bcontact54__img', loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 768px) 45vw, 100vw', alt: s.image.alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'bcontact54__img' }}
          {%- endif -%}
          <div class="bcontact54__copy">
            <p class="bx-label bcontact54__kicker">{{ s.kicker | escape }}</p><h2 class="bcontact54__title">{{ s.heading | escape }}</h2>
            <p class="bx-small bcontact54__where">
              {%- render 'blko-ui-icon', name: 'map-pin', size: 20, className: 'bcontact54__pin' -%}
              {%- if s.address != blank -%}<span>{{ s.address | escape }}</span>{%- endif -%}
              {%- if s.address != blank and s.hours != blank -%}<span aria-hidden="true">·</span>{%- endif -%}
              {%- if s.hours != blank -%}<span>{{ s.hours | escape }}</span>{%- endif -%}
            </p>
            <div class="bcontact54__measure" aria-hidden="true"><span>0</span><span>10</span><span>20</span><span>30 cm</span></div>
          </div>
        </div>

        {%- if form.posted_successfully? -%}
          <p role="status" class="bx-small bcontact54__sent">
            {%- render 'blko-ui-icon', name: 'check', size: 16, className: 'bcontact54__ok' -%}
            <span>{{ s.success | escape }}</span>
          </p>
        {%- else -%}
          <div class="bcontact54__acts" data-acts>
            {%- assign ask = s.ask_label | escape -%}
            {%- capture ask_attrs -%}aria-expanded="false" aria-controls="{{ section.id }}-fields" data-open{%- endcapture -%}
            {%- render 'blko-ui-button', shape: 'pill', attrs: ask_attrs, children: ask -%}
            {%- if s.visit_label != blank -%}
              {%- assign visit = s.visit_label | escape -%}
              {%- render 'blko-ui-button', href: s.visit_url, variant: 'outline', shape: 'pill', iconAfter: 'arrow-up-right', children: visit -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- unless form.posted_successfully? -%}
        <div id="{{ section.id }}-fields" class="bcontact54__fields"{% unless form.errors %} hidden{% endunless %} data-fields>
          {%- if form.errors -%}<p class="bx-small bcontact54__all" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="bcontact54__f">
            <label for="{{ section.id }}-piece" class="bcontact54__lbl">{{ s.piece_label | escape }}</label>
            <input id="{{ section.id }}-piece" name="contact[Piece]" class="bx-input" placeholder="{{ s.piece_placeholder | escape }}" aria-describedby="{{ section.id }}-piece-e" data-piece>
            <p id="{{ section.id }}-piece-e" class="bx-small" data-err="piece" hidden>{{ s.piece_error | escape }}</p>
          </div>
          <fieldset class="bcontact54__f">
            <legend class="bcontact54__lbl bcontact54__lg">{{ s.size_label | escape }}</legend>
            <input type="hidden" name="contact[Size]" value="" data-size>
            <div class="bcontact54__sizes">
              {%- assign list = s.sizes | split: ',' -%}
              {%- for z in list -%}
                {%- assign zz = z | strip | escape -%}
                <button type="button" class="bcontact54__sz" aria-pressed="false" data-sz="{{ zz }}">{{ zz }}</button>
              {%- endfor -%}
            </div>
            <p class="bx-small" data-err="size" hidden>{{ s.size_error | escape }}</p>
          </fieldset>
          <div class="bcontact54__f">
            <label for="{{ section.id }}-email" class="bcontact54__lbl">{{ s.email_label | escape }}</label>
            <input id="{{ section.id }}-email" type="email" name="contact[email]" autocomplete="email" class="bx-input" placeholder="{{ s.email_placeholder | escape }}" aria-describedby="{{ section.id }}-email-e" data-email>
            <p id="{{ section.id }}-email-e" class="bx-small" data-err="email" hidden>{{ s.email_error | escape }}</p>
          </div>
          <div class="bcontact54__send">
            {%- assign send = s.send_label | escape -%}
            {%- render 'blko-ui-button', type: 'submit', shape: 'pill', children: send -%}
            {%- assign close = s.close_label | escape -%}
            {%- render 'blko-ui-button', variant: 'ghost', size: 'icon', shape: 'pill', icon: 'x', label: close, attrs: 'data-close' -%}
          </div>
          <p role="alert" class="bx-sr" data-alert></p>
        </div>
      {%- endunless -%}
    {%- endform -%}
  </blko-contact-54>
{%- endcapture -%}
{%- render 'blko-ui-section', surface: 'pop-3', bleed: true, label: label, className: blko_class, style: blko_style, inner: 'bx-pad bx-flip bcontact54__in', children: blko_body -%}

{% schema %}
{
  "name": "Contact, shop banner",
  "tag": "div",
  "class": "blko-contact-54-wrap",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "default": "The fitting room / by appointment",
      "label": "Index label"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try it on at the shop, or ask us first"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "14 Weavers Row"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Fittings today 10:00\u201317:30"
    },
    {
      "type": "text",
      "id": "ask_label",
      "label": "Ask button label",
      "default": "Ask about a size"
    },
    {
      "type": "text",
      "id": "visit_label",
      "label": "Visit button label",
      "default": "Visit"
    },
    {
      "type": "url",
      "id": "visit_url",
      "label": "Visit link"
    },
    {
      "type": "header",
      "content": "Size question"
    },
    {
      "type": "text",
      "id": "piece_label",
      "label": "Piece label",
      "default": "The piece"
    },
    {
      "type": "text",
      "id": "piece_placeholder",
      "label": "Piece placeholder",
      "default": "e.g. Wrap dress in clay"
    },
    {
      "type": "text",
      "id": "piece_error",
      "label": "Piece error",
      "default": "Name the piece, e.g. the wrap dress"
    },
    {
      "type": "text",
      "id": "size_label",
      "label": "Size label",
      "default": "Usual size"
    },
    {
      "type": "text",
      "id": "sizes",
      "label": "Sizes",
      "default": "XS, S, M, L, XL",
      "info": "Comma separated."
    },
    {
      "type": "text",
      "id": "size_error",
      "label": "Size error",
      "default": "Pick your usual size"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "email_error",
      "label": "Email error",
      "default": "Add an email we can reply to"
    },
    {
      "type": "text",
      "id": "send_label",
      "label": "Send button label",
      "default": "Send"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close button label",
      "default": "Close the size question"
    },
    {
      "type": "text",
      "id": "alert",
      "label": "Error summary",
      "default": "Please fix the highlighted fields."
    },
    {
      "type": "text",
      "id": "success",
      "label": "Thank-you message",
      "default": "Thank you. A stylist will reply about your piece within a working day."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Fonts",
      "options": [
        {
          "value": "bundled",
          "label": "Bundled (EB Garamond + Albert Sans)"
        },
        {
          "value": "picker",
          "label": "Pick from the font library"
        },
        {
          "value": "theme",
          "label": "Use the theme's fonts"
        }
      ],
      "default": "bundled"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Colors and shapes"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, corners, type style",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Linen)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-radius-card, --blko-theme-button-case\u2026). Other themes: keep the preset."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blko.linen.color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Contact, shop banner"
    }
  ]
}
{% endschema %}
