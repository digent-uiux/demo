{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-ui-commerce.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-ui-commerce.js' | asset_url }}" defer="defer"></script>
{{ 'blko-cart-page-13.css' | asset_url | stylesheet_tag }}
{%- render 'blko-fonts-linen', mode: 'faces', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font -%}
{%- capture blko_style -%}{% render 'blko-fonts-linen', mode: 'vars', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font %}--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px{%- endcapture -%}
{%- capture blko_class -%}bcartpage13{% if s.tokens == 'theme' %} bcartpage13--theme{% endif %}{% if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}{%- endcapture -%}
<script src="{{ 'blko-cart-page-13.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign label = 'blko.cart_page_13.label' | t
  assign live = false
  if cart.items.size > 0
    assign live = true
  endif
  if request.page_type == 'cart' and request.host != blank and request.design_mode == false
    assign live = true
  endif
  assign demo = false
  unless live
    if request.design_mode or request.page_type != 'cart'
      assign demo = true
    endif
  endunless
  assign size_opt = s.size_option | default: 'Size' | downcase
  assign demo_sizes = s.sizes | split: ','
  assign count = 0
  assign subtotal = 0
  if live
    assign count = cart.item_count
    assign subtotal = cart.total_price
  elsif demo
    for b in section.blocks
      if b.type == 'line'
        assign count = count | plus: b.settings.qty
        assign line_total = b.settings.price | times: b.settings.qty
        assign subtotal = subtotal | plus: line_total
      endif
    endfor
  endif
  assign has_lines = false
  if count > 0
    assign has_lines = true
  endif
  assign wrap_on = ''
  assign wrap_price = 0
  assign wrap_none = false
  for b in section.blocks
    if b.type == 'wrap'
      if live
        if cart.attributes.Wrap == b.settings.name
          assign wrap_on = b.id
        endif
      elsif b.settings.start
        assign wrap_on = b.id
      endif
    endif
  endfor
  for b in section.blocks
    if b.type == 'wrap' and b.id == wrap_on
      assign wrap_price = b.settings.price
      assign wrap_none = b.settings.none
      assign wrap_note = b.settings.note
    endif
  endfor
  if live
    assign note = cart.attributes['Gift note']
    assign free_cents = s.free_over | times: 100
    assign gap = free_cents | minus: subtotal
    assign total = subtotal
  else
    assign note = s.note_default
    assign gap = s.free_over | minus: subtotal
    assign ship = s.ship_cost
    if subtotal >= s.free_over or subtotal == 0
      assign ship = 0
    endif
    assign total = subtotal | plus: ship
    if has_lines
      assign total = total | plus: wrap_price
    endif
  endif
  assign cents = live
-%}
{%- capture blko_body -%}
  <blko-cart-page-13 class="bcartpage13__wrap" data-section-id="{{ section.id }}" data-cart-error="{{ 'blko.linen.cart_error' | t | escape }}"{% if live %} data-live{% endif %} data-free="{{ s.free_over }}" data-ship="{{ s.ship_cost }}" data-fmt="{% render 'blko-ui-money', amount: 7 %}">
    <header class="bcartpage13__head">
      <div class="bcartpage13__hl">
        <p class="bx-label bx-muted" data-count-line>{{ s.count_label | escape }} · <span data-count>{{ count }}</span> <span data-one{% if count != 1 %} hidden{% endif %}>{{ s.piece_one | escape }}</span><span data-many{% if count == 1 %} hidden{% endif %}>{{ s.piece_many | escape }}</span></p>
        <h1 class="bcartpage13__title">{{ s.heading | escape }}</h1>
      </div>
      {%- if s.text != blank -%}<p class="bx-small bx-muted bcartpage13__lead">{{ s.text | escape }}</p>{%- endif -%}
    </header>

    {% if live %}<p data-linen-cart-status role="status" class="blko-linen-error" hidden></p><a data-linen-cart-page-fallback href="{{ routes.cart_url }}" hidden>{{ 'blko.linen.view_bag' | t }}</a>{% endif %}
    <form action="{{ routes.cart_url }}" method="post" class="bcartpage13__grid"{% unless live %} novalidate{% endunless %}>
      <ul class="bcartpage13__lines" data-lines>
        {%- if live -%}
          {%- for item in cart.items -%}
            {%- liquid
              assign p = item.product
              assign si = -1
              for o in p.options_with_values
                assign oname = o.name | downcase
                if oname == size_opt
                  assign si = forloop.index0
                  assign sizes = o.values
                endif
              endfor
              assign size = ''
              assign colour = ''
              assign outs = ''
              assign vids = ''
              if si >= 0
                assign size = item.variant.options[si]
                for z in sizes
                  assign vid = ''
                  for v in p.variants
                    assign match = true
                    for ov in v.options
                      if forloop.index0 == si
                        if ov != z
                          assign match = false
                        endif
                      elsif ov != item.variant.options[forloop.index0]
                        assign match = false
                      endif
                    endfor
                    if match
                      assign vid = v.id
                      unless v.available
                        assign outs = outs | append: z | append: '|'
                      endunless
                    endif
                  endfor
                  if vid == ''
                    assign outs = outs | append: z | append: '|'
                  endif
                  assign vids = vids | append: vid | append: '|'
                endfor
                for ov in item.variant.options
                  if forloop.index0 != si
                    assign colour = colour | append: ov | append: ' / '
                  endif
                endfor
                assign colour = colour | remove_last: ' / '
              else
                unless item.product.has_only_default_variant
                  assign colour = item.variant.title
                endunless
                assign sizes = ''
              endif
              assign out_list = outs | split: '|'
              assign vid_list = vids | split: '|'
              if si < 0
                assign sizes = '' | split: ','
              endif
              assign fits = p.metafields.custom.fit.value | default: ''
              assign img = item.image | default: p.featured_image
            -%}
            {%- render 'blko-cart-page-13-line', live: true, key: item.key, name: p.title, colour: colour, price: item.final_price, line_total: item.final_line_price, original_total: item.original_line_price, cents: true, qty: item.quantity, minimum: item.variant.quantity_rule.min, max: item.variant.quantity_rule.max, step: item.variant.quantity_rule.increment, size: size, sizes: sizes, outs: out_list, variants: vid_list, fits: fits, image: img, url: item.url, s: s -%}
          {%- endfor -%}
        {%- elsif demo -%}
          {%- for b in section.blocks -%}
            {%- if b.type == 'line' -%}
              {%- assign bs = b.settings -%}
              {%- assign outs = bs.out | split: ',' -%}
              {%- assign out_list = '' | split: ',' -%}
              {%- for o in outs -%}{%- assign oo = o | strip | split: '~' -%}{%- assign out_list = out_list | concat: oo -%}{%- endfor -%}
              {%- assign sizes = '' | split: ',' -%}
              {%- for z in demo_sizes -%}{%- assign zz = z | strip | split: '~' -%}{%- assign sizes = sizes | concat: zz -%}{%- endfor -%}
              {%- render 'blko-cart-page-13-line', live: false, key: b.id, name: bs.name, colour: bs.colour, price: bs.price, cents: false, qty: bs.qty, max: 5, size: bs.size, sizes: sizes, outs: out_list, fits: bs.fit, image: bs.image, s: s -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        <li class="bcartpage13__empty" data-empty{% if has_lines %} hidden{% endif %}>
          <p class="bcartpage13__et">{{ s.empty_heading | escape }}</p>
          <a href="{{ s.empty_url | default: routes.all_products_collection_url }}" class="bx-small bcartpage13__el">{{ s.empty_link | escape }}</a>
        </li>
      </ul>

      <aside aria-label="{{ 'blko.cart_page_13.aside' | t }}" class="bcartpage13__side">
        {%- assign tone = 'bg' -%}
        {%- for b in section.blocks -%}{%- if b.id == wrap_on -%}{%- assign tone = b.settings.tone -%}{%- endif -%}{%- endfor -%}
        <fieldset class="bcartpage13__cloth"{% if wrap_none or wrap_on == '' %} data-none{% endif %} style="--tone:var(--c-{{ tone }})">
          <legend class="bx-sr">{{ s.wrap_heading | escape }}</legend>
          <div class="bcartpage13__ch">
            <div class="bcartpage13__ct">
              <p aria-hidden="true" class="bcartpage13__wh">{{ s.wrap_heading | escape }}</p>
              {%- if s.wrap_text != blank -%}<p class="bx-small bx-muted">{{ s.wrap_text | escape }}</p>{%- endif -%}
            </div>
            <div aria-hidden="true" class="bcartpage13__parcel">
              <span class="bcartpage13__cloth-sq"></span>
              <span class="bcartpage13__tie bcartpage13__tie--v"></span>
              <span class="bcartpage13__tie bcartpage13__tie--h"></span>
              <span class="bcartpage13__knot"></span>
            </div>
          </div>
          <div class="bcartpage13__sws">
            {%- for b in section.blocks -%}
              {%- if b.type == 'wrap' -%}
                {%- assign bs = b.settings -%}
                <label class="bcartpage13__sw" style="--sw:var(--c-{{ bs.tone }})" {{ b.shopify_attributes }}>
                  <input type="radio" name="attributes[Wrap]" value="{{ bs.name | escape }}" class="bx-sr" data-wrap data-price="{% if live %}0{% else %}{{ bs.price }}{% endif %}" data-tone="{{ bs.tone }}" data-note="{{ bs.note | escape }}"{% if bs.none %} data-none{% endif %}{% if b.id == wrap_on %} checked{% endif %}>
                  <span aria-hidden="true" class="bcartpage13__swatch"></span>
                  <span class="bcartpage13__swt">
                    <span class="bx-small bcartpage13__swn">{{ bs.name | escape }}</span>
                    <span class="bx-label bx-muted bcartpage13__swp">{% if bs.price > 0 and live == false %}+{% render 'blko-ui-money', amount: bs.price %}{% else %}{{ s.free_word | escape }}{% endif %}</span>
                  </span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p aria-live="polite" class="bx-small bx-muted" data-wrap-note>{% if wrap_note != blank %}{{ wrap_note | escape }}.{% endif %}</p>
          {%- capture field -%}
            {%- assign nid = 'cp13-note-' | append: section.id -%}
            {%- assign hid = nid | append: '-hint' -%}
            {%- render 'blko-ui-textarea', id: nid, name: 'attributes[Gift note]', rows: 2, value: note, describedBy: hid, className: 'bcartpage13__note' -%}
          {%- endcapture -%}
          {%- capture hint -%}<span data-len>{{ note.size }}</span>/80{%- endcapture -%}
          {%- assign nlabel = s.note_label | escape -%}
          <div class="bcartpage13__nf" data-note-field{% if wrap_none or wrap_on == '' %} hidden{% endif %}>
            {%- render 'blko-ui-field', id: nid, label: nlabel, hint: hint, optional: true, children: field -%}
          </div>
        </fieldset>

        {% if live %}<label class="blko-linen-cart__note">{{ 'blko.cart.note' | t }}{% render 'blko-ui-textarea', name: 'note', value: cart.note, rows: 2 %}</label>{% assign update = 'blko.cart.update' | t %}{% render 'blko-ui-button', type: 'submit', variant: 'outline', children: update, attrs: 'name="update"' %}{% endif %}
        <div class="bcartpage13__sum">
          {% if live %}{% for discount in cart.cart_level_discount_applications %}<p class="bx-small">{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</p>{% endfor %}{% endif %}
          <dl class="bx-small bcartpage13__dl">
            <div><dt class="bx-muted">{{ s.subtotal_label | escape }}</dt><dd data-subtotal>{% render 'blko-ui-money', amount: subtotal, cents: cents %}</dd></div>
            <div><dt class="bx-muted">{{ s.wrap_label | escape }}</dt><dd data-wrap-cost data-free="{{ s.free_word | escape }}" data-none="{{ s.none_word | escape }}">{% if live %}{% if wrap_none or wrap_on == '' %}{{ s.none_word | escape }}{% else %}{{ s.free_word | escape }}{% endif %}{% elsif has_lines and wrap_price > 0 %}{% render 'blko-ui-money', amount: wrap_price %}{% else %}{{ s.none_word | escape }}{% endif %}</dd></div>
            <div><dt class="bx-muted">{{ s.shipping_label | escape }}</dt><dd data-ship-cost>{% if live %}{% if gap <= 0 %}{{ s.free_word | escape }}{% else %}{{ s.ship_later | escape }}{% endif %}{% elsif ship > 0 %}{% render 'blko-ui-money', amount: ship %}{% else %}{{ s.free_word | escape }}{% endif %}</dd></div>
          </dl>
          <p class="bx-small bx-muted" data-ship-line data-done="{{ s.ship_done | escape }}" data-more="{{ s.ship_more | escape }}">
            {%- if gap <= 0 -%}{{ s.ship_done | escape }}{%- else -%}{%- capture amt -%}{% render 'blko-ui-money', amount: gap, cents: cents %}{%- endcapture -%}{{ s.ship_more | escape | replace: '[amount]', amt }}{%- endif -%}
          </p>
          {%- capture btn -%}{{ s.checkout_label | escape }} · <span data-total>{% render 'blko-ui-money', amount: total, cents: cents %}</span>{%- endcapture -%}
          {%- capture battrs -%}name="checkout" data-checkout{% unless has_lines %} disabled{% endunless %}{%- endcapture -%}
          {%- render 'blko-ui-button', type: 'submit', size: 'lg', full: true, icon: 'lock', iconAfter: 'arrow-right', children: btn, attrs: battrs -%}
          {%- if s.exchange_text != blank -%}
            <p class="bx-label bx-muted bcartpage13__ex">{%- render 'blko-ui-icon', name: 'rotate-ccw', size: 14, className: 'bcartpage13__exi' -%}{{ s.exchange_text | escape }}</p>
          {%- endif -%}
          {%- if s.show_payment -%}{%- render 'blko-ui-payment-marks' -%}{%- endif -%}
        </div>
      </aside>
    </form>
  </blko-cart-page-13>
{%- endcapture -%}
{%- render 'blko-ui-section', surface: 'bg', bleed: true, label: label, className: blko_class, style: blko_style, inner: 'bx-pad bcartpage13__in', children: blko_body -%}

