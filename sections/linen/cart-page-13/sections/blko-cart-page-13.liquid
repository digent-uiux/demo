        }
      ]
    },
    {
      "type": "wrap",
      "name": "Cloth wrap",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Undyed"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Natural flax, fringed edge"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Cloth colour",
          "default": "bg-alt",
          "options": [
            {
              "value": "bg",
              "label": "Background"
            },
            {
              "value": "bg-alt",
              "label": "Alternate"
            },
            {
              "value": "pop-1",
              "label": "Pop 1"
