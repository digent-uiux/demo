{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-4'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-collection-banner-58.css' | asset_url | stylesheet_tag }}
{%- render 'blko-fonts-linen', mode: 'faces', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font -%}
{%- capture blko_style -%}{% render 'blko-fonts-linen', mode: 'vars', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font %}--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px{%- endcapture -%}
{%- capture blko_class -%}bcollectionbanner58{% if s.tokens == 'theme' %} bcollectionbanner58--theme{% endif %}{% if blko_sid != 'scheme-4' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}{%- endcapture -%}
<script src="{{ 'blko-collection-banner-58.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign title = s.heading
  assign total = 0
  assign use_blog = false
  if blog.title != blank and s.use_blog
    assign title = blog.title
    assign total = blog.articles_count
    if blog.all_tags.size > 0
      assign use_blog = true
    endif
  endif
  unless use_blog
    if blog.title == blank or s.use_blog == false
      for b in section.blocks
        assign total = total | plus: b.settings.count
      endfor
    endif
  endunless
  assign label = title | strip_html
  assign topics_label = 'blko.collection_banner_58.topics' | t
  assign all_url = blog.url | default: routes.root_url
  assign est = s.est | escape
  assign notes_word = 'blko.collection_banner_58.notes' | t: count: total
-%}
<blko-collection-banner-58 data-notes-one="{{ 'blko.collection_banner_58.notes.one' | t }}" data-notes-other="{{ 'blko.collection_banner_58.notes.other' | t }}" data-lot="{{ s.lot_word | escape }}">
{%- capture blko_body -%}
    <div class="bcollectionbanner58__oval">
      <div class="bcollectionbanner58__label">
        {%- if s.kicker != blank -%}
          <p class="bx-label bcollectionbanner58__kicker"><span aria-hidden="true" class="bcollectionbanner58__rule"></span>{{ s.kicker | escape }}<span aria-hidden="true" class="bcollectionbanner58__rule"></span></p>
        {%- endif -%}
        <h1 class="bcollectionbanner58__title">{{ title | escape }}</h1>
        {%- if s.text != blank -%}<p class="bx-small bx-muted bcollectionbanner58__text">{{ s.text | escape }}</p>{%- endif -%}
        <p aria-live="polite" class="bx-label bcollectionbanner58__lot" data-lotline data-default="{{ est }} · {{ notes_word | escape }}">{{ est }} · {{ notes_word }}</p>
      </div>
    </div>
    <nav aria-label="{{ topics_label }}" class="bcollectionbanner58__nav">
      <ul class="bcollectionbanner58__tags">
        <li><a href="{{ all_url }}" class="bcollectionbanner58__tag"{% if current_tags == blank %} aria-current="page"{% endif %} data-all><span class="bcollectionbanner58__tname">{{ s.all_label | escape }}</span><span class="bx-label bcollectionbanner58__tcount">{% if total < 10 %}0{% endif %}{{ total }}</span></a></li>
        {%- if use_blog -%}
          {%- for t in blog.all_tags limit: 8 -%}
            {%- liquid
              assign n = 0
              for a in blog.articles
                if a.tags contains t
                  assign n = n | plus: 1
                endif
              endfor
            -%}
            <li><a href="{{ blog.url }}/tagged/{{ t | handle }}" class="bcollectionbanner58__tag"{% if current_tags contains t %} aria-current="page"{% endif %} data-slug="{{ t | handle }}" data-count="{{ n }}"><span class="bcollectionbanner58__tname">{{ t | escape }}</span><span class="bx-label bcollectionbanner58__tcount">{% if n < 10 %}0{% endif %}{{ n }}</span></a></li>
          {%- endfor -%}
        {%- else -%}
          {%- for b in section.blocks -%}
            {%- assign slug = b.settings.name | handle -%}
            {%- assign href = b.settings.link | default: all_url -%}
            <li {{ b.shopify_attributes }}><a href="{{ href }}" class="bcollectionbanner58__tag" data-slug="{{ slug }}" data-count="{{ b.settings.count }}"><span class="bcollectionbanner58__tname">{{ b.settings.name | escape }}</span><span class="bx-label bcollectionbanner58__tcount">{% if b.settings.count < 10 %}0{% endif %}{{ b.settings.count }}</span></a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>
{%- endcapture -%}
{%- render 'blko-ui-section', surface: 'pop-3', bleed: true, label: label, className: blko_class, style: blko_style, inner: 'bx-pad bcollectionbanner58__in', children: blko_body -%}
</blko-collection-banner-58>

{% schema %}
{
  "name": "Blog opener, oval label",
  "tag": "div",
  "class": "blko-collection-banner-58-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "use_blog",
      "label": "Use the blog title and tags",
      "default": true,
      "info": "On a blog page the title, note count and topic tags come from the blog."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Small line",
      "default": "No. 14 · The fabric notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Linen, worn slowly and kept for years"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "How flax is grown, woven and washed, and how to wear it from the beach to a city dinner."
    },
    {
      "type": "text",
      "id": "est",
      "label": "Est. line",
      "default": "Est. 2014"
    },
    {
      "type": "text",
      "id": "lot_word",
      "label": "Topic line word",
      "default": "Lot"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All topics label",
      "default": "All notes"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Fonts",
      "options": [
        {
          "value": "bundled",
          "label": "Bundled (EB Garamond + Albert Sans)"
        },
        {
          "value": "picker",
          "label": "Pick from the font library"
        },
        {
          "value": "theme",
          "label": "Use the theme's fonts"
        }
      ],
      "default": "bundled"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Colors and shapes"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, corners, type style",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Linen)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-radius-card, --blko-theme-button-case…). Other themes: keep the preset."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blko.linen.color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Style guide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "count",
          "label": "Note count",
          "min": 0,
          "max": 99,
          "step": 1,
          "default": 11
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Blog opener, oval label",
      "blocks": [
        {
          "type": "topic",
          "settings": {
            "name": "Style guide",
            "count": 11
          }
        },
        {
          "type": "topic",
          "settings": {
            "name": "Fabric notes",
            "count": 9
          }
        },
        {
          "type": "topic",
          "settings": {
            "name": "Wash and care",
            "count": 7
          }
        },
        {
          "type": "topic",
          "settings": {
            "name": "Packing light",
            "count": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
