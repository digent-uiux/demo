{%- comment -%}
  Lather look + store runtime for the blko-lv3 sections. Renders no markup: the Lather fonts, the brand logo mask,
  the shared CSS (blko-lv3-base.css), html.motion (skipped for reduced motion) and the runtime (blko-lv3-store.js:
  window.LATHER, cart drawer, quick view, popup, cookie bar, header, announcement, [data-rv] reveals).
  Keep it first in the header group.
{%- endcomment -%}
<script>try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion'); } catch (e) {}</script>
{%- style -%}
  @font-face { font-family: 'Urbanist'; font-style: normal; font-weight: 300 700; font-display: swap; src: url({{ 'blko-lv3-urbanist.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Yeseva One'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'blko-lv3-yeseva-one.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Antonio'; font-style: normal; font-weight: 600; font-display: swap; src: url({{ 'blko-lv3-antonio-600.woff2' | asset_url }}) format('woff2'); }
  :root { --lv3-logo: url({{ 'blko-lv3-logo.png' | asset_url }}); --lv3-mark: url({{ 'blko-lv3-mark.png' | asset_url }}); }
{%- endstyle -%}
{{ 'blko-lv3-urbanist.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'blko-lv3-base.css' | asset_url | stylesheet_tag }}
<script>
  window.LATHER_CFG = {
    root: {{ routes.root_url | json }},
    cartUrl: {{ routes.cart_url | default: '/cart' | json }},
    cartAdd: {{ routes.cart_add_url | default: '/cart/add' | json }},
    cartChange: {{ routes.cart_change_url | default: '/cart/change' | json }},
    money: {{ shop.money_format | strip_html | json }},
    cartCount: {{ cart.item_count | json }}
  };
</script>
<script src="{{ 'blko-lv3-store.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-lv3-recent.js' | asset_url }}" defer="defer"></script>
{{ 'blko-lv3-wishlist.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-lv3-wishlist.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Lather look",
  "tag": "div",
  "class": "lv3-theme-sec",
  "settings": [
    { "type": "paragraph", "content": "Loads the Lather fonts, colours and the store runtime (bag, quick view, popup, cookie bar). Keep this section first in the header group." }
  ],
  "presets": [{ "name": "Lather look" }]
}
{% endschema %}
