{%- comment -%}
  Lather v3, FAQ (home-v3/parts/85-faq.html). Tall sticky photo with a care tip; accordion beside it, one open at a time.
  Questions are blocks with rich-text answers.
{%- endcomment -%}
{{ 'blko-lv3-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-lv3-faq.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign uid = 'faq-' | append: section.id
-%}
{%- assign lv3_sid = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1' -%}
<section class="s-faq{%- if lv3_sid != 'scheme-1' %} color-{{ lv3_sid }} lv3-scheme-pick{% endif %}" id="{{ s.anchor | default: 'faq' | handleize }}" aria-label="{{ s.label | escape }}" data-lv3-faq>
  <div class="wrap s-faq__grid">
    <div class="s-faq__head">
      <h2 class="h2" data-rv="line">
        {%- if s.heading_1 != blank -%}<span class="ln"><span>{{ s.heading_1 }}</span></span>{%- endif -%}
        {%- if s.heading_2 != blank -%}<span class="ln"><span>{{ s.heading_2 }}</span></span>{%- endif -%}
      </h2>
    </div>
    <figure class="s-faq__media" data-rv="settle">
      {%- if s.image != blank -%}
        {%- assign pos = 'object-position: ' | append: s.image.presentation.focal_point -%}
        {{ s.image | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(max-width: 900px) 100vw, 42vw', loading: 'lazy', alt: s.image.alt, style: pos }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'blko-lv3-ph' }}
      {%- endif -%}
      {%- if s.tip != blank -%}<figcaption class="s-faq__tip">{{ s.tip | escape }}</figcaption>{%- endif -%}
    </figure>
    <div class="s-faq__body">
      <div class="s-faq__list" data-rv="blur" data-rv-delay="1">
        {%- for block in section.blocks -%}
          {%- liquid
            assign open = false
            if forloop.first and s.open_first
              assign open = true
            endif
            assign i = forloop.index0
          -%}
          <div class="s-faq__item{% if open %} is-open{% endif %}" {{ block.shopify_attributes }}>
            <h3><button class="s-faq__q" type="button" aria-expanded="{{ open }}" aria-controls="{{ uid }}-a{{ i }}" id="{{ uid }}-q{{ i }}">{{ block.settings.question | escape }}<span class="s-faq__ico" aria-hidden="true"></span></button></h3>
            <div class="s-faq__a" id="{{ uid }}-a{{ i }}" role="region" aria-labelledby="{{ uid }}-q{{ i }}"><div>{{ block.settings.answer }}</div></div>
          </div>
        {%- endfor -%}
      </div>
      <div class="s-faq__more" data-rv="blur" data-rv-delay="2">
        {%- if s.button_label != blank -%}<a class="btn btn--primary" href="{{ s.button_link | default: '#quiz' }}">{{ s.button_label | escape }}</a>{%- endif -%}
        {%- if s.more_text != blank or s.email_label != blank -%}
          <p>{{ s.more_text | escape }} {% if s.email_label != blank %}<a class="link" href="mailto:{{ s.email | default: shop.email }}">{{ s.email_label | escape }}</a>{% endif %}{{ s.more_after | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lather FAQ",
  "class": "blko-lv3-section-faq",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "inline_richtext", "id": "heading_1", "label": "Heading, line 1", "default": "Questions, <em>answered.</em>", "info": "Italic text shows in the accent style." },
    { "type": "inline_richtext", "id": "heading_2", "label": "Heading, line 2 (optional)" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Tall; stays in view beside the questions on wide screens." },
    { "type": "text", "id": "tip", "label": "Tip on the photo", "default": "Pat dry, then moisturise within three minutes, while skin is still damp." },
    { "type": "header", "content": "Below the questions" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find your match" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty: jumps to the skin quiz on this page." },
    { "type": "text", "id": "more_text", "label": "Text before the email link", "default": "Still unsure?" },
    { "type": "text", "id": "email_label", "label": "Email link label", "default": "Email us" },
    { "type": "text", "id": "email", "label": "Email address", "default": "help@example.com", "info": "Empty: the store's email." },
    { "type": "text", "id": "more_after", "label": "Text after the email link", "default": ", a person replies within a day." },
    { "type": "header", "content": "Section" },
    { "type": "text", "id": "label", "label": "Section label (screen readers)", "default": "Questions" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "faq" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is it really fragrance-free?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Everything except Chamomile wash has no fragrance and no masking scent. Chamomile wash has a light scent, and it says so on the front.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lather FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Is it really fragrance-free?", "answer": "<p>Everything except Chamomile wash has no fragrance and no masking scent. Chamomile wash has a light scent, and it says so on the front.</p>" } },
        { "type": "question", "settings": { "question": "Can I use it on eczema-prone skin?", "answer": "<p>Many people with eczema-prone skin use Calm wash every day. It's gentle, not a treatment: patch test on your inner arm for 48 hours first.</p>" } },
        { "type": "question", "settings": { "question": "Is Little lotion OK under age 1?", "answer": "<p>We made it for ages 1 and up. For a younger baby, ask your doctor first.</p>" } },
        { "type": "question", "settings": { "question": "How long does a bottle last?", "answer": "<p>About 8 weeks of daily showers for one person (400 ml).</p>" } },
        { "type": "question", "settings": { "question": "Where should I start?", "answer": "<p>Not sure where to start? Try the Oat bar, $9. It works on face and body and has no fragrance. If your skin likes it, move on to Calm wash.</p>" } },
        { "type": "question", "settings": { "question": "What if my skin reacts?", "answer": "<p>Stop using it and email us a photo of the label. We refund your first bottle of any formula within 30 days, used or not.</p>" } }
      ]
    }
  ]
}
{% endschema %}
