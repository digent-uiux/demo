{%- comment -%}
  Lather v3, product page: reviews (home-v3/pages/product/50-reviews.html).
  Heading; average rating and count from the product's standard review metafields (reviews.rating, reviews.rating_count),
  with section settings as the fallback; skin-type chips with counts; review blocks (the first shown leads, on deep green
  with its photo); "Show more". An app block (a reviews app) replaces the built-in list and filter.
  "Write a review" (top right, under the score on phones): with a reviews app it clicks the app's own write button;
  without one it opens a drawer whose form is Shopify's contact form tagged "review", so the merchant gets every review
  by email to check and add as a review block. Photos can't travel through the contact form: the photo's file name is
  sent and the hint tells the shopper the store will ask for it by email.
  The review blocks are the merchant's own content: nothing here marks them verified.
{%- endcomment -%}
{{ 'blko-lv3-product-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-lv3-product-reviews.js' | asset_url }}" defer></script>
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | handleize | default: 'pdp-reviews'
  assign page_size = s.page_size | default: 5

  assign rp = product
  assign rating = s.rating_fallback | plus: 0
  assign scale = 5
  assign count = s.count_fallback
  if rp.metafields.reviews.rating.value != blank
    assign rating = rp.metafields.reviews.rating.value.rating | plus: 0
    assign scale = rp.metafields.reviews.rating.value.scale_max | plus: 0
    if scale > 0 and scale != 5
      assign rating = rating | times: 5.0 | divided_by: scale
    endif
  endif
  if rp.metafields.reviews.rating_count.value != blank
    assign count = rp.metafields.reviews.rating_count.value
  endif
  assign rating_txt = rating | times: 10 | round | divided_by: 10.0
  assign pct = rating | times: 20 | round
  assign title = rp.title | default: s.product_fallback | escape
  assign count_b = '<b>' | append: count | append: '</b>'

  assign wf = nil
  for block in section.blocks
    if block.type == 'write_form'
      assign wf = block.settings
    endif
  endfor
  assign w_write_heading = wf.write_heading | default: 'Write a review'
  assign w_close_label = wf.close_label | default: 'Close'
  assign w_label_rating = wf.label_rating | default: 'Your rating'
  assign w_rate_text = wf.rate_text | default: '[n] out of 5'
  assign w_label_optional = wf.label_optional | default: '(optional)'
  assign w_show_skin = true
  if wf != nil and wf.show_skin == false
    assign w_show_skin = false
  endif
  assign w_label_skin = wf.label_skin | default: 'Skin type'
  assign w_label_title = wf.label_title | default: 'Title'
  assign w_ph_title = wf.ph_title | default: 'Sum it up in a few words'
  assign w_label_text = wf.label_text | default: 'Your review'
  assign w_ph_text = wf.ph_text | default: 'How does your skin feel after a wash? How long have you used it?'
  assign w_label_name = wf.label_name | default: 'Name'
  assign w_ph_name = wf.ph_name | default: 'Shown as Maya R.'
  assign w_label_email = wf.label_email | default: 'Email'
  assign w_ph_email = wf.ph_email | default: 'Never shown'
  assign w_show_photo = true
  if wf != nil and wf.show_photo == false
    assign w_show_photo = false
  endif
  assign w_label_photo = wf.label_photo | default: 'Photo'
  assign w_photo_add = wf.photo_add | default: 'Add a photo'
  assign w_photo_remove = wf.photo_remove | default: 'Remove'
  assign w_photo_hint = wf.photo_hint | default: "We check photos by hand, so we'll email you to ask for it."
  assign w_submit_label = wf.submit_label | default: 'Send review'
  assign w_privacy_note = wf.privacy_note | default: 'We read every review before it appears. Your email stays with us.'
  assign w_err_rating = wf.err_rating | default: 'Choose from 1 to 5 stars.'
  assign w_err_text = wf.err_text | default: 'Tell us a little more, at least 10 characters.'
  assign w_err_name = wf.err_name | default: 'Add the name to show with your review.'
  assign w_err_email = wf.err_email | default: 'Enter an email like name@example.com.'
  assign w_thanks_title = wf.thanks_title | default: 'Thanks, your review will appear after a quick check'
  assign w_thanks_text = wf.thanks_text | default: "We read each one by hand, usually within two days. If we have a question, we'll email you."
  assign w_thanks_back = wf.thanks_back | default: 'Back to the product'
  assign w_thanks_again = wf.thanks_again | default: 'Write another'
  assign apps = 0
  assign total = 0
  assign n_eczema = 0
  assign n_dry = 0
  assign n_sensitive = 0
  assign n_little = 0
  for block in section.blocks
    case block.type
      when '@app'
        assign apps = apps | plus: 1
      when 'review'
        assign total = total | plus: 1
        case block.settings.skin
          when 'eczema'
            assign n_eczema = n_eczema | plus: 1
          when 'dry'
            assign n_dry = n_dry | plus: 1
          when 'sensitive'
            assign n_sensitive = n_sensitive | plus: 1
          when 'little'
            assign n_little = n_little | plus: 1
        endcase
    endcase
  endfor
  assign shown_n = total
  if total > page_size
    assign shown_n = page_size
  endif
-%}
{%- if apps == 0 -%}<noscript><style>#{{ anchor }} .s-pdp-reviews__item.is-off{display:grid}#{{ anchor }} .s-pdp-reviews__more,#{{ anchor }} .s-pdp-reviews__bar{display:none}</style></noscript>{%- endif -%}
{%- assign lv3_sid = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-2' -%}
<section class="s-pdp-reviews{%- if lv3_sid != 'scheme-2' %} color-{{ lv3_sid }} lv3-scheme-pick{% endif %}" id="{{ anchor }}" aria-labelledby="{{ anchor }}-title"{% if apps == 0 %} data-lv3-pdp-reviews data-page="{{ page_size }}"{% endif %}><div class="wrap">
  <div class="s-pdp-reviews__head">
    <h2 class="h2" id="{{ anchor }}-title" data-rv="line">
      {%- if s.heading_1 != blank -%}<span class="ln"><span>{{ s.heading_1 }}</span></span>{%- endif -%}
      {%- if s.heading_2 != blank -%}<span class="ln"><span>{{ s.heading_2 }}</span></span>{%- endif -%}
    </h2>
    {%- if s.show_summary and rating > 0 -%}
      {%- assign aria = s.stars_aria | replace: '[n]', rating_txt -%}
      <div class="s-pdp-reviews__score" data-rv="blur" data-rv-delay="1"><span class="s-pdp-reviews__avg">{{ rating_txt }}</span><span class="s-pdp-reviews__score-text"><span class="s-pdp-reviews__meter" role="img" aria-label="{{ aria | escape }}">★★★★★<i style="width:{{ pct }}%">★★★★★</i></span>
        {%- if count != blank and count > 0 -%}<span class="s-pdp-reviews__count">{{ s.count_text | escape | replace: '[count]', count_b | replace: '[product]', title }}</span>{%- endif -%}
      </span></div>
    {%- endif -%}
    {%- if s.show_write and s.write_label != blank -%}
      {%- if apps > 0 -%}
        <button type="button" class="btn btn--ghost s-pdp-reviews__wbtn" data-rev-write="app"{% if s.app_selector != blank %} data-app-selector="{{ s.app_selector | escape }}"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z"/><path d="M13.5 6.5l4 4"/></svg>{{ s.write_label | escape }}</button>
      {%- else -%}
        <button type="button" class="btn btn--ghost s-pdp-reviews__wbtn" data-rev-write="form" aria-haspopup="dialog" aria-controls="{{ anchor }}-write"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z"/><path d="M13.5 6.5l4 4"/></svg>{{ s.write_label | escape }}</button>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if apps > 0 -%}
    <div class="s-pdp-reviews__apps">
      {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
    </div>
  {%- else -%}
    {%- if s.show_filter and total > 1 -%}
      <div class="s-pdp-reviews__bar" role="group" aria-label="{{ s.filter_label | escape }}" data-rv="blur" data-rv-delay="2">
        {%- if s.filter_label != blank -%}<span class="s-pdp-reviews__bar-label">{{ s.filter_label | escape }}</span>{%- endif -%}
        <div class="s-pdp-reviews__filters">
          <button type="button" class="chip" data-rev-filter="all" aria-pressed="true">{{ s.label_all | escape }}<span class="n" data-n>{{ total }}</span></button>
          {%- if n_eczema > 0 -%}<button type="button" class="chip" data-rev-filter="eczema" aria-pressed="false">{{ s.label_eczema | escape }}<span class="n" data-n>{{ n_eczema }}</span></button>{%- endif -%}
          {%- if n_dry > 0 -%}<button type="button" class="chip" data-rev-filter="dry" aria-pressed="false">{{ s.label_dry | escape }}<span class="n" data-n>{{ n_dry }}</span></button>{%- endif -%}
          {%- if n_sensitive > 0 -%}<button type="button" class="chip" data-rev-filter="sensitive" aria-pressed="false">{{ s.label_sensitive | escape }}<span class="n" data-n>{{ n_sensitive }}</span></button>{%- endif -%}
          {%- if n_little > 0 -%}<button type="button" class="chip" data-rev-filter="little" aria-pressed="false">{{ s.label_little | escape }}<span class="n" data-n>{{ n_little }}</span></button>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="s-pdp-reviews__list" data-rev-list aria-live="polite">
      {%- assign i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'review' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign b = block.settings
          assign r = b.rating | default: 5
          assign cls = 's-pdp-reviews__item'
          if b.image != blank
            assign cls = cls | append: ' has-photo'
          endif
          if i == 0
            assign cls = cls | append: ' is-lead'
            if shown_n == 1
              assign cls = cls | append: ' is-solo'
            elsif shown_n == 2
              assign cls = cls | append: ' is-pair'
            endif
          elsif i >= 3 and i < page_size
            assign k = i | minus: 3 | modulo: 4
            case k
              when 0
                assign cls = cls | append: ' is-wide'
              when 2
                assign cls = cls | append: ' is-nl'
              when 3
                assign cls = cls | append: ' is-wide is-r'
            endcase
          endif
          if i >= page_size
            assign cls = cls | append: ' is-off'
          endif
          case b.skin
            when 'eczema'
              assign skin_label = s.label_eczema
            when 'dry'
              assign skin_label = s.label_dry
            when 'sensitive'
              assign skin_label = s.label_sensitive
            else
              assign skin_label = s.label_little
          endcase
          assign aria = s.stars_aria | replace: '[n]', r
          assign delay = i
          if delay > 3
            assign delay = 3
          endif
        -%}
        <article class="{{ cls }}" data-skin="{{ b.skin }}" tabindex="-1" {% if i == 0 %}data-rv="settle"{% else %}data-rv="blur" data-rv-delay="{{ delay }}"{% endif %} {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <figure class="s-pdp-reviews__media">
              {%- if i == 0 -%}
                {{ b.image | image_url: width: 1100 | image_tag: widths: '450, 700, 900, 1100', sizes: '(max-width: 760px) 100vw, 26vw', loading: 'lazy', alt: b.image.alt }}
              {%- else -%}
                {{ b.image | image_url: width: 480 | image_tag: widths: '240, 480', sizes: '120px', loading: 'lazy', alt: b.image.alt }}
              {%- endif -%}
            </figure>
          {%- endif -%}
          <div class="s-pdp-reviews__body">
            <div class="s-pdp-reviews__top"><span class="stars" role="img" aria-label="{{ aria | escape }}">{% for n in (1..r) %}★{% endfor %}{% if r < 5 %}<s>{% for n in (r..4) %}★{% endfor %}</s>{% endif %}</span>{%- if skin_label != blank -%}<span class="s-pdp-reviews__skin">{{ skin_label | escape }}</span>{%- endif -%}</div>
            {%- if b.title != blank -%}<h3 class="s-pdp-reviews__title">{{ b.title | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p class="s-pdp-reviews__text">{{ b.text | escape }}</p>{%- endif -%}
            <p class="s-pdp-reviews__who"><b>{{ b.name | escape }}</b>
              {%- liquid
                assign meta = ''
                if b.duration != blank
                  assign meta = b.duration
                endif
                if b.bought != blank
                  if meta != blank
                    assign meta = meta | append: ', '
                  endif
                  assign meta = meta | append: b.bought
                endif
              -%}{{ meta | escape }}</p>
          </div>
        </article>
        {%- assign i = i | plus: 1 -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if s.show_write and apps == 0 -%}
    {%- liquid
      assign w_product = rp.title | default: s.product_fallback
      assign w_line = w_product
      if rp != blank
        assign w_line = w_product | append: ' (' | append: shop.url | append: rp.url | append: ')'
      endif
    -%}
    <dialog class="s-pdp-reviews__dlg" id="{{ anchor }}-write" aria-labelledby="{{ anchor }}-write-title" data-rev-dialog data-rate-tpl="{{ w_rate_text | escape }}" data-err-rating="{{ w_err_rating | escape }}" data-err-text="{{ w_err_text | escape }}" data-err-name="{{ w_err_name | escape }}" data-err-email="{{ w_err_email | escape }}">
      <div class="s-pdp-reviews__dlg-hd"><div><h2 id="{{ anchor }}-write-title">{{ w_write_heading | default: s.write_label | escape }}</h2><p>{{ w_product | escape }}</p></div><button type="button" class="icon-btn" aria-label="{{ w_close_label | escape }}" data-rev-close><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
      {%- form 'contact', id: 'pdp-review-form', class: 's-pdp-reviews__form', novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="{{ s.review_tag | default: 'review' | escape }}"><input type="hidden" name="contact[Product]" value="{{ w_line | escape }}"><input type="hidden" name="contact[Photo]" value="" data-rev-photo-name>
        <div class="s-pdp-reviews__ask" data-rev-ask>
          <div class="s-pdp-reviews__fields">
            <fieldset class="s-pdp-reviews__f"><legend>{{ w_label_rating | escape }}</legend><div class="s-pdp-reviews__rate"><div class="s-pdp-reviews__stars" data-rev-stars aria-describedby="{{ anchor }}-err-rating">
              {%- for n in (1..5) -%}{%- assign aria = w_rate_text | replace: '[n]', n -%}<input type="radio" name="contact[Rating]" id="{{ anchor }}-star-{{ n }}" value="{{ n }}"{% if n == 1 %} required{% endif %}><label for="{{ anchor }}-star-{{ n }}" title="{{ aria | escape }}"><span aria-hidden="true">★</span><span class="sr">{{ aria | escape }}</span></label>{%- endfor -%}
            </div><span class="s-pdp-reviews__rate-txt" data-rev-rate-txt aria-hidden="true"></span></div><p class="s-pdp-reviews__err" id="{{ anchor }}-err-rating" data-rev-err="rating" aria-live="polite"></p></fieldset>
            {%- if w_show_skin -%}<fieldset class="s-pdp-reviews__f"><legend>{{ w_label_skin | escape }}{%- if w_label_optional != blank %} <span class="s-pdp-reviews__opt">{{ w_label_optional | escape }}</span>{% endif -%}</legend><div class="s-pdp-reviews__chips"><input type="radio" name="contact[{{ w_label_skin | default: 'Skin type' | escape }}]" id="{{ anchor }}-skin-eczema" value="{{ s.label_eczema | escape }}"><label for="{{ anchor }}-skin-eczema">{{ s.label_eczema | escape }}</label><input type="radio" name="contact[{{ w_label_skin | default: 'Skin type' | escape }}]" id="{{ anchor }}-skin-dry" value="{{ s.label_dry | escape }}"><label for="{{ anchor }}-skin-dry">{{ s.label_dry | escape }}</label><input type="radio" name="contact[{{ w_label_skin | default: 'Skin type' | escape }}]" id="{{ anchor }}-skin-sensitive" value="{{ s.label_sensitive | escape }}"><label for="{{ anchor }}-skin-sensitive">{{ s.label_sensitive | escape }}</label><input type="radio" name="contact[{{ w_label_skin | default: 'Skin type' | escape }}]" id="{{ anchor }}-skin-little" value="{{ s.label_little | escape }}"><label for="{{ anchor }}-skin-little">{{ s.label_little | escape }}</label></div></fieldset>{%- endif -%}
            <div class="s-pdp-reviews__f"><label for="{{ anchor }}-w-title">{{ w_label_title | escape }}{%- if w_label_optional != blank %} <span class="s-pdp-reviews__opt">{{ w_label_optional | escape }}</span>{% endif -%}</label><input type="text" id="{{ anchor }}-w-title" name="contact[Title]" maxlength="80" placeholder="{{ w_ph_title | escape }}"></div>
            <div class="s-pdp-reviews__f"><label for="{{ anchor }}-w-text">{{ w_label_text | escape }}</label><textarea id="{{ anchor }}-w-text" name="contact[body]" rows="5" required minlength="10" maxlength="2000" placeholder="{{ w_ph_text | escape }}" data-rev-field="text" aria-describedby="{{ anchor }}-err-text"></textarea><p class="s-pdp-reviews__err" id="{{ anchor }}-err-text" data-rev-err="text" aria-live="polite"></p></div>
            <div class="s-pdp-reviews__pair">
              <div class="s-pdp-reviews__f"><label for="{{ anchor }}-w-name">{{ w_label_name | escape }}</label><input type="text" id="{{ anchor }}-w-name" name="contact[name]" autocomplete="given-name" required placeholder="{{ w_ph_name | escape }}" data-rev-field="name" aria-describedby="{{ anchor }}-err-name"{% if customer %} value="{{ customer.first_name | escape }}"{% endif %}><p class="s-pdp-reviews__err" id="{{ anchor }}-err-name" data-rev-err="name" aria-live="polite"></p></div>
              <div class="s-pdp-reviews__f"><label for="{{ anchor }}-w-email">{{ w_label_email | escape }}</label><input type="email" id="{{ anchor }}-w-email" name="contact[email]" autocomplete="email" required placeholder="{{ w_ph_email | escape }}" data-rev-field="email" aria-describedby="{{ anchor }}-err-email"{% if customer %} value="{{ customer.email | escape }}"{% endif %}><p class="s-pdp-reviews__err" id="{{ anchor }}-err-email" data-rev-err="email" aria-live="polite"></p></div>
            </div>
            {%- if w_show_photo -%}<div class="s-pdp-reviews__f"><span class="s-pdp-reviews__flabel">{{ w_label_photo | escape }}{%- if w_label_optional != blank %} <span class="s-pdp-reviews__opt">{{ w_label_optional | escape }}</span>{% endif -%}</span><div class="s-pdp-reviews__photo"><input type="file" id="{{ anchor }}-w-photo" name="review_photo" accept="image/*" data-rev-file aria-describedby="{{ anchor }}-photo-hint"><label class="s-pdp-reviews__photo-add" for="{{ anchor }}-w-photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>{{ w_photo_add | escape }}</label><div class="s-pdp-reviews__photo-pick" data-rev-pick hidden><img alt="" width="56" height="56"><span></span><button type="button">{{ w_photo_remove | escape }}</button></div></div>{%- if w_photo_hint != blank -%}<p class="s-pdp-reviews__hint" id="{{ anchor }}-photo-hint">{{ w_photo_hint | escape }}</p>{%- endif -%}</div>{%- endif -%}
          </div>
          <div class="s-pdp-reviews__dlg-ft"><button type="submit" class="btn btn--primary btn--block">{{ w_submit_label | escape }}</button>{%- if w_privacy_note != blank -%}<p>{{ w_privacy_note | escape }}</p>{%- endif -%}</div>
        </div>
      {%- endform -%}
      <div class="s-pdp-reviews__done" data-rev-done tabindex="-1" role="status" hidden><h3>{{ w_thanks_title | escape }}</h3>{%- if w_thanks_text != blank -%}<p>{{ w_thanks_text | escape }}</p>{%- endif -%}<div class="s-pdp-reviews__done-row"><button type="button" class="btn btn--primary" data-rev-close>{{ w_thanks_back | escape }}</button>{%- if w_thanks_again != blank -%}<button type="button" class="btn btn--ghost" data-rev-again>{{ w_thanks_again | escape }}</button>{%- endif -%}</div></div>
    </dialog>
  {%- endif -%}
  <div class="s-pdp-reviews__foot">
    {%- if apps == 0 -%}
      <div class="s-pdp-reviews__more">
        <button type="button" class="btn btn--ghost" data-rev-more{% if total <= page_size %} hidden{% endif %}>{{ s.more_label | escape }}</button>
        {%- if total > 0 -%}<span class="s-pdp-reviews__shown" data-rev-shown data-tpl="{{ s.shown_text | escape }}">{{ s.shown_text | replace: '[shown]', shown_n | replace: '[total]', total | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.help_text != blank or s.help_link_label != blank -%}
      <p class="s-pdp-reviews__help">{{ s.help_text | escape }}{%- if s.help_link_label != blank -%}<a href="{{ s.help_link | default: '#' }}" class="link">{{ s.help_link_label | escape }}</a>{%- endif -%}</p>
    {%- endif -%}
  </div>
</div></section>

{% schema %}
{
  "name": "Lather product reviews",
  "class": "blko-lv3-section-product-reviews",
  "max_blocks": 24,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "inline_richtext",
      "id": "heading_1",
      "label": "Heading, line 1",
      "default": "The feel, in"
    },
    {
      "type": "inline_richtext",
      "id": "heading_2",
      "label": "Heading, line 2",
      "default": "your <em>words.</em>",
      "info": "Italic text shows in the accent style."
    },
    {
      "type": "header",
      "content": "Rating summary"
    },
    {
      "type": "paragraph",
      "content": "Reads the product's review metafields (reviews.rating and reviews.rating_count), which most review apps fill. The values below show only when those are empty."
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show average rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_fallback",
      "label": "Average rating (fallback)",
      "default": "4.6",
      "info": "Out of 5."
    },
    {
      "type": "number",
      "id": "count_fallback",
      "label": "Number of reviews (fallback)",
      "default": 318
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Count text",
      "default": "[count] reviews of [product]",
      "info": "[count] and [product] are filled in."
    },
    {
      "type": "text",
      "id": "product_fallback",
      "label": "Product name (fallback)",
      "default": "Calm wash"
    },
    {
      "type": "text",
      "id": "stars_aria",
      "label": "Stars label (screen readers)",
      "default": "[n] out of 5 stars"
    },
    {
      "type": "header",
      "content": "Skin type filter"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show filter",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label",
      "default": "Skin type"
    },
    {
      "type": "text",
      "id": "label_all",
      "label": "All",
      "default": "All"
    },
    {
      "type": "text",
      "id": "label_eczema",
      "label": "Skin type 1",
      "default": "Eczema-prone"
    },
    {
      "type": "text",
      "id": "label_dry",
      "label": "Skin type 2",
      "default": "Very dry"
    },
    {
      "type": "text",
