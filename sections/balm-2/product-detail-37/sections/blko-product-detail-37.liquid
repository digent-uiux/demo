  ],
  "presets": [
    {
      "name": "Product detail 37",
      "blocks": [
        {
          "type": "photo",
          "settings": {
            "caption": "Bottle"
          }
        },
        {
          "type": "photo",
          "settings": {
            "caption": "Drop"
          }
        },
        {
