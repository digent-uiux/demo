{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-blog-37.css' | asset_url | stylesheet_tag }}
<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-blog-37.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-balm', tokens: s.tokens -%}
{%- comment -%}
  The herbarium cabinet, balm journal: each article is a mounted specimen sheet. The first sheet of each page is the
  lead (a 7-column 4:5 plate held by photo corners, its herbarium label pasted over the corner, a big amber sheet number
  and the title in didone beside it, the number in amber didone); the envelope word is didone italic; the rest hang on the wall below in an asymmetric 12-column rhythm. Each label:
  sheet No., family (first tag, linked to the tagged view), collected (date), by (author, read time). An article with no
  image and a custom.inci metafield is a glassine seed envelope. Pagination is a ruled sheet counter.
  Live: blog.articles, paginated. Preview: the post blocks, paged in the browser. Phones: one column, sheets alternate
  a 10% indent. Motion: the balm kit, plus the labels pasting down after their plates (CSS, kit flag only).
{%- endcomment -%}
{{ 'blko-balm-motion.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'blko-balm-motion.js' | asset_url }}" defer="defer"></script
>{%- liquid
  assign jb = blog
  if jb == blank
    assign jb = s.blog
  endif
  assign live = false
  if jb != blank and jb.articles_count > 0
    assign live = true
  endif
  assign per = s.per_page
  assign n_demo = 0
  for b in section.blocks
    if b.type == 'post'
      assign n_demo = n_demo | plus: 1
    endif
  endfor
-%}
{%- capture grid -%}
  {%- if live -%}
    {%- paginate jb.articles by per -%}
      {%- assign total = paginate.items -%}
      {%- assign first = paginate.current_offset | plus: 1 -%}
      {%- for a in jb.articles -%}
        {%- assign pos = forloop.index0 -%}
        {%- assign n = paginate.current_offset | plus: forloop.index -%}
        {%- assign last = n -%}
        {%- assign w = pos | minus: 1 | modulo: 5 | plus: 1 -%}
        {%- assign words = a.content | strip_html | split: ' ' | size -%}
        {%- assign mins = '' -%}
        {%- if s.show_mins -%}{%- assign mins = words | divided_by: 200 | floor | at_least: 1 -%}{%- endif -%}
        {%- assign dek = a.excerpt | default: a.content | strip_html | truncatewords: 18 -%}
        {%- assign word = a.title | split: ':' | first | split: ',' | first -%}
        {%- capture iso -%}{{ a.published_at | date: '%Y-%m-%d' }}{%- endcapture -%}
        {%- capture dt -%}{{ a.published_at | date: '%b %-d, %Y' }}{%- endcapture -%}
        {%- assign fam = a.tags.first -%}
        {%- capture fam_url -%}{% if fam != blank %}{{ jb.url }}/tagged/{{ fam | handleize }}{% endif %}{%- endcapture -%}
        {%- assign tags = a.tags | join: ' · ' -%}
        {%- if pos == 0 -%}{%- assign is_lead = true -%}{%- else -%}{%- assign is_lead = false -%}{%- endif -%}
        {%- render 'blko-blog-37-sheet', url: a.url, title: a.title, dek: dek, family: fam, family_url: fam_url, tags: tags, by: a.author, mins: mins, date: dt, iso: iso, image: a.image, word: word, inci: a.metafields.custom.inci, n: n, lead: is_lead, w: w, page: 1 -%}
      {%- endfor -%}
      {%- capture nav -%}
        <nav aria-label="{{ 'blko.blog_37.pages' | t }}" class="bblog37__nav"
          >{%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="bblog37__cap bblog37__step">{%- render 'blko-ui-icon', name: 'arrow-left', size: 16, stroke: 2 -%}<span class="bblog37__steplbl">{{ 'blko.blog_37.newer' | t }}</span></a
          >{%- else -%}<span class="bblog37__cap bblog37__step is-off" aria-disabled="true">{%- render 'blko-ui-icon', name: 'arrow-left', size: 16, stroke: 2 -%}<span class="bblog37__steplbl">{{ 'blko.blog_37.newer' | t }}</span></span>{%- endif -%}
          <div class="bblog37__mid"
            ><p class="bblog37__cap bblog37__muted bblog37__count">{{ 'blko.blog_37.count' | t | replace: '[a]', first | replace: '[b]', last | replace: '[t]', total }}</p
            >{%- if paginate.pages > 1 -%}
            <ol class="bblog37__pages"
              >{%- for part in paginate.parts -%}
                {%- assign pn = part.title | prepend: '0' | slice: -2, 2 -%}
                {%- assign pl = 'blko.blog_37.page' | t | replace: '[n]', part.title -%}
                <li>{%- if part.is_link -%}<a href="{{ part.url }}" class="bblog37__pg" aria-label="{{ pl }}">{{ pn }}</a
                >{%- elsif part.title == paginate.current_page -%}<span class="bblog37__pg" aria-current="page" aria-label="{{ pl }}">{{ pn }}</span
                >{%- else -%}<span class="bblog37__pg">{{ part.title }}</span>{%- endif -%}</li
              >{%- endfor -%}
            </ol
            >{%- endif -%}
          </div
          >{%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="bblog37__cap bblog37__step"><span class="bblog37__steplbl">{{ 'blko.blog_37.older' | t }}</span>{% render 'blko-ui-icon', name: 'arrow-right', size: 16, stroke: 2 %}</a
          >{%- else -%}<span class="bblog37__cap bblog37__step is-off" aria-disabled="true"><span class="bblog37__steplbl">{{ 'blko.blog_37.older' | t }}</span>{% render 'blko-ui-icon', name: 'arrow-right', size: 16, stroke: 2 %}</span>{%- endif -%}
        </nav
      >{%- endcapture -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- assign i = 0 -%}
    {%- for b in section.blocks -%}
      {%- if b.type != 'post' -%}{%- continue -%}{%- endif -%}
      {%- assign bs = b.settings -%}
      {%- assign pos = i | modulo: per -%}
      {%- assign pg = i | divided_by: per | floor | plus: 1 -%}
      {%- assign i = i | plus: 1 -%}
      {%- if pg > 1 -%}{%- assign hide = true -%}{%- else -%}{%- assign hide = false -%}{%- endif -%}
      {%- if pos == 0 -%}{%- assign is_lead = true -%}{%- else -%}{%- assign is_lead = false -%}{%- endif -%}
      {%- assign w = pos | minus: 1 | modulo: 5 | plus: 1 -%}
      {%- assign tl = bs.topic | split: ',' -%}
      {%- assign fam = tl.first | strip -%}
      {%- assign tags = bs.topic | replace: ', ', ' · ' | replace: ',', ' · ' -%}
      {%- assign mins = '' -%}
      {%- if s.show_mins -%}{%- assign mins = bs.mins -%}{%- endif -%}
      {%- render 'blko-blog-37-sheet', url: bs.link, title: bs.title, dek: bs.dek, family: fam, tags: tags, by: bs.by, mins: mins, date: bs.date, image: bs.image, word: bs.word, inci: bs.inci, n: i, lead: is_lead, w: w, page: pg, hide: hide -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- unless live -%}
  {%- capture nav -%}
    {%- assign pages = n_demo | plus: per | minus: 1 | divided_by: per | floor -%}
    {%- assign last = per | at_most: n_demo -%}
    <nav aria-label="{{ 'blko.blog_37.pages' | t }}" class="bblog37__nav" data-pager data-per="{{ per }}" data-total="{{ n_demo }}"
      ><button type="button" class="bblog37__cap bblog37__step" data-prev disabled>{%- render 'blko-ui-icon', name: 'arrow-left', size: 16, stroke: 2 -%}<span class="bblog37__steplbl">{{ 'blko.blog_37.newer' | t }}</span></button
      ><div class="bblog37__mid"
        ><p class="bblog37__cap bblog37__muted bblog37__count" data-count data-t="{{ 'blko.blog_37.count' | t }}">{{ 'blko.blog_37.count' | t | replace: '[a]', 1 | replace: '[b]', last | replace: '[t]', n_demo }}</p
        ><ol class="bblog37__pages" data-pages
          >{%- for p in (1..pages) -%}
            {%- assign pn = p | prepend: '0' | slice: -2, 2 -%}
            <li><button type="button" class="bblog37__pg" data-goto="{{ p }}" aria-label="{{ 'blko.blog_37.page' | t | replace: '[n]', p }}"{% if p == 1 %} aria-current="page"{% endif %}>{{ pn }}</button></li
          >{%- endfor -%}
        </ol
      ></div
      ><button type="button" class="bblog37__cap bblog37__step" data-next{% if pages < 2 %} disabled{% endif %}><span class="bblog37__steplbl">{{ 'blko.blog_37.older' | t }}</span>{% render 'blko-ui-icon', name: 'arrow-right', size: 16, stroke: 2 %}</button
    ></nav
  >{%- endcapture -%}
{%- endunless -%}
{%- capture body -%}
  <ul class="bblog37__wall" data-wall aria-label="{{ s.label | escape }}">{{ grid }}</ul
  >{{ nav -}}
{%- endcapture -%}
<div class="bblog37{%- if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
  >{%- render 'blko-ui-section', surface: 'bg', bleed: true, label: s.label, className: 'bblog37__section', inner: 'bblog37__inner', children: body -%}
</div

>

{% schema %}
{
  "name": "Herbarium sheets journal",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "On a blog page this lists the blog's articles as herbarium sheets, six (or your number) a page: the first of each page is the lead sheet. Each label shows the article's first tag (family), date, author and read time. An article with no image but a custom.inci metafield is set as a seed envelope: the word before the first colon or comma, and the INCI line. The post blocks only fill the preview elsewhere."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Region label",
      "default": "The journal"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Sheets per page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Used outside a blog page. On a blog page the current blog is listed."
    },
    {
      "type": "checkbox",
      "id": "show_mins",
      "label": "Show read time",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Balm)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "color_scheme",
