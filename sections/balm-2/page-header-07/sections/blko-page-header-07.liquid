{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-2'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-page-header-07.css' | asset_url | stylesheet_tag }}
<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-balm', tokens: s.tokens -%}
{%- comment -%}
  Page header, balm: a small-caps breadcrumb (Home — current page), a didone h1 with one italic word, a muted lead; a
  small square plate photo with a "Fig. I" caption on the right; a double hairline closes the band. The breadcrumb's
  current item is the setting, else the page title. Entry motion comes from the balm kit.
{%- endcomment -%}
{{ 'blko-balm-motion.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'blko-balm-motion.js' | asset_url }}" defer="defer"></script
>{%- liquid
  assign crumb = s.crumb
  if crumb == blank and page.title != blank
    assign crumb = page.title
  endif
-%}
{%- capture body -%}
  <div class="bpageheader07__grid"
    ><div class="bpageheader07__copy"
      >{%- if s.show_crumbs -%}
      <nav aria-label="{{ 'blko.page_header_07.breadcrumb' | t }}"
        ><ol class="bpageheader07__crumbs bpageheader07__cap"
          ><li><a href="{{ routes.root_url }}">{{ 'blko.page_header_07.home' | t }}</a></li
          ><li aria-hidden="true">—</li
          ><li aria-current="page" class="bpageheader07__here">{{ crumb | escape }}</li
        ></ol
      ></nav
      >{%- endif -%}
      <h1 class="bpageheader07__h1">{{ s.heading | escape }}{% if s.heading_em != blank %} <em>{{ s.heading_em | escape }}</em>{% endif %}</h1
      >{%- if s.text != blank -%}<p class="bpageheader07__lead">{{ s.text | escape }}</p>{%- endif -%}
    </div
    ><figure class="bpageheader07__fig"
      ><div class="bpageheader07__plate"
        >{%- if s.image != blank -%}
          {{ s.image | image_url: width: 600 | image_tag: widths: '200, 300, 450, 600', sizes: '(min-width: 768px) 224px, 160px', class: 'bpageheader07__img', alt: s.image.alt -}}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'bpageheader07__img' -}}
        {%- endif -%}
      </div
      >{%- if s.caption != blank -%}<figcaption class="bpageheader07__cap bpageheader07__figcap">{{ s.caption | escape }}</figcaption>{%- endif -%}
    </figure
  ></div
  ><div aria-hidden="true" class="bpageheader07__rule"><span></span><span></span></div
>{%- endcapture -%}
<div class="bpageheader07{%- if blko_sid != 'scheme-2' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
  >{%- render 'blko-ui-section', surface: s.surface, bleed: true, label: s.label, className: 'bpageheader07__section', inner: 'bpageheader07__inner', children: body -%}
</div

>

{% schema %}
{
  "name": "Page header, plate",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Region label",
      "default": "Page header: Our apothecary"
    },
    {
      "type": "checkbox",
      "id": "show_crumbs",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "crumb",
      "label": "Current page in breadcrumb",
      "default": "Our apothecary",
      "info": "Blank uses the page title."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grown in a field, finished by"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Heading, italic word",
      "default": "hand"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Oils, balms and tonics poured in small batches from oat, olive and herbs we buy from three farms we have walked."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Plate photo"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Plate caption",
      "default": "Fig. I · The lavender rows"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Colour",
      "options": [
        {
          "value": "bg",
          "label": "Background"
        },
        {
          "value": "alt",
          "label": "Alternate"
        },
        {
          "value": "pop-1",
          "label": "Pop 1"
        },
        {
          "value": "pop-2",
          "label": "Pop 2"
        }
      ],
      "default": "bg"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Balm)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Repaints the section with a scheme from Theme settings > Colors. Works when Colors, fonts, corners reads the theme's tokens.",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Page header, plate"
    }
  ],
  "class": "blko-bundle"
}
{% endschema %}
