{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-4'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-announcement-06.css' | asset_url | stylesheet_tag }}
<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-announcement-06.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-balm', tokens: s.tokens -%}
{%- comment -%}
  Balm announcement: ink strip (announcement tokens) with a Karla body line (the accent word in medium weight, the tail shows from
  576px), a square code chip in the accent and a square dismiss button. Dismissed stays dismissed for the visit.
{%- endcomment -%}
{%- liquid
  assign show_bar = true
  if s.home_only and request.page_type != 'index'
    assign show_bar = false
  endif
-%}
{%- if show_bar -%}
<div class="bannouncement06{%- if blko_sid != 'scheme-4' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-bannouncement06
  ><div role="region" aria-label="{{ 'blko.announcement_06.label' | t | escape }}" class="bannouncement06__bar"
    ><div class="bannouncement06__row"
      >{%- if s.link != blank -%}<a href="{{ s.link }}" class="bannouncement06__text">{%- else -%}<p class="bannouncement06__text">{%- endif -%}
        {{- s.text -}}
        {%- if s.tail != blank -%}<span class="bannouncement06__tail">{{ s.tail | escape }}</span>{%- endif -%}
      {%- if s.link != blank -%}</a>{%- else -%}</p>{%- endif -%}
      {%- if s.code != blank -%}<span class="bannouncement06__code">{{ s.code | escape }}</span>{%- endif -%}
      <button type="button" aria-label="{{ 'blko.announcement_06.dismiss' | t | escape }}" class="bannouncement06__x" data-dismiss
        >{%- render 'blko-ui-icon', name: 'x', size: 16 -%}
      </button
    ></div
  ></div
></div
>{%- endif -%}

{% schema %}
{
  "name": "Announcement 06 - Serif",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "home_only",
      "label": "Show on the home page only",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Line (italic = accent word, set in medium)",
      "default": "It’s <em>glow</em> season"
    },
    {
      "type": "text",
      "id": "tail",
      "label": "Line end (wider screens)",
      "default": ", 15% off your first order"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Code chip",
      "default": "GLOW15"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Balm)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Repaints the section with a scheme from Theme settings > Colors. Works when Colors, fonts, corners reads the theme's tokens.",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Announcement 06 - Serif"
    }
  ],
  "class": "blko-bundle"
}
{% endschema %}
