{%- comment -%}
  Balm cart drawer: a modal <dialog> from the right, on paper. A ledger like the cart page (cart-page-36): a small-caps
  "Your bag · 03 items" label over the Bodoni heading, an amber free-shipping hairline, ruled lines (amber No. 01, square
  photo, name, options, line discounts, a square −/+ stepper, the Bodoni price, Remove), then the label-framed summary
  (subtotal, cart discounts, taxes line) and one dark square Check out. Real cart only: /cart/change.js and the Section
  Rendering API (?sections=blko-cart-drawer, or the `sections` field of /cart/add.js and /cart/change.js).
  Opens from the header bag ([data-bag]), after any form posted to /cart/add, and on `blko:cart:add`.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
  assign free_c = s.free_over | times: 100
  assign subt = cart.items_subtotal_price
  assign left = free_c | minus: subt | at_least: 0
  assign capped = subt | at_most: free_c
  assign pct = 0
  if free_c > 0
    assign pct = capped | times: 100 | divided_by: free_c
  endif
-%}
{{ 'blko-cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-cart-drawer.js' | asset_url }}" defer="defer"></script>
<blko-cart-drawer class="bcd" data-enabled="{{ s.enabled }}">
  <dialog class="bcd__dialog{% if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" aria-labelledby="bcd-title" data-dialog>
    <div class="bcd__panel" data-drawer-body data-count="{{ cart.item_count }}">
      <div class="bcd__head">
        <p class="bcd__label bcd__muted">{{ 'blko.cart_drawer.count' | t: count: cart.item_count }}</p>
        <h2 id="bcd-title" class="bcd__title">{{ s.heading | escape }}</h2>
        <button type="button" class="bcd__close" data-close aria-label="{{ 'blko.cart_drawer.close' | t | escape }}">{%- render 'blko-icon', name: 'x', size: 18 -%}</button>
      </div>

      {%- if cart.item_count > 0 -%}
        {%- if free_c > 0 -%}
        <div class="bcd__ship">
          <p class="bcd__ship-row">
            <span>
              {%- if left > 0 -%}
                {%- assign left_m = left | money_without_trailing_zeros -%}{{ 'blko.cart_drawer.free_left' | t: amount: left_m }}
              {%- else -%}
                {{ 'blko.cart_drawer.free_done' | t }}
              {%- endif -%}
            </span>
            {%- assign free_m = free_c | money_without_trailing_zeros -%}
            <span class="bcd__label bcd__muted">{{ 'blko.cart_drawer.free_from' | t: amount: free_m }}</span>
          </p>
          <div class="bcd__track" role="progressbar" aria-label="{{ 'blko.cart_drawer.shipping_progress' | t | escape }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}"><span style="transform:scaleX({{ pct | divided_by: 100.0 }})"></span></div>
        </div>
        {%- endif -%}

        <ol class="bcd__lines" aria-label="{{ 'blko.cart_drawer.items' | t | escape }}">
          {%- for it in cart.items -%}
          <li class="bcd__line" data-key="{{ it.key }}">
            <span class="bcd__label bcd__no" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <a href="{{ it.url }}" class="bcd__img" tabindex="-1" aria-hidden="true">
              {%- if it.image != blank -%}
                {{ it.image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', widths: '120, 240', sizes: '72px' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'bcd__ph' }}
              {%- endif -%}
            </a>
            <div class="bcd__info">
              <a href="{{ it.url }}" class="bcd__name">{{ it.product.title | escape }}</a>
              {%- unless it.product.has_only_default_variant -%}
                <p class="bcd__label bcd__muted">{% for o in it.options_with_values %}{{ o.value | escape }}{% unless forloop.last %} · {% endunless %}{% endfor %}</p>
              {%- endunless -%}
              {%- if it.selling_plan_allocation != blank -%}<p class="bcd__meta">{{ it.selling_plan_allocation.selling_plan.name | escape }}</p>{%- endif -%}
              {%- for d in it.line_level_discount_allocations -%}<p class="bcd__meta bcd__off">{{ d.discount_application.title | escape }} (−{{ d.amount | money }})</p>{%- endfor -%}
              <div class="bcd__row">
                <div class="bcd__qty" role="group" aria-label="{{ 'blko.cart_drawer.quantity_for' | t: title: it.product.title | escape }}">
                  <button type="button" data-qty="{{ it.quantity | minus: 1 }}" aria-label="{{ 'blko.cart_drawer.decrease' | t: title: it.product.title | escape }}">{%- render 'blko-icon', name: 'minus', size: 14 -%}</button>
                  <span>{{ it.quantity }}</span>
                  <button type="button" data-qty="{{ it.quantity | plus: 1 }}" aria-label="{{ 'blko.cart_drawer.increase' | t: title: it.product.title | escape }}">{%- render 'blko-icon', name: 'plus', size: 14 -%}</button>
                </div>
                <p class="bcd__price">
                  {%- if it.original_line_price != it.final_line_price -%}<s class="bcd__muted">{{ it.original_line_price | money }}</s> {% endif -%}
                  {{ it.final_line_price | money }}
                </p>
              </div>
              <button type="button" class="bcd__rm" data-qty="0">{{ 'blko.cart_drawer.remove' | t }}<span class="bcd__sr"> {{ it.product.title | escape }}</span></button>
            </div>
          </li>
          {%- endfor -%}
        </ol>

        <div class="bcd__foot">
          <dl class="bcd__sum">
            <div><dt>{{ 'blko.cart_drawer.subtotal' | t }}</dt><dd>{{ cart.items_subtotal_price | money }}</dd></div>
            {%- for da in cart.cart_level_discount_applications -%}
              <div><dt>{{ da.title | escape }}</dt><dd>−{{ da.total_allocated_amount | money }}</dd></div>
            {%- endfor -%}
            <div class="bcd__total"><dt class="bcd__label">{{ 'blko.cart_drawer.total' | t }}</dt><dd>{{ cart.total_price | money }}</dd></div>
          </dl>
          <form action="{{ routes.cart_url }}" method="post" class="bcd__actions">
            <button type="submit" name="checkout" class="bcd__btn bcd__btn--main">{{ 'blko.cart_drawer.checkout' | t }}{%- render 'blko-icon', name: 'arrow-up-right', size: 16 -%}</button>
            <a href="{{ routes.cart_url }}" class="bcd__link">{{ 'blko.cart_drawer.view' | t }}</a>
          </form>
          <p class="bcd__label bcd__muted bcd__tax">{% if cart.taxes_included %}{{ 'blko.cart_drawer.taxes_included' | t }}{% else %}{{ 'blko.cart_drawer.taxes_excluded' | t }}{% endif %}</p>
        </div>
      {%- else -%}
        <div class="bcd__empty">
          <p class="bcd__label"><span class="bcd__accent">No. 00</span></p>
          <p class="bcd__eh">{{ s.empty_heading | escape }}</p>
          {%- if s.empty_text != blank -%}<p class="bcd__muted">{{ s.empty_text | escape }}</p>{%- endif -%}
          <a href="{{ s.empty_link | default: routes.all_products_collection_url }}" class="bcd__btn bcd__btn--main">{{ 'blko.cart_drawer.continue' | t }}</a>
        </div>
      {%- endif -%}
      <p class="bcd__sr" role="status" aria-live="polite" data-msg></p>
    </div>
  </dialog>
</blko-cart-drawer>

{% schema %}
{
  "name": "t:blko.cart_drawer.schema.name",
  "tag": "div",
  "class": "blko-cart-drawer-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Repaints the section with a scheme from Theme settings > Colors. Works when Colors, fonts, corners reads the theme's tokens.",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:blko.cart_drawer.schema.enabled",
      "default": true,
      "info": "t:blko.cart_drawer.schema.enabled_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:blko.cart_drawer.schema.heading",
      "default": "Your bag"
    },
    {
      "type": "number",
      "id": "free_over",
      "label": "t:blko.cart_drawer.schema.free_over",
      "default": 75
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:blko.cart_drawer.schema.empty_heading",
      "default": "The bag is empty for now."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "t:blko.cart_drawer.schema.empty_text",
      "default": "Every formula is poured in small batches. Take your time."
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "t:blko.cart_drawer.schema.empty_link"
    }
  ]
}
{% endschema %}
