    },
    {
      "type": "text",
      "id": "demo_alt",
      "label": "Demo photo description",
      "default": "Close-up of a model having lip colour applied with a brush"
    },
    {
      "type": "text",
      "id": "skins_label",
      "label": "Skin tones line",
      "default": "On three skin tones"
    },
    {
      "type": "text",
      "id": "skin_alt",
      "label": "Demo skin-tone photo description",
      "default": "Close-up of lips on [tone] skin",
      "info": "[tone] is the skin tone name."
    },
    {
      "type": "text",
      "id": "skin_1_name",
      "label": "Skin tone 1",
      "default": "Fair"
    },
    {
      "type": "image_picker",
      "id": "skin_1_image",
      "label": "Skin tone 1 photo"
    },
    {
      "type": "text",
      "id": "skin_2_name",
      "label": "Skin tone 2",
      "default": "Medium"
    },
    {
      "type": "image_picker",
      "id": "skin_2_image",
      "label": "Skin tone 2 photo"
    },
    {
      "type": "text",
      "id": "skin_3_name",
      "label": "Skin tone 3",
      "default": "Deep"
    },
    {
      "type": "image_picker",
      "id": "skin_3_image",
      "label": "Skin tone 3 photo",
      "info": "Photos of the shade on lips or skin. A tone without a photo is hidden on the store; the Theme Editor shows demo photos in the chosen shade."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to bag",
      "default": "Add [name] to bag",
