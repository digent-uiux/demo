      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "shade",
      "name": "Shade",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Shade name",
          "default": "New shade"
        },
        {
