        {
          "value": "soft-2",
          "label": "Soft tint"
        },
        {
          "value": "bg",
          "label": "Page"
        },
        {
          "value": "alt",
          "label": "Alternate"
        },
        {
          "value": "soft-1",
          "label": "Soft tint 2"
        }
      ]
    },
    {
      "type": "header",
