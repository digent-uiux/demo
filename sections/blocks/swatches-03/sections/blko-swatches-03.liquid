      "default": 420
    },
    {
      "type": "text",
      "id": "light_label",
      "label": "Light end",
      "default": "Light"
    },
    {
      "type": "text",
      "id": "heavy_label",
      "label": "Heavy end",
      "default": "Heavy"
    },
    {
      "type": "text",
      "id": "season_label",
      "label": "Season label",
      "default": "Season"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button",
