{%- comment -%}
  Installments 02, pay in four: three steps and a dated split (rivet preset; DS registry/installments/installments-02.tsx).
  Left 6/12: heading (condensed uppercase + a light second line) and three numbered steps (blocks) between rules.
  Right 6/12: the product photo in a 2px frame and the payment card under it: name, price, size options, "4 payments of
  $37.50" and four dated cells (the first, today, filled), Add to cart, the terms line. Phones: stacked.
  Live: the product setting, else the page's product: title, price, image, options, form 'product'. Inside the form
  {{ form | payment_terms }} prints Shop Pay Installments' live offer; an @app block (another pay-later app) sits beside
  it. The split divides the variant price by the payments setting; the dates count on from today by the interval.
  Preview (Theme Editor or no template, no product): the preview settings and dates. Live with no product: the photo,
  steps and a link button.
  Motion (html.blko-ui-motion): steps rise one by one (24px, 600ms, 80ms apart), the cells follow 300ms later.
  Static = the final frame.
{%- endcomment -%}
{%- liquid
  assign p = s.product | default: product
  assign apps = section.blocks | where: 'type', '@app'
  assign steps = section.blocks | where: 'type', 'step'
  assign live = false
  assign preview = false
  if p != blank
    assign live = true
  elsif request.design_mode or template == blank
    assign preview = true
  endif
  if live
    assign v = p.selected_or_first_available_variant
    assign cents = v.price
    assign title = p.title
    assign photo = p.featured_media.preview_image | default: s.image
  else
    assign cents = s.preview_price | times: 100
    assign title = s.preview_title
    assign photo = s.image
  endif
  assign n = s.payments
  assign part = cents | divided_by: n
  assign part_txt = part | money_without_trailing_zeros
  assign split_line = s.split_text | replace: '[n]', n
  assign pdates = s.preview_dates | split: ','
  assign now = 'now' | date: '%s' | plus: 0
  assign gap = s.interval | times: 86400
-%}
{%- capture split -%}
<div class="binstallments02__split"
  ><p class="blko-ui-text--small binstallments02__sline"><span class="binstallments02__strong">{{ split_line | escape }} <span data-part>{{ part_txt }}</span></span> <span class="binstallments02__muted">{{ s.split_note | escape }}</span></p
  ><ol class="binstallments02__cells" style="--n:{{ n }}"
    >{%- for k in (1..n) -%}
      {%- liquid
        assign i = forloop.index0
        if i == 0
          assign when = s.today_label
        elsif live
          assign at = gap | times: i | plus: now
          assign when = at | date: s.date_format
        else
          assign j = i | minus: 1
          assign when = pdates[j] | strip
        endif
      -%}
      <li class="binstallments02__cell{% if i == 0 %} binstallments02__cell--now{% endif %}" data-in2-cell style="--i:{{ i }}"{% if live and i > 0 %} data-at="{{ gap | times: i }}"{% endif %}><span
         class="blko-ui-text--label binstallments02__when">{{ when | escape }}</span
        ><span class="blko-ui-text--small binstallments02__amt" data-part>{{ part_txt }}</span
      ></li
    >{%- endfor -%}
  </ol
></div
>{%- endcapture -%}
{%- capture body -%}
<div class="binstallments02__grid" data-in2
  ><div class="binstallments02__left"
    ><h2 class="blko-ui-text--display binstallments02__title">{{ s.heading | escape }}{%- if s.heading_light != blank -%} <span class="blko-ui-text--h2 binstallments02__light">{{ s.heading_light | escape }}</span>{%- endif -%}</h2
    ><ol class="binstallments02__steps"
      >{%- for b in steps -%}
        <li class="binstallments02__step" data-in2-step style="--i:{{ forloop.index0 }}" {{ b.shopify_attributes }}
          ><span class="binstallments02__num" aria-hidden="true">{{ forloop.index }}</span
          ><span class="binstallments02__copy"
            ><span class="blko-ui-text--h3 binstallments02__name">{{ b.settings.title | escape }}</span
            >{%- if b.settings.text != blank -%}<span class="blko-ui-text--body binstallments02__muted binstallments02__text">{{ b.settings.text | escape }}</span>{%- endif -%}
          </span
        ></li
      >{%- endfor -%}
    </ol
  ></div

  ><div class="binstallments02__right"
    ><div class="binstallments02__photo"
      >{%- if photo != blank -%}
        {{ photo | image_url: width: 1200 | image_tag: class: 'binstallments02__img', widths: '600, 900, 1200', sizes: '(min-width: 896px) 48vw, 100vw', alt: photo.alt -}}
      {%- else -%}
        {{ 'product-apparel-3' | placeholder_svg_tag: 'binstallments02__img' -}}
      {%- endif -%}
    </div
    ><div class="binstallments02__card"
      ><div class="binstallments02__top"
        ><h3 class="blko-ui-text--h3 binstallments02__ptitle">{{ title | escape }}</h3
        >{%- if live or preview -%}<span class="blko-ui-text--price binstallments02__price" data-price>{{ cents | money_without_trailing_zeros }}</span>{%- endif -%}
      </div

      >{%- if live -%}
        {%- form 'product', p, class: 'binstallments02__form', data-in2-form: '' -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-id
          >{%- unless p.has_only_default_variant -%}
            {%- for opt in p.options_with_values -%}
              <div class="binstallments02__opts" role="group" aria-label="{{ opt.name | escape }}" data-opt="{{ forloop.index0 }}" data-blko-ui-options
                >{%- for val in opt.values -%}
                  {%- assign vt = val | escape -%}
                  {%- render 'blko-ui-option', children: vt, selected: val.selected, value: val -%}
                {%- endfor -%}
              </div
            >{%- endfor -%}
          {%- endunless -%}
          {{ split -}}
          <div class="binstallments02__pay">{{ form | payment_terms }}{%- for b in apps -%}{%- render b -%}{%- endfor -%}</div
          >{%- capture lbl -%}<span data-label>{%- if v.available -%}{{ s.button_label | escape }}{%- else -%}{{ s.sold_out_label | escape }}{%- endif -%}</span>{%- endcapture -%}
          {%- if v.available -%}
            {%- render 'blko-ui-button', type: 'submit', size: 'lg', full: true, children: lbl, attrs: 'data-add' -%}
          {%- else -%}
            {%- render 'blko-ui-button', type: 'submit', size: 'lg', full: true, children: lbl, attrs: 'data-add disabled' -%}
          {%- endif -%}
          <script type="application/json" data-variants>[{%- for x in p.variants -%}{"id":{{ x.id }},"o":{{ x.options | json }},"a":{{ x.available | json }},"c":{{ x.price }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>{%- endform -%}
      {%- elsif preview -%}
        {%- assign sizes = s.preview_sizes | split: ',' -%}
        <div class="binstallments02__opts" role="group" aria-label="{{ s.size_label | escape }}" data-blko-ui-options
          >{%- for z in sizes -%}
            {%- assign zt = z | strip -%}
            {%- assign sel = false -%}{%- if zt == s.preview_size -%}{%- assign sel = true -%}{%- endif -%}
            {%- render 'blko-ui-option', children: zt, selected: sel, value: zt -%}
          {%- endfor -%}
        </div
        >{{ split -}}
        {%- render 'blko-ui-button', size: 'lg', full: true, children: s.button_label -%}
      {%- else -%}
        {%- render 'blko-ui-button', href: s.link_url, size: 'lg', full: true, children: s.link_label -%}
      {%- endif -%}
      {%- if s.terms != blank -%}<p class="blko-ui-text--label binstallments02__muted binstallments02__terms">{{ s.terms | escape }}</p>{%- endif -%}
    </div
  ></div
></div
>{%- endcapture -%}
<div class="binstallments02" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-binstallments02 data-money="{{ shop.money_format | escape }}" data-t-add="{{ s.button_label | escape }}" data-t-sold="{{ s.sold_out_label | escape }}" data-n="{{ n }}"
  >{%- render 'blko-ui-section', surface: 'bg', label: s.label, children: body -%}
</div

>

{% schema %}
{
  "name": "Installments 02",
  "tag": "section",
  "settings": [
    {
      "type": "text",
