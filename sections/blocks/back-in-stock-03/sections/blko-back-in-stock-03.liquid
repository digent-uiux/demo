    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Empty on a product page: the page's product. Empty elsewhere: the preview below. One row per variant."
    },
    {
      "type": "paragraph",
      "content": "Live rows read two optional variant metafields: custom.size_note (e.g. Chest 94–100 cm) and custom.waitlist_count (a number)."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section name for screen readers",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your size, the day it's back"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Text under the heading",
      "default": "Every sold-out size has its own bell. Leave your email once and we write the day that size is off the needles."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Live: the product photo first."
    },
    {
      "type": "text",
      "id": "chip",
      "label": "Note on the photo",
      "default": "Hand-knit, batch of 60"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Note after the price",
      "default": "Fog grey, oversized fit"
    },
    {
      "type": "text",
      "id": "choose_label",
      "label": "Table label",
      "default": "Choose a size"
    },
    {
