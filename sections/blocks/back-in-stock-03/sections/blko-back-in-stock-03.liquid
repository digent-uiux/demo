{%- comment -%}
  Back in stock 03, per-size notify bells (ported from registry/back-in-stock/back-in-stock-03.tsx; the DS demo's
  store bar is left out: the theme's own header sits above). Dark scheme (the tokens flip, so shared parts stay
  readable). From a 768px container: a full-height photo on the left (0.9fr) with a small note chip, and on the right
  the section heading in condensed uppercase display type with a one-line lead, the product line (name, price, a short
  note), then a size table: one row per variant with the size, its measurement and its stock ("Sold out, 23 waiting",
  "Only 2 left" with a dot, "In stock"), and on the right either Add (in stock) or a Notify bell (sold out). A bell
  opens an inline email form under its row; once the shopper has left an email, later bells sign up at once and turn
  into "On". A note under the table explains the alerts.
  Live: the section's product (or the page product); one row per variant. Measurement: the variant metafield
  custom.size_note; waiting count: custom.waitlist_count (a number a waitlist app or the merchant fills; hidden when
  empty). "Only N left" for tracked variants at or under the threshold. The alert is a Shopify contact form per sold-out
  row (contact[email] + a hidden contact[body] naming product and variant), posted in place; Shopify's bot challenge
  falls back to a normal submit. Email and signed-up variants are remembered in localStorage (try/catch). Add posts
  cart/add.js. A back-in-stock app block (@app) replaces the bells' forms with the app's own UI under the table.
  Without a product the size blocks are the demo.
  Motion (html.blko-ui-motion only, no reduced motion; static = this layout with the M form open): when the band
  scrolls in the photo is masked up from the bottom, the rows unmask top-down one after another and the waiting counts
  tick up from 0 (tabular figures). A bell's form opens with a height and clip reveal. Buttons never move.
{%- endcomment -%}
{%- liquid
  assign uid = 'bis03-' | append: section.id
  assign item = s.product | default: product
  assign apps = section.blocks | where: 'type', '@app'
  assign sizes = section.blocks | where: 'type', 'size'
  assign live = false
  if item != blank
    assign live = true
  endif
  if live
    assign title = item.title
    assign photo = item.featured_image | default: s.image
    assign rows = item.variants
  else
    assign title = s.preview_title
    assign photo = s.image
    assign rows = sizes
  endif
  assign use_app = false
  if apps.size > 0
    assign use_app = true
  endif
-%}
<div class="bbackinstock03" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-bbackinstock03{% if live %} data-live{% endif %}{% if request.design_mode %} data-design{% endif %} data-t-saved="{{ s.saved_note | escape }}" data-t-error="{{ s.send_error | escape }}" data-t-on="{{ s.on_label | escape }}" data-t-in-bag="{{ s.in_bag_label | escape }}" data-t-add-error="{{ s.add_error | escape }}" data-t-add-preview="{{ s.add_preview | escape }}" data-t-waiting="{{ s.waiting_text | escape }}" data-t-stop="{{ s.on_aria | escape }}"
  ><section class="bbackinstock03__wrap" aria-label="{{ s.label | escape }}"
    ><div class="bbackinstock03__media"
      >{%- if photo != blank -%}
        {{ photo | image_url: width: 1400 | image_tag: class: 'bbackinstock03__img', widths: '600, 900, 1200, 1400', sizes: '(min-width: 768px) 45vw, 100vw', alt: photo.alt -}}
      {%- else -%}
        {{ 'product-apparel-3' | placeholder_svg_tag: 'bbackinstock03__img' -}}
      {%- endif -%}
      {%- if s.chip != blank -%}<span class="bbackinstock03__chip blko-ui-text--label">{{ s.chip | escape }}</span>{%- endif -%}
    </div

    ><div class="bbackinstock03__content"
      ><div class="bbackinstock03__head"
        >{%- if s.heading != blank -%}<h2 class="bbackinstock03__title">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.lead != blank -%}<p class="bbackinstock03__lead">{{ s.lead | escape }}</p>{%- endif -%}
      </div

      ><div class="bbackinstock03__titles"
        ><h3 class="bbackinstock03__name blko-ui-text--h4">{{ title | escape }}</h3
        ><p class="bbackinstock03__meta"><span class="bbackinstock03__price blko-ui-text--h4">{%- if live -%}{% render 'blko-ui-money', amount: item.price, cents: true %}{%- else -%}{% render 'blko-ui-money', amount: s.preview_price %}{%- endif -%}</span>{%- if s.subtitle != blank -%} {{ s.subtitle | escape }}{%- endif -%}</p
      ></div

      ><div class="bbackinstock03__sizes"
        ><p class="bbackinstock03__label blko-ui-text--label">{{ s.choose_label | escape }}</p
        ><ul class="bbackinstock03__list"
          >{%- for r in rows -%}
            {%- liquid
              if live
                assign key = r.id
                assign out = true
                if r.available
                  assign out = false
                endif
                if item.options.size == 1
                  assign size = r.option1
                else
                  assign size = r.title
                endif
                assign note = r.metafields.custom.size_note.value
                assign waiting = r.metafields.custom.waitlist_count.value | default: 0
                assign left = nil
                if r.inventory_management == 'shopify' and r.inventory_policy == 'deny'
                  assign left = r.inventory_quantity
                endif
                assign attrs = ''
              else
                assign key = 'preview-' | append: forloop.index
                assign size = r.settings.title
                assign note = r.settings.note
                assign waiting = r.settings.waiting | default: 0
                assign left = r.settings.stock
                assign out = false
                if left == 0
                  assign out = true
                endif
                assign attrs = r.shopify_attributes
              endif
              assign low = false
              if out == false and left != nil
                if left > 0 and left <= s.low_stock
                  assign low = true
                endif
              endif
              assign open = false
              if out and live == false and use_app == false and size == s.open_size
                assign open = true
              endif
              assign fid = uid | append: '-' | append: forloop.index
            -%}
            <li class="bbackinstock03__item" style="--i:{{ forloop.index0 }}" {{ attrs }} data-row data-key="{{ key }}" data-size="{{ size | escape }}"{% if out %} data-out{% endif %}
              ><div class="bbackinstock03__line"
                ><span class="bbackinstock03__size blko-ui-text--h3">{{ size | escape }}</span
                ><span class="bbackinstock03__info"
                  >{%- if note != blank -%}<span class="bbackinstock03__note">{{ note | escape }}</span>{%- endif -%}
                  {%- if out -%}
                    <span><span class="bbackinstock03__strong">{{ s.sold_label | escape }}</span>{%- if waiting > 0 -%}, <span class="bbackinstock03__num" data-waiting="{{ waiting }}">{{ s.waiting_text | replace: '[n]', waiting | escape }}</span>{%- endif -%}</span
                  >{%- elsif low -%}
                    <span class="bbackinstock03__low"><span class="bbackinstock03__dot" aria-hidden="true"></span>{{ s.low_text | replace: '[n]', left | escape }}</span
                  >{%- else -%}
                    <span>{{ s.in_stock_label | escape }}</span
                  >{%- endif -%}
                </span
                >{%- if out -%}
                  {%- unless use_app -%}
                    <button type="button" class="bbackinstock03__bell" aria-pressed="false" aria-expanded="{% if open %}true{% else %}false{% endif %}" aria-controls="{{ fid }}" aria-label="{{ s.bell_aria | replace: '[size]', size | escape }}" data-bell>{% render 'blko-ui-icon', name: 'bell', size: 16, className: 'bbackinstock03__i-off' %}{% render 'blko-ui-icon', name: 'bell-ring', size: 16, className: 'bbackinstock03__i-on' %}<span data-bell-label>{{ s.notify_label | escape }}</span></button
                  >{%- endunless -%}
                {%- else -%}
                  <button type="button" class="bbackinstock03__add" data-add data-id="{% if live %}{{ r.id }}{% endif %}">{% render 'blko-ui-icon', name: 'plus', size: 16, className: 'bbackinstock03__i-off' %}{% render 'blko-ui-icon', name: 'check', size: 16, className: 'bbackinstock03__i-on' %}<span data-add-label>{{ s.add_label | escape }}</span></button
                >{%- endif -%}
              </div
              >{%- if out and use_app == false -%}
                {%- assign ffid = fid | append: '-f' -%}
                <div class="bbackinstock03__formwrap" id="{{ fid }}" data-form{% unless open %} hidden{% endunless %}
                >{%- form 'contact', id: ffid, class: 'bbackinstock03__form', novalidate: 'novalidate' -%}
                  {%- assign em = fid | append: '-em' -%}
                  {%- assign er = fid | append: '-err' -%}
                  <label for="{{ em }}" class="bbackinstock03__ask">{{ s.form_label | replace: '[size]', size | escape }}</label
                  ><div class="bbackinstock03__pair"
                    >{%- render 'blko-ui-input', id: em, type: 'email', name: 'contact[email]', autocomplete: 'email', placeholder: s.email_placeholder, describedBy: er -%}
                    <button type="submit" class="bbackinstock03__save">{{ s.save_label | escape }}</button
                  ></div
                  ><input type="hidden" name="contact[body]" value="{{ s.request_text | replace: '[product]', title | replace: '[variant]', size | escape }}"
                  ><p id="{{ er }}" role="alert" class="bbackinstock03__error" data-error hidden><span class="bbackinstock03__dot" aria-hidden="true"></span><span data-error-text>{{ s.email_error | escape }}</span></p
                >{%- endform -%}
                </div
              >{%- endif -%}
            </li
          >{%- endfor -%}
        </ul
        >{%- if use_app -%}
          <div class="bbackinstock03__app">{%- for block in apps -%}{% render block %}{%- endfor -%}</div
        >{%- endif -%}
        <p class="bbackinstock03__foot" aria-live="polite" data-foot>{{ s.foot_note | escape }}</p
        ><p class="blko-ui-sr-only" role="status" data-status></p
      ></div
    ></div
  ></section
></div

>

{% schema %}
{
  "name": "Notify 03 - Size bells",
  "tag": "div",
  "max_blocks": 13,
  "settings": [
    {
      "type": "header",
      "content": "Product"
