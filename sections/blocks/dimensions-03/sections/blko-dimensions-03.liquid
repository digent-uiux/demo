{%- liquid
  assign s = section.settings
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-dimensions-03.css' | asset_url | stylesheet_tag }}
<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-dimensions-03.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-plush', tokens: s.tokens -%}
{%- comment -%}
  Dimensions 03 (plush): a large sofa photo beside the display heading and the access check; then every size block as a
  row: top-view outline to one shared scale, name and seats, four figures, the door verdict, the price and "Choose this
  size" (links to the matching variant when a product is set, else a pressed toggle).
  Motion (html.blko-ui-motion only; static = final frame): the photo unclips from the left and the outlines draw row by row.
{%- endcomment -%}
{%- liquid
  assign alt = s.image_alt | default: s.image.alt
  assign door_w = s.door_width | at_least: 1
  assign door_h = s.door_height | at_least: 1
  assign p = s.product
-%}
{%- capture content -%}
<div class="bdimensions03__wrap" data-d3
  ><div class="bdimensions03__top"
    ><div class="bdimensions03__photo" data-d3-photo
      >{%- if s.image != blank -%}
        {{ s.image | image_url: width: 1600 | image_tag: alt: alt, loading: 'lazy', class: 'bdimensions03__img', widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 58vw, 100vw' -}}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'bdimensions03__img' -}}
      {%- endif -%}
    </div
    ><div class="bdimensions03__side"
    ><header class="bdimensions03__head"
      ><h2 class="bdimensions03__h">{{ s.heading | escape }}</h2
      >{%- if s.lead != blank -%}<p class="bdimensions03__muted blko-ui-text--body">{{ s.lead | escape }}</p>{%- endif -%}
    </header
    ><form class="bdimensions03__form" aria-label="{{ s.form_label | escape }}" onsubmit="return false" novalidate
      ><div class="bdimensions03__form-top"
        ><p class="bdimensions03__form-title blko-ui-text--small">{{ s.form_title | escape }}</p
        ><button type="button" class="bdimensions03__flip blko-ui-text--small" data-flip>{{ s.show_in | escape }}</button
      ></div
      ><div class="bdimensions03__fields"
        ><label for="bdimensions03-{{ section.id }}-w" class="bdimensions03__field blko-ui-text--small"
          ><span class="bdimensions03__muted">{{ s.door_width_label | escape }}</span
          ><span class="bdimensions03__input-wrap"><input id="bdimensions03-{{ section.id }}-w" inputmode="decimal" autocomplete="off" value="{{ door_w }}" data-in="w"><span class="bdimensions03__suffix bdimensions03__muted" data-u>cm</span></span
        ></label
        ><label for="bdimensions03-{{ section.id }}-h" class="bdimensions03__field blko-ui-text--small"
          ><span class="bdimensions03__muted">{{ s.door_height_label | escape }}</span
          ><span class="bdimensions03__input-wrap"><input id="bdimensions03-{{ section.id }}-h" inputmode="decimal" autocomplete="off" value="{{ door_h }}" data-in="h"><span class="bdimensions03__suffix bdimensions03__muted" data-u>cm</span></span
        ></label
        ><label for="bdimensions03-{{ section.id }}-hall" class="bdimensions03__field bdimensions03__hall bdimensions03__hall--off blko-ui-text--small" data-hall
          ><span class="bdimensions03__hall-row bdimensions03__muted"><input type="checkbox" class="bdimensions03__cb" aria-label="{{ s.turn_label | escape }}" data-turn>{{ s.hall_label | escape }}</span
          ><span class="bdimensions03__input-wrap"><input id="bdimensions03-{{ section.id }}-hall" inputmode="decimal" autocomplete="off" value="{{ s.hall_width }}" disabled data-in="hall"><span class="bdimensions03__suffix bdimensions03__muted" data-u>cm</span></span
        ></label
      ></div
    ></form
    ></div
  ></div

  ><div class="bdimensions03__table"
    ><div class="bdimensions03__thead blko-ui-text--label" aria-hidden="true"
      ><span>{{ s.col_view | escape }}</span><span>{{ s.col_size | escape }}</span><span>{{ s.col_width | escape }}</span><span>{{ s.col_depth | escape }}</span><span>{{ s.col_height | escape }}</span><span>{{ s.col_seat | escape }}</span><span>{{ s.col_door | escape }}</span><span class="bdimensions03__th-buy">{{ s.col_price | escape }}</span
    ></div
    ><ul class="bdimensions03__rows" aria-live="polite"
      >{%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign w = b.width | at_least: 1
          assign d = b.depth | at_least: 1
          assign h = b.height | at_least: 1
          assign legs = b.legs | at_least: 0
          assign part = b.part | default: 0
          assign price = b.price
          assign row_href = ''
          if p != blank
            for v in p.variants
              if v.title == b.name or v.options contains b.name
                assign price = v.price | money
                assign row_href = p.url | append: '?variant=' | append: v.id
                break
              endif
            endfor
          endif
          assign r = forloop.index0
          assign on = false
          if forloop.index == 3
            assign on = true
          endif
          assign deep = d
          if b.shape == 'corner' or b.shape == 'chaise'
            assign deep = 92
          endif
          assign x0 = 280 | minus: w | divided_by: 2.0
          assign in_w = w | minus: 32
          assign in_d = deep | minus: 24
          assign thin = d
          if h < thin
            assign thin = h
          endif
          assign h_nolegs = h | minus: legs
          assign thin_nl = d
          if h_nolegs < thin_nl
            assign thin_nl = h_nolegs
          endif
          assign big = d
          if h > big
            assign big = h
          endif
          assign need_ok = thin | plus: 2
          assign need_nl = thin_nl | plus: 2
          assign tone = 'ok'
          if big > door_h
            assign tone = 'no'
            assign verdict = s.v_tall
          elsif need_ok <= door_w
            assign verdict = s.v_side
          elsif need_nl <= door_w
            assign tone = 'warn'
            assign verdict = s.v_legs
          else
            assign tone = 'no'
            assign nv = need_nl | append: ' cm'
            assign verdict = s.v_need | replace: '[value]', nv
          endif
          if part > 0 and tone != 'no'
            assign tone = 'warn'
            assign verdict = s.v_parts | replace: '[verdict]', verdict
          endif
          assign nm = b.name | downcase
          assign sil = s.sil_label | replace: '[name]', nm | replace: '[width]', w | replace: '[depth]', d
        -%}
        <li class="bdimensions03__row{% if on %} bdimensions03__row--on{% endif %}" data-row data-w="{{ w }}" data-d="{{ d }}" data-h="{{ h }}" data-legs="{{ legs }}" data-part="{{ part }}" {{ block.shopify_attributes }}
          ><div class="bdimensions03__sil"
            ><svg viewBox="0 0 280 215" style="--r:{{ r }}" role="img" aria-label="{{ sil | escape }}"
              ><g class="bdimensions03__sil-outer" stroke-width="1.5"
                ><rect pathLength="1" data-d3-draw x="{{ x0 }}" y="4" width="{{ w }}" height="{{ deep }}" rx="8"
                />{%- if b.shape == 'chaise' -%}<rect pathLength="1" data-d3-draw x="{{ x0 | plus: w | minus: 92 }}" y="4" width="92" height="{{ d }}" rx="8"/>{%- endif -%}
                {%- if b.shape == 'corner' -%}<rect pathLength="1" data-d3-draw x="{{ x0 }}" y="4" width="98" height="{{ d }}" rx="8"/>{%- endif -%}
              </g
              ><g class="bdimensions03__sil-inner" stroke-width="1"
                ><rect pathLength="1" data-d3-draw style="--k:1" x="{{ x0 | plus: 16 }}" y="22" width="{{ in_w | at_least: 0 }}" height="{{ in_d | at_least: 0 }}" rx="4"
                />{%- if b.shape == 'chaise' -%}<rect pathLength="1" data-d3-draw style="--k:1" x="{{ x0 | plus: w | minus: 88 }}" y="22" width="72" height="{{ d | minus: 26 | at_least: 0 }}" rx="4"/>{%- endif -%}
                {%- if b.shape == 'corner' -%}<rect pathLength="1" data-d3-draw style="--k:1" x="{{ x0 | plus: 18 }}" y="22" width="76" height="{{ d | minus: 34 | at_least: 0 }}" rx="4"/>{%- endif -%}
              </g
            ></svg
          ></div
          ><div class="bdimensions03__name"
            ><span class="bdimensions03__name-t blko-ui-text--h4">{{ b.name | escape }}</span
            ><span class="bdimensions03__muted blko-ui-text--small">{{ b.seats | escape }}</span
            >{%- if price != blank -%}<span class="bdimensions03__price bdimensions03__price--sm blko-ui-text--body">{{ price }}</span>{%- endif -%}
          </div
          ><dl class="bdimensions03__dims blko-ui-text--small"
            ><div><dt class="bdimensions03__muted blko-ui-text--label">{{ s.col_width | escape }}</dt><dd class="bdimensions03__nw"><span data-cm="{{ w }}">{{ w }}</span><span class="bdimensions03__muted"> <span data-u>cm</span></span></dd></div
            ><div><dt class="bdimensions03__muted blko-ui-text--label">{{ s.col_depth | escape }}</dt><dd class="bdimensions03__nw"><span data-cm="{{ d }}">{{ d }}</span><span class="bdimensions03__muted"> <span data-u>cm</span></span></dd></div
            ><div><dt class="bdimensions03__muted blko-ui-text--label">{{ s.col_height | escape }}</dt><dd class="bdimensions03__nw"><span data-cm="{{ h }}">{{ h }}</span><span class="bdimensions03__muted"> <span data-u>cm</span></span></dd></div
            ><div><dt class="bdimensions03__muted blko-ui-text--label">{{ s.col_seat | escape }}</dt><dd class="bdimensions03__nw"><span data-cm="{{ b.seat }}">{{ b.seat }}</span><span class="bdimensions03__muted"> <span data-u>cm</span></span></dd></div
          ></dl
          ><p class="bdimensions03__verdict blko-ui-text--small" data-tone="{{ tone }}" data-verdict
            >{%- render 'blko-ui-icon', name: 'check', size: 16, className: 'bdimensions03__i-ok' -%}
            {%- render 'blko-ui-icon', name: 'triangle-alert', size: 16, className: 'bdimensions03__i-warn' -%}
            {%- render 'blko-ui-icon', name: 'x', size: 16, className: 'bdimensions03__i-no' -%}
            <span data-text>{{ verdict | escape }}</span
          ></p
          ><div class="bdimensions03__buy"
            >{%- if price != blank -%}<span class="bdimensions03__price bdimensions03__price--lg blko-ui-text--body">{{ price }}</span>{%- endif -%}
            {%- if row_href != '' -%}
              {% render 'blko-ui-button', href: row_href, variant: 'outline', size: 'sm', children: s.choose_label, className: 'bdimensions03__choose' -%}
            {%- elsif on -%}
              {% render 'blko-ui-button', size: 'sm', children: s.chosen_label, className: 'bdimensions03__choose', attrs: 'aria-pressed="true" data-choose' -%}
            {%- else -%}
              {% render 'blko-ui-button', variant: 'outline', size: 'sm', children: s.choose_label, className: 'bdimensions03__choose', attrs: 'aria-pressed="false" data-choose' -%}
            {%- endif -%}
          </div
        ></li
      >{%- endfor -%}
    </ul
  ></div
></div
>{%- endcapture -%}
<div class="bdimensions03" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-bdimensions03 data-show-in="{{ s.show_in | escape }}" data-choose-label="{{ s.choose_label | escape }}" data-chosen-label="{{ s.chosen_label | escape }}" data-show-cm="{{ s.show_cm | escape }}" data-empty="{{ s.v_empty | escape }}" data-side="{{ s.v_side | escape }}" data-legs="{{ s.v_legs | escape }}" data-need="{{ s.v_need | escape }}" data-tall="{{ s.v_tall | escape }}" data-turn-msg="{{ s.v_turn | escape }}" data-parts="{{ s.v_parts | escape }}">{% render 'blko-ui-section', surface: 'bg', label: s.label, className: 'bdimensions03__section', children: content %}</div
>

{% schema %}
{
  "name": "Dimensions 03 - Sizes",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product photo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo alt text",
      "info": "Leave blank to use the image's own alt text."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your size, check the door"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Intro",
      "default": "Six sizes on the same frame and the same deep seat. Type your door in and every size tells you how it gets home."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Optional. Each size row then shows the live price of the variant whose name or option matches the row name."
    },
    {
      "type": "header",
      "content": "Access check"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Title",
      "default": "Will it get in?"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Form name for screen readers",
      "default": "Access check"
    },
    {
      "type": "text",
      "id": "show_in",
      "label": "Switch to inches",
      "default": "Show inches"
    },
    {
      "type": "text",
      "id": "show_cm",
      "label": "Switch to cm",
      "default": "Show cm"
    },
    {
      "type": "text",
      "id": "door_width_label",
      "label": "Door width field",
      "default": "Door width"
    },
    {
      "type": "text",
      "id": "door_height_label",
      "label": "Door height field",
      "default": "Door height"
    },
    {
      "type": "text",
      "id": "hall_label",
      "label": "Hall field",
      "default": "Hall at a turn"
    },
    {
      "type": "text",
      "id": "turn_label",
      "label": "Turn checkbox for screen readers",
      "default": "There is a turn straight after the door"
    },
    {
      "type": "number",
      "id": "door_width",
      "label": "Example door width (cm)",
      "default": 80
    },
    {
      "type": "number",
      "id": "door_height",
      "label": "Example door height (cm)",
      "default": 200
    },
    {
      "type": "number",
      "id": "hall_width",
      "label": "Example hall width (cm)",
      "default": 95
    },
    {
      "type": "header",
      "content": "Table"
    },
    {
      "type": "text",
      "id": "col_view",
      "label": "Column 1",
      "default": "Top view"
    },
    {
      "type": "text",
      "id": "col_size",
      "label": "Column 2",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "col_width",
      "label": "Column 3",
      "default": "Width"
    },
    {
      "type": "text",
      "id": "col_depth",
      "label": "Column 4",
      "default": "Depth"
    },
    {
      "type": "text",
      "id": "col_height",
      "label": "Column 5",
      "default": "Height"
    },
    {
      "type": "text",
      "id": "col_seat",
      "label": "Column 6",
      "default": "Seat"
    },
    {
      "type": "text",
      "id": "col_door",
      "label": "Column 7",
      "default": "Through the door"
    },
    {
      "type": "text",
      "id": "col_price",
      "label": "Column 8",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "choose_label",
      "label": "Choose button",
      "default": "Choose this size",
      "info": "With a product, it opens the matching variant."
    },
    {
      "type": "text",
      "id": "chosen_label",
      "label": "Chosen button",
      "default": "Chosen"
    },
    {
      "type": "text",
      "id": "sil_label",
      "label": "Top view description",
      "default": "Top view of the [name], [width] by [depth] cm",
      "info": "For screen readers."
    },
    {
      "type": "header",
      "content": "Verdicts"
    },
    {
      "type": "text",
      "id": "v_empty",
      "label": "No door size yet",
      "default": "Add your door size"
    },
    {
      "type": "text",
      "id": "v_side",
      "label": "Fits on its side",
      "default": "Goes in on its side"
    },
    {
      "type": "text",
      "id": "v_legs",
      "label": "Fits without legs",
      "default": "Fits with the legs unscrewed"
    },
    {
      "type": "text",
      "id": "v_need",
      "label": "Door too narrow",
      "default": "Needs a [value] door",
      "info": "[value] is the door width it needs."
    },
    {
      "type": "text",
      "id": "v_tall",
      "label": "Door too low",
      "default": "Too tall for the door on its side"
    },
    {
      "type": "text",
      "id": "v_turn",
      "label": "Too long for the turn",
      "default": "Will not make the turn (max [value])",
      "info": "[value] is the longest piece that makes the turn."
    },
    {
      "type": "text",
      "id": "v_parts",
      "label": "Comes in two parts",
      "default": "[verdict], in two parts",
      "info": "[verdict] is one of the verdicts above."
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section name for screen readers",
      "default": "Sizes and access"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Plush)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Size name",
          "default": "Three-seater",
          "info": "Match a variant or option value of the product to show its live price."
        },
        {
          "type": "text",
          "id": "seats",
          "label": "Seats",
          "default": "3 seats"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$2,690",
          "info": "Used when no product is picked or no variant matches."
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Top view shape",
          "default": "sofa",
          "options": [
            {
              "value": "chair",
              "label": "Armchair"
            },
            {
              "value": "sofa",
              "label": "Sofa"
            },
            {
              "value": "chaise",
              "label": "Sofa with chaise"
            },
            {
              "value": "corner",
              "label": "Corner sofa"
            }
          ]
        },
        {
          "type": "number",
          "id": "width",
          "label": "Width (cm)",
          "default": 220
        },
        {
          "type": "number",
          "id": "depth",
          "label": "Depth (cm)",
          "default": 92
        },
        {
          "type": "number",
          "id": "height",
          "label": "Height (cm)",
          "default": 78
        },
        {
          "type": "number",
          "id": "seat",
          "label": "Seat height (cm)",
          "default": 45
        },
        {
          "type": "number",
          "id": "legs",
