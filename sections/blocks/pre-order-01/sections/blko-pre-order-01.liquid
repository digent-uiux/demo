      "id": "detail_image",
      "label": "Close-up photo",
      "info": "Used when the product has one image. Empty: a close crop of the main photo."
    },
    {
      "type": "text",
      "id": "detail_alt",
      "label": "Close-up crop alt text",
      "default": "Close-up of the coat's tie belt"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section name for screen readers",
      "default": "Pre-order the wrap coat"
    },
    {
      "type": "header",
      "content": "No product on a live store"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Preview (Theme Editor, no product)"
    },
    {
      "type": "text",
      "id": "preview_title",
      "label": "Title",
      "default": "Belted wrap coat"
    },
    {
      "type": "number",
      "id": "preview_price",
      "label": "Price",
      "default": 420
    },
    {
      "type": "text",
      "id": "colour_label",
      "label": "Colour label",
      "default": "Colour"
    },
    {
      "type": "text",
      "id": "preview_colours",
      "label": "Colours",
      "default": "Brick:#9c3b25, Oat:#d9cbb4, Ink:#1f2328",
      "info": "Name:#hex, comma separated"
    },
    {
      "type": "text",
      "id": "preview_colour",
      "label": "Picked colour",
      "default": "Brick"
    },
    {
      "type": "text",
      "id": "size_label",
      "label": "Size label",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "preview_sizes",
      "label": "Sizes",
      "default": "XS, S, M, L, XL"
    },
    {
      "type": "text",
      "id": "preview_size",
      "label": "Picked size",
      "default": "M"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Seam)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
