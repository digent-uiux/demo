{%- comment -%}
  Footer 02, "Serif newsletter, soft" (registry/footer/footer-02.tsx).
  A soft pastel band split in two: a large serif sign-up (offer line, one sentence, email + button, privacy note) on the
  left, three compact link columns on the right; then a quiet row with the copyright and the legal links.
  Real: the sign-up posts Shopify's customer form, each column reads its menu, the legal row reads its menu.
  Empty menus show the demo links.
  Theme-neutral: colours and fonts come from the DS tokens, with the DS default look as fallback.
{%- endcomment -%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-ui-commerce.css' | asset_url | stylesheet_tag }}
{{ 'blko-footer-02.css' | asset_url | stylesheet_tag }}
{%- render 'blko-ui-fonts' -%}

{%- liquid
  assign s = section.settings
  assign uid = 'blko-ft02-' | append: section.id
  assign brand = s.brand | default: shop.name
  assign legal_menu = linklists[s.legal_menu]
  assign legal_demo = s.legal_demo | split: ','
  assign email_id = uid | append: '-email'
-%}
<footer class="blko-ft02" style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;">
  <div class="blko-ft02__main">
    {%- form 'customer', id: uid, class: 'blko-ft02__form' -%}
      <h2 class="blko-ft02__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="blko-ft02__muted blko-ft02__lead">{{ s.text | escape }}</p>{%- endif -%}
      {%- if form.posted_successfully? -%}
        <p role="status" class="blko-ft02__lead">{{ s.success_text | escape }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="blko-ft02__row">
          <label for="{{ email_id }}" class="blko-ui-sr-only">{{ s.email_label | escape }}</label>
          {%- render 'blko-ui-input', id: email_id, name: 'contact[email]', type: 'email', required: true, autocomplete: 'email', placeholder: s.email_placeholder, className: 'blko-ft02__input' -%}
          {%- capture sub -%}{{ s.button_label | escape }}{%- endcapture -%}
          {%- render 'blko-ui-button', type: 'submit', className: 'blko-ft02__submit', children: sub -%}
        </div>
        {%- if form.errors -%}<p class="blko-ft02__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
      {%- if s.privacy_text != blank -%}
        <p class="blko-ft02__note">{{ s.privacy_text }}</p>
      {%- endif -%}
    {%- endform -%}

    <div class="blko-ft02__cols">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign m = linklists[b.menu] -%}
        <nav aria-label="{{ b.title | escape }}" class="blko-ft02__col" {{ block.shopify_attributes }}>
          <p class="blko-ft02__label">{{ b.title | escape }}</p>
          <ul class="blko-ft02__links" role="list">
            {%- if m != blank and m.links.size > 0 -%}
              {%- for l in m.links -%}
                <li><a href="{{ l.url }}" class="blko-ft02__link">{{ l.title | escape }}{% render 'blko-footer-02-icon', name: 'arrow-up-right', size: 12, class: 'blko-ft02__arrow' %}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- assign demo = b.demo_links | split: ',' -%}
              {%- for l in demo -%}
                <li><a href="{{ routes.all_products_collection_url }}" class="blko-ft02__link">{{ l | strip | escape }}{% render 'blko-footer-02-icon', name: 'arrow-up-right', size: 12, class: 'blko-ft02__arrow' %}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </nav>
      {%- endfor -%}
    </div>
  </div>

  <div class="blko-ft02__legal">
    <div class="blko-ft02__legal-in">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ brand | escape }}</span>
      <nav aria-label="{{ s.legal_label | escape }}" class="blko-ft02__legal-nav">
        {%- if legal_menu != blank and legal_menu.links.size > 0 -%}
          {%- for l in legal_menu.links -%}<a href="{{ l.url }}">{{ l.title | escape }}</a>{%- endfor -%}
        {%- else -%}
          {%- for l in legal_demo -%}<a href="{{ routes.root_url }}policies">{{ l | strip | escape }}</a>{%- endfor -%}
        {%- endif -%}
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer, serif newsletter",
  "tag": "div",
  "class": "blko-section-ft02",
  "settings": [
    { "type": "text", "id": "brand", "label": "Copyright name (blank = store name)", "default": "Lumen Goods" },
    { "type": "header", "content": "Sign-up" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading (italic part in <em>)", "default": "Get 10% off your <em>first</em> order." },
    { "type": "text", "id": "text", "label": "Line", "default": "New launches, restocks and skin notes. One email a week, never more." },
    { "type": "text", "id": "email_label", "label": "Email label (screen readers)", "default": "Email address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_text", "label": "Thank-you message", "default": "Thank you. Your code is on its way to your inbox." },
    { "type": "inline_richtext", "id": "privacy_text", "label": "Privacy note", "default": "By subscribing you agree to our <a href=\"/policies/privacy-policy\">Privacy Policy</a>." },
    { "type": "header", "content": "Legal row" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu" },
    { "type": "text", "id": "legal_demo", "label": "Demo legal links (shown while the menu is empty)", "default": "Privacy, Terms, Cookies, Accessibility" },
    { "type": "text", "id": "legal_label", "label": "Legal label (screen readers)", "default": "Legal" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "demo_links", "label": "Demo links (shown while the menu is empty)", "default": "New in, Skincare, Makeup, Body & hair" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer, serif newsletter",
      "blocks": [
        { "type": "menu", "settings": { "title": "Shop", "demo_links": "New in, Skincare, Makeup, Body & hair" } },
        { "type": "menu", "settings": { "title": "Help", "demo_links": "Contact us, Shipping, Returns, Track order" } },
        { "type": "menu", "settings": { "title": "About", "demo_links": "Our story, Ingredients, Journal" } }
      ]
    }
  ]
}
{% endschema %}
