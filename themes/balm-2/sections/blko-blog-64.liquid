      "info": "Repaints the section with a scheme from Theme settings > Colors. Works when Colors, fonts, corners reads the theme's tokens.",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story (preview)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "topic",
          "label": "Tag",
          "default": "Rituals"
        },
        {
          "type": "number",
          "id": "number",
          "label": "Card number",
          "default": 14
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "Oct 12, 2026"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A slow evening balm cleanse"
        },
        {
          "type": "textarea",
          "id": "dek",
          "label": "Line",
          "default": "Melt, massage, lift with warm muslin: the five-minute end to a long day."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Catalogue drawer stories",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "topic": "Rituals",
            "number": 14,
            "date": "Oct 12, 2026",
            "title": "A slow evening balm cleanse",
            "dek": "Melt, massage, lift with warm muslin: the five-minute end to a long day."
          }
