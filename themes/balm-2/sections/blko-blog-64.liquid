{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-blog-64.css' | asset_url | stylesheet_tag }}
<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-blog-64.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-balm', tokens: s.tokens -%}
{%- comment -%}
  More from the journal, balm: the card-catalogue drawer. Left (3 of 12 columns): a small-caps label, the h2 as a combo ("Keep" in
  Karla 300, "reading" in didone italic), one line and an "All stories" link. Right (9 columns): three library index cards stand up out of an
  open drawer at different heights; the drawer front (pop-2 linen, brass label holder, finger pull) covers their feet.
  Each card: an amber call number (first 3 letters of the first tag + sheet number) and the date on an amber head rule,
  a 3:2 photo, a Karla title, one line, ruled blank lines and the punched rod hole. The first card is the "Next read".
  Live: the newest articles of the picked blog (else the current blog), skipping the article being read; with no
  articles the story blocks show (theme-editor preview). Phones: cards stack, indented a step each, the drawer a slim
  band under the last. Motion (balm kit flag, two-up and wider): the cards rise out of the drawer once (script.js).
{%- endcomment -%}
{{ 'blko-balm-motion.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'blko-balm-motion.js' | asset_url }}" defer="defer"></script
>{%- liquid
  assign src = s.blog
  if src == blank and blog != blank
    assign src = blog
  endif
  assign live = false
  if src != blank and src.articles_count > 0
    assign live = true
  endif
  assign more_url = s.link_url
  if more_url == blank
    if src != blank
      assign more_url = src.url
    else
      assign more_url = routes.root_url
    endif
  endif
-%}
{%- capture cards -%}
  {%- assign n = 0 -%}
  {%- if live -%}
    {%- for a in src.articles -%}
      {%- if article != blank and a.id == article.id -%}{%- continue -%}{%- endif -%}
      {%- if n >= s.count -%}{%- break -%}{%- endif -%}
      {%- assign n = n | plus: 1 -%}
      {%- assign num = src.articles_count | minus: forloop.index0 -%}
      {%- assign dek = a.excerpt | default: a.content | strip_html | truncatewords: 14 -%}
      {%- capture dt -%}{{ a.published_at | time_tag: '%b %-d, %Y' }}{%- endcapture -%}
      {%- render 'blko-blog-64-card', i: n, url: a.url, title: a.title, dek: dek, tag: a.tags.first, num: num, date: dt, image: a.image -%}
    {%- endfor -%}
  {%- else -%}
    {%- for b in section.blocks -%}
      {%- assign n = n | plus: 1 -%}
      {%- assign bs = b.settings -%}
      {%- render 'blko-blog-64-card', i: n, url: bs.link, fallback: more_url, title: bs.title, dek: bs.dek, tag: bs.topic, num: bs.number, date: bs.date, image: bs.image, attrs: b.shopify_attributes -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- capture body -%}
  <div class="bblog64__wrap"
    ><header class="bblog64__head"
      >{%- if s.eyebrow != blank -%}<p class="bblog64__cap bblog64__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="bblog64__h2">{% if s.heading != blank %}<span class="bblog64__plain">{{ s.heading | escape }}</span>{% endif %}{% if s.heading_em != blank %} <em>{{ s.heading_em | escape }}</em>{% endif %}</h2
      >{%- if s.text != blank -%}<p class="bblog64__lead">{{ s.text | escape }}</p>{%- endif -%}
      {%- if s.link_label != blank -%}<a href="{{ more_url }}" class="bblog64__more">{{ s.link_label | escape }}{% render 'blko-ui-icon', name: 'arrow-up-right', size: 16, stroke: 2 %}</a>{%- endif -%}
    </header
    ><div class="bblog64__drawer" data-drawer
      ><ul class="bblog64__list">{{ cards }}</ul
      ><div aria-hidden="true" class="bblog64__front"
        ><div class="bblog64__fin"
          >{%- if s.drawer_label != blank -%}<span class="bblog64__cap bblog64__holder">{{ s.drawer_label | escape }}</span>{%- endif -%}
          <span class="bblog64__pull"></span
        ></div
      ></div
    ></div
  ></div
>{%- endcapture -%}
<div class="bblog64{%- if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
  >{%- render 'blko-ui-section', surface: 'bg', bleed: true, label: s.label, className: 'bblog64__section', inner: 'bblog64__inner', children: body -%}
</div

>

{% schema %}
{
  "name": "Catalogue drawer stories",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Region label",
      "default": "More from the journal"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "More from the journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading, light word",
      "default": "Keep"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Heading, italic word",
      "default": "reading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Filed under the same drawer: three notes to read next, pulled by the bench."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link",
      "default": "All stories"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "info": "Blank links to the blog."
    },
    {
      "type": "text",
      "id": "drawer_label",
      "label": "Drawer label",
      "default": "Journal · Drawer 12"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Blank uses the blog being read. With no articles the story blocks show."
    },
    {
      "type": "range",
      "id": "count",
      "label": "Cards",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Balm)"
