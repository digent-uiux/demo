{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-reviews-49.css' | asset_url | stylesheet_tag }}
<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
{{ 'blko-ui-commerce.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-ui-commerce.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-reviews-49.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-balm', tokens: s.tokens -%}
{%- comment -%}
  Balm "notes by skin": the product's reviews kept like batch notes. Head: eyebrow ([product] = the title), the h2 (its
  <em> words in the light body face), a lead. A hairline, then square skin chips with their note counts (one chip per
  skin type found in the review blocks, plus All). Left (sticky from 768px): the reading for the chosen skin, a big
  display average beside "out of 5", stars, the count, a five-to-one breakdown on hairlines (the leading row in the
  accent) and Write a review. Right: the notes, each with a stamp column (accent lot code, weeks of use, skin), stars,
  title, text, an optional customer photo and name · verified · date; Show more + "N of M notes".
  Live: All reads the product's reviews metafields (reviews.rating / reviews.rating_count, filled by review apps) and
  then hides the preview bars. A review app block (@app) takes the list (the chips hide); the reading stays.
  The chips filter the review blocks and recompute the reading from them (script.js). Motion (balm kit on only): a pick
  racks focus: the average pulls sharp and the notes blur in one after another. Static = the final frame.
{%- endcomment -%}
{%- liquid
  assign uid = 'rv49-' | append: section.id
  assign apps = section.blocks | where: 'type', '@app'
  assign revs = section.blocks | where: 'type', 'review'
  assign live = false
  assign avg = s.average
  assign count = s.count
  if product != blank and product.metafields.reviews.rating.value != blank
    assign live = true
    assign avg = product.metafields.reviews.rating.value.rating | times: 1.0
    assign count = product.metafields.reviews.rating_count.value | default: 0
  endif
  assign pname = product.title | default: s.product_name
  assign eyebrow = s.eyebrow | replace: '[product]', pname
  assign avg_s = avg | round: 1 | append: ''
  unless avg_s contains '.'
    assign avg_s = avg_s | append: '.0'
  endunless
  assign bars = s.bars | split: ','
  assign bar_total = 0
  assign bar_top = 0
  for b in bars
    assign n = b | strip | plus: 0
    assign bar_total = bar_total | plus: n
    if n > bar_top
      assign bar_top = n
    endif
  endfor
  assign skins = '|'
  for b in revs
    assign k = b.settings.skin | strip
    assign key = '|' | append: k | append: '|'
    if k != blank
      unless skins contains key
        assign skins = skins | append: k | append: '|'
      endunless
    endif
  endfor
  assign skins = skins | remove_first: '|' | split: '|'
  assign write = s.write_link
  if write == blank and apps.size > 0
    assign write = '#' | append: uid | append: '-app'
  endif
  if write == blank and live == false
    assign write = '#' | append: uid | append: '-sum'
  endif
  assign t_reviews = 'blko.reviews_49.reviews' | t
  assign t_all = 'blko.reviews_49.all_skin' | t
  assign first = revs.size
  if first > s.shown
    assign first = s.shown
  endif
-%}
{%- capture body -%}
  <div class="breviews49__head"
    >{%- if eyebrow != blank -%}<p class="breviews49__cap breviews49__muted breviews49__eyebrow"><span aria-hidden="true"></span>{{ eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="breviews49__h">{{ s.heading }}</h2>{%- endif -%}
  </div
  >{%- if s.lead != blank -%}<p class="breviews49__lead">{{ s.lead | escape }}</p>{%- endif -%}
  {%- if apps.size == 0 and skins.size > 0 -%}
    <div class="breviews49__chips"
      ><span class="breviews49__cap breviews49__muted breviews49__your">{{ 'blko.reviews_49.your_skin' | t }}</span
      ><div class="breviews49__chiprow" role="radiogroup" aria-label="{{ 'blko.reviews_49.filter' | t | escape }}"
        ><button type="button" role="radio" aria-checked="true" class="breviews49__chip" data-skin="" data-reading="{{ 'blko.reviews_49.all_reading' | t | escape }}">{{ t_all }}<span>{{ revs.size }}</span></button
        >{%- for k in skins -%}
          {%- assign n = 0 -%}
          {%- for b in revs -%}{%- assign bk = b.settings.skin | strip -%}{%- if bk == k -%}{%- assign n = n | plus: 1 -%}{%- endif -%}{%- endfor -%}
          <button type="button" role="radio" aria-checked="false" class="breviews49__chip" data-skin="{{ k | handleize }}" data-reading="{{ 'blko.reviews_49.skin_reading' | t: skin: k | downcase | escape }}">{{ k | escape }}<span>{{ n }}</span></button
        >{%- endfor -%}
      </div
    ></div
  >{%- endif -%}
  <div class="breviews49__sum" id="{{ uid }}-sum" data-sum data-avg="{{ avg_s }}" data-count="{{ count }}" data-bars="{{ s.bars | escape }}" data-t-reviews="{{ t_reviews | escape }}" data-t-note="{{ 'blko.reviews_49.note' | t | escape }}" data-t-notes="{{ 'blko.reviews_49.notes' | t | escape }}" aria-live="polite"
    ><span class="breviews49__cap breviews49__muted" data-label>{{ 'blko.reviews_49.all_reading' | t }}</span
    ><p class="breviews49__score"><span class="breviews49__num" data-pull data-avg-out>{{ avg_s }}</span><span class="breviews49__of">{{ 'blko.reviews_49.out_of' | t }}</span></p
    ><div class="breviews49__stars"
      ><span data-stars>{%- render 'blko-ui-stars', value: avg, size: 'sm' -%}</span
      ><span class="breviews49__cap breviews49__muted" data-count-out>{% render 'blko-ui-number', value: count %} {{ t_reviews }}</span
    ></div
    >{%- if live == false and bar_total > 0 -%}
      <ul class="breviews49__bars" aria-label="{{ 'blko.reviews_49.breakdown' | t | escape }}"
        >{%- for b in bars limit: 5 -%}
          {%- assign n = b | strip | plus: 0 -%}
          {%- assign w = n | times: 100.0 | divided_by: bar_total -%}
          <li class="breviews49__cap breviews49__bar"><span>{{ 6 | minus: forloop.index }} ★<span class="blko-ui-sr-only"> {{ 'blko.reviews_49.stars' | t }}</span></span><span class="breviews49__track"><span data-bar{% if n == bar_top %} class="is-top"{% endif %} style="width: {{ w }}%"></span></span><span class="breviews49__n" data-bar-n>{{ n }}</span></li
        >{%- endfor -%}
      </ul
    >{%- endif -%}
    {%- if write != blank -%}
      {%- assign wl = 'blko.reviews_49.write' | t -%}
      {%- render 'blko-ui-button', variant: 'outline', href: write, children: wl -%}
    {%- endif -%}
  </div
  ><div class="breviews49__list"
    >{%- if apps.size > 0 -%}
      <div id="{{ uid }}-app" class="breviews49__app">{%- for b in apps -%}{%- render b -%}{%- endfor -%}</div
    >{%- else -%}
      <ol class="breviews49__notes" data-shown="{{ s.shown }}"
        >{%- for b in revs -%}
          {%- assign hide = false -%}{%- if forloop.index > s.shown -%}{%- assign hide = true -%}{%- endif -%}
          {%- render 'blko-reviews-49-note', b: b, i: forloop.index0, hide: hide -%}
        {%- endfor -%}
      </ol
      ><div class="breviews49__more-row"
        >{%- if revs.size > s.shown -%}
          {%- assign ml = 'blko.reviews_49.more' | t -%}
          {%- render 'blko-ui-button', variant: 'outline', children: ml, attrs: 'data-more', className: 'breviews49__more' -%}
        {%- endif -%}
        <span class="breviews49__cap breviews49__muted" data-of data-t="{{ 'blko.reviews_49.of' | t: x: '[x]', y: '[y]' | escape }}">{{ 'blko.reviews_49.of' | t: x: first, y: revs.size }}</span
      ></div
    >{%- endif -%}
  </div
>{%- endcapture -%}
<div class="breviews49{%- if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-breviews49
  >{%- assign lbl = 'blko.reviews_49.label' | t -%}
  {%- render 'blko-ui-section', surface: 'bg', label: lbl, inner: 'breviews49__in', children: body -%}
</div

>

