{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-9'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-page-header-08.css' | asset_url | stylesheet_tag }}
<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-page-header-08.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-balm', tokens: s.tokens -%}
{%- comment -%}
  Contact opener, balm: a small-caps breadcrumb; the didone h1 (one italic word) on seven columns with the lead
  bottom-aligned on the right four; a ruled rail of four facts split by hairlines: studio address, bench hours with a
  live "Open now / Closed" line worked out in the studio's time zone (JS, settings below), email and orders line.
  Phones: h1 and lead stack, the rail is a 2 x 2 ruled grid. Entry motion: the balm kit.
{%- endcomment -%}
{{ 'blko-balm-motion.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'blko-balm-motion.js' | asset_url }}" defer="defer"></script
>{%- liquid
  assign crumb = s.crumb
  if crumb == blank and page.title != blank
    assign crumb = page.title
  endif
  assign tel = s.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}
{%- capture body -%}
  {%- if s.show_crumbs -%}
  <nav aria-label="{{ 'blko.page_header_08.breadcrumb' | t }}"
    ><ol class="bpageheader08__crumbs bpageheader08__cap"
      ><li><a href="{{ routes.root_url }}">{{ 'blko.page_header_08.home' | t }}</a></li
      ><li aria-hidden="true">—</li
      ><li aria-current="page" class="bpageheader08__here">{{ crumb | escape }}</li
    ></ol
  ></nav
  >{%- endif -%}
  <div class="bpageheader08__row"
    ><h1 class="bpageheader08__h1">{{ s.heading | escape }}{% if s.heading_em != blank %} <em>{{ s.heading_em | escape }}</em>{% endif %}</h1
    >{%- if s.text != blank -%}<p class="bpageheader08__lead">{{ s.text | escape }}</p>{%- endif -%}
  </div
  ><dl class="bpageheader08__rail"
    >{%- assign n = 0 -%}
    {%- if s.studio != blank -%}{%- assign n = n | plus: 1 -%}
    <div class="bpageheader08__fact"
      ><dt class="bpageheader08__cap bpageheader08__key"><span>0{{ n }}</span> · {{ s.studio_key | escape }}</dt
      ><dd class="bpageheader08__val">{{ s.studio | escape | newline_to_br }}</dd
    ></div
    >{%- endif -%}
    {%- if s.hours != blank -%}{%- assign n = n | plus: 1 -%}
    <div class="bpageheader08__fact"
      ><dt class="bpageheader08__cap bpageheader08__key"><span>0{{ n }}</span> · {{ s.hours_key | escape }}</dt
      ><dd class="bpageheader08__val">{{ s.hours | escape }}<span class="bpageheader08__status" data-status data-tz="{{ s.timezone | escape }}" data-open="{{ s.open_hour }}" data-close="{{ s.close_hour }}" data-days="{{ s.open_days | escape }}" data-place="{{ s.place | escape }}" data-t-open="{{ 'blko.page_header_08.open_now' | t }}" data-t-closed="{{ 'blko.page_header_08.closed' | t }}" data-t-today="{{ 'blko.page_header_08.today' | t }}" data-t-tomorrow="{{ 'blko.page_header_08.tomorrow' | t }}"></span></dd
    ></div
    >{%- endif -%}
    {%- if s.email != blank -%}{%- assign n = n | plus: 1 -%}
    <div class="bpageheader08__fact"
      ><dt class="bpageheader08__cap bpageheader08__key"><span>0{{ n }}</span> · {{ s.email_key | escape }}</dt
      ><dd class="bpageheader08__val"><a href="mailto:{{ s.email | escape }}" class="bpageheader08__link bpageheader08__mail">{{ s.email | escape }}</a></dd
    ></div
    >{%- endif -%}
    {%- if s.phone != blank -%}{%- assign n = n | plus: 1 -%}
    <div class="bpageheader08__fact"
      ><dt class="bpageheader08__cap bpageheader08__key"><span>0{{ n }}</span> · {{ s.phone_key | escape }}</dt
      ><dd class="bpageheader08__val"><a href="tel:{{ tel }}" class="bpageheader08__link">{{ s.phone | escape }}</a></dd
    ></div
    >{%- endif -%}
  </dl
>{%- endcapture -%}
<div class="bpageheader08{%- if blko_sid != 'scheme-9' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
  >{%- render 'blko-ui-section', surface: s.surface, bleed: true, label: s.label, className: 'bpageheader08__section', inner: 'bpageheader08__inner', children: body -%}
</div

>

{% schema %}
{
  "name": "Contact header, rail",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Region label",
      "default": "Page header: Write to us"
    },
    {
      "type": "checkbox",
      "id": "show_crumbs",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "crumb",
      "label": "Current page in breadcrumb",
      "default": "Contact",
      "info": "Blank uses the page title."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Write to the"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Heading, italic word",
      "default": "apothecary"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A formula, a reaction, an order gone astray: every message goes to the people who mix the jars, and one of them answers by name."
    },
    {
      "type": "header",
      "content": "Facts"
    },
    {
      "type": "text",
      "id": "studio_key",
      "label": "Studio label",
      "default": "Studio"
    },
    {
      "type": "textarea",
      "id": "studio",
      "label": "Studio address",
      "default": "18 Mill Lane\nHudson, New York"
    },
    {
      "type": "text",
      "id": "hours_key",
      "label": "Hours label",
      "default": "Bench hours"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Mon–Sat · 9:00–17:00"
    },
    {
      "type": "text",
      "id": "timezone",
      "label": "Time zone (IANA)",
      "default": "America/New_York",
      "info": "Used for the live open / closed line. Blank hides it."
    },
    {
      "type": "text",
      "id": "place",
      "label": "Place name",
      "default": "Hudson"
    },
    {
      "type": "text",
      "id": "open_days",
      "label": "Open days",
      "default": "Mon,Tue,Wed,Thu,Fri,Sat",
      "info": "Short English day names, comma separated."
    },
    {
      "type": "range",
      "id": "open_hour",
      "label": "Opens at (hour)",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "close_hour",
      "label": "Closes at (hour)",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 17
    },
    {
      "type": "text",
      "id": "email_key",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "studio@balm.example"
    },
    {
      "type": "text",
      "id": "phone_key",
      "label": "Phone label",
      "default": "Orders line"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+1 518 555 0142"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Colour",
      "options": [
        {
          "value": "alt",
          "label": "Alternate"
        },
        {
          "value": "bg",
          "label": "Background"
        },
        {
          "value": "pop-1",
          "label": "Pop 1"
        }
      ],
      "default": "alt"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Balm)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Repaints the section with a scheme from Theme settings > Colors. Works when Colors, fonts, corners reads the theme's tokens.",
      "default": "scheme-9"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Contact header, rail"
    }
  ],
  "class": "blko-bundle"
}
{% endschema %}
