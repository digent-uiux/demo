{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-page-header-09.css' | asset_url | stylesheet_tag }}
<script data-blko-ui-gate>try{if(!new URLSearchParams(location.search).has('static')&&!navigator.webdriver&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('blko-ui-load')}catch(e){}</script>
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-page-header-09.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-balm', tokens: s.tokens -%}
{%- comment -%}
  FAQ opener, balm: on one centred axis a small-caps breadcrumb, the didone h1 (one italic word), one line, then an
  underline-only search with an italic didone input and "Often asked" suggestion words. Typing lists up to four
  matching questions from the FAQ sections on the same page (any element with an id "balm-faq-<handle>" and a
  data-faq-q, e.g. faq-37) as ruled links to their anchors; the FAQ opens that answer from the hash. A live line says
  how many match; no match points to the contact link. Esc clears.
{%- endcomment -%}
{{ 'blko-balm-motion.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'blko-balm-motion.js' | asset_url }}" defer="defer"></script
>{%- liquid
  assign crumb = s.crumb
  if crumb == blank and page.title != blank
    assign crumb = page.title
  endif
  assign qid = 'ph09-q-' | append: section.id
  assign sugg = s.suggestions | split: ','
-%}
{%- capture body -%}
  <div class="bpageheader09__axis"
    >{%- if s.show_crumbs -%}
    <nav aria-label="{{ 'blko.page_header_09.breadcrumb' | t }}"
      ><ol class="bpageheader09__crumbs bpageheader09__cap"
        ><li><a href="{{ routes.root_url }}">{{ 'blko.page_header_09.home' | t }}</a></li
        ><li aria-hidden="true">—</li
        >{%- if s.parent_label != blank -%}
        <li><a href="{{ s.parent_link | default: routes.root_url }}">{{ s.parent_label | escape }}</a></li
        ><li aria-hidden="true">—</li
        >{%- endif -%}
        <li aria-current="page" class="bpageheader09__here">{{ crumb | escape }}</li
      ></ol
    ></nav
    >{%- endif -%}
    <h1 class="bpageheader09__h1">{{ s.heading | escape }}{% if s.heading_em != blank %} <em>{{ s.heading_em | escape }}</em>{% endif %}</h1
    >{%- if s.text != blank -%}<p class="bpageheader09__lead">{{ s.text | escape }}</p>{%- endif -%}
    {%- if s.show_search -%}
    <div role="search" class="bpageheader09__search" data-search data-t-one="{{ 'blko.page_header_09.one' | t }}" data-t-many="{{ 'blko.page_header_09.many' | t }}" data-t-first="{{ 'blko.page_header_09.first_four' | t }}" data-t-no="{{ 'blko.page_header_09.chapter' | t }}"
      ><label for="{{ qid }}" class="bpageheader09__cap bpageheader09__muted">{{ s.search_label | escape }}</label
      ><div class="bpageheader09__field"
        >{%- render 'blko-ui-icon', name: 'search', size: 20, stroke: 1.25, className: 'bpageheader09__sicon' -%}
        <input id="{{ qid }}" type="search" placeholder="{{ s.placeholder | escape }}" autocomplete="off" aria-controls="{{ qid }}-hits" aria-describedby="{{ qid }}-count" class="bpageheader09__input" data-q
        ><button type="button" aria-label="{{ 'blko.page_header_09.clear' | t }}" class="bpageheader09__clear" data-clear hidden>{%- render 'blko-ui-icon', name: 'x', size: 16, stroke: 1.25 -%}</button
      ></div
      ><p id="{{ qid }}-count" aria-live="polite" class="bpageheader09__count" data-count></p
      ><template data-none hidden>{{ 'blko.page_header_09.none' | t }} <a href="{{ s.contact_link | default: routes.root_url }}">{{ s.contact_label | escape }}</a> {{ 'blko.page_header_09.none_after' | t }}</template
      ><ul id="{{ qid }}-hits" class="bpageheader09__hits" data-hits hidden></ul
      ><template data-hit hidden><li><a href="#"><span class="bpageheader09__cap bpageheader09__no"></span><span class="bpageheader09__q"></span>{%- render 'blko-ui-icon', name: 'arrow-down-right', size: 16, stroke: 1.25, className: 'bpageheader09__harr' -%}</a></li></template
      >{%- if sugg.size > 0 -%}
      <div class="bpageheader09__sugg" data-sugg
        ><span class="bpageheader09__cap bpageheader09__muted bpageheader09__often">{{ s.often_label | escape }}</span
        >{%- for w in sugg -%}{%- assign w2 = w | strip -%}{%- if w2 != blank -%}<button type="button" class="bpageheader09__chip" data-word="{{ w2 | escape }}">{{ w2 | escape }}</button>{%- endif -%}{%- endfor -%}
      </div
      >{%- endif -%}
    </div
    >{%- endif -%}
  </div
>{%- endcapture -%}
<div class="bpageheader09{%- if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
  >{%- render 'blko-ui-section', surface: s.surface, bleed: true, label: s.label, className: 'bpageheader09__section', inner: 'bpageheader09__inner', children: body -%}
</div

>

{% schema %}
{
  "name": "FAQ header, search",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Region label",
      "default": "Page header: Questions"
    },
    {
      "type": "checkbox",
      "id": "show_crumbs",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "parent_label",
      "label": "Breadcrumb parent",
      "default": "Care"
    },
    {
      "type": "url",
      "id": "parent_link",
      "label": "Breadcrumb parent link"
    },
    {
      "type": "text",
      "id": "crumb",
      "label": "Current page in breadcrumb",
      "default": "Questions",
      "info": "Blank uses the page title."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions, answered"
    },
    {
      "type": "text",
      "id": "heading_em",
      "label": "Heading, italic word",
      "default": "plainly"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "What people ask before their first jar, from storing oils to using us beside a prescription."
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true,
      "info": "Searches the questions of the FAQ sections on this page."
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search the answers"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "retinol, returns, oily skin…"
    },
    {
      "type": "text",
      "id": "often_label",
      "label": "Suggestions label",
      "default": "Often asked"
    },
    {
      "type": "text",
      "id": "suggestions",
      "label": "Suggestions",
      "default": "retinol, oily skin, returns, delivery",
      "info": "Comma separated."
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "No-match link",
      "default": "Write to the apothecary"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "No-match link URL"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Colour",
      "options": [
        {
          "value": "alt",
          "label": "Alternate"
        },
        {
          "value": "bg",
          "label": "Background"
        },
        {
          "value": "pop-1",
          "label": "Pop 1"
        }
      ],
      "default": "alt"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Balm)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Repaints the section with a scheme from Theme settings > Colors. Works when Colors, fonts, corners reads the theme's tokens.",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "FAQ header, search"
    }
  ],
  "class": "blko-bundle"
}
{% endschema %}
