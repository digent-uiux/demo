        "info-9": {
          "type": "info",
          "settings": {
            "icon": "droplet",
            "title": "What it does",
            "body": "<p>A light oil of cold-pressed rosehip and sea buckthorn that softens dry, tight skin by evening and sinks in within a minute.</p>",
            "description": true
          }
        },
        "info-10": {
          "type": "info",
          "settings": {
            "icon": "hand-heart",
            "title": "How to use",
            "body": "<p>Warm three drops in your palms and press into clean skin, morning or night. Follow with cream if you like.</p>"
          }
        },
        "info-11": {
          "type": "info",
          "settings": {
            "icon": "leaf",
            "title": "Ingredients",
            "body": "<p>Rosa canina seed oil, Hippophae rhamnoides fruit oil, tocopherol. 100% from plants, 92% organic.</p>"
          }
        }
      },
