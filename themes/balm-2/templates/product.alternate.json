            "title": "Macerate",
            "from": 0,
            "to": 21,
            "text": "Dried calendula and rosehip steep in cold-pressed oil for three weeks, turned by hand each morning."
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "title": "Press",
            "from": 22,
            "text": "The herbs are pressed out through linen and the golden oil rests overnight."
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "title": "Pour",
            "from": 23,
            "text": "Oils go into amber glass, balms and bars into tins and moulds, all by hand."
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "title": "Label",
            "from": 24,
            "text": "Each piece gets a paper label with its batch code, then rests a few days before it ships."
          }
        }
