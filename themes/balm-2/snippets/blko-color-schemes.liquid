{%- comment -%}
  Per-section colour scheme (written by _tools/theme-schemes.py; regenerate instead of editing). A generated section
  whose picker is off its default gets `color-<scheme> blko-scheme-pick`: .color-scheme-N (blko-theme-styles) sets
  --color-*, blko-ds-tokens maps them to --blko-*, and this repaints the root + its blko-ui-section band, which beats the
  section's own (0,2,0) root rule and any surface class. Gradient wins when the scheme sets one.
{%- endcomment -%}
<style>
  .blko-scheme-pick.blko-scheme-pick.blko-scheme-pick,
  .blko-scheme-pick.blko-scheme-pick .blko-ui-section[class*="blko-ui-surface--"] {
    background: var(--color-bg-gradient, var(--color-bg)); color: var(--color-text);
    --blko-color-on-pop-1: var(--color-text); --blko-color-on-pop-2: var(--color-text); --blko-color-on-pop-3: var(--color-text); --blko-color-on-pop-4: var(--color-text);
  }
  /* *-inverse buttons were drawn for the section's own dark backdrop; in a picked scheme they take the scheme's button */
  .blko-scheme-pick.blko-scheme-pick.blko-scheme-pick .blko-ui-button--inverse {
    --blko-color-bg: var(--color-button); --blko-color-text: var(--color-button-text); --blko-color-bg-alt: var(--color-button-hover);
  }
  .blko-scheme-pick.blko-scheme-pick.blko-scheme-pick .blko-ui-button--outline-inverse,
  .blko-scheme-pick.blko-scheme-pick.blko-scheme-pick .blko-ui-button--ghost-inverse {
    --blko-color-bg: var(--color-text); --blko-color-text: var(--color-bg);
  }
</style>
