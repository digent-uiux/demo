{%- comment -%}
  Roast cart drawer: a modal <dialog> sliding in from the right. Espresso head with the Syne "Your bag" and a mono item
  count, a copper free-shipping bar, the real cart lines (photo, vendor, title, options, selling plan, line discounts,
  price, a −/+ stepper and Remove), then subtotal, cart discounts, the tax line and Check out (posts the cart form).
  Rendered once by layout/theme.liquid and re-rendered through the Section Rendering API (?sections=blko-cart-drawer, or
  the `sections` field of /cart/add.js and /cart/change.js); blko-cart-drawer.js swaps [data-drawer-body] and updates the
  header count (.rm-count). Opens from the header bag, after any add to cart, and on the "roast:cart" event.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
  assign free_c = s.free_over | times: 100
  assign subt = cart.items_subtotal_price
  assign left = free_c | minus: subt | at_least: 0
  assign capped = subt | at_most: free_c
  assign pct = 0
  if free_c > 0
    assign pct = capped | times: 100 | divided_by: free_c
  endif
-%}
{{ 'blko-cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-cart-drawer.js' | asset_url }}" defer="defer"></script>
<blko-cart-drawer class="bcd{%- if blko_sid != 'scheme-1' %} color-{{ blko_sid }}{% endif %}" data-count="{{ cart.item_count }}" data-enabled="{{ s.enabled }}">
  <dialog class="bcd__dialog{% if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}" aria-labelledby="bcd-title" data-dialog>
    <div class="bcd__panel" data-drawer-body data-count="{{ cart.item_count }}">
      <div class="bcd__head">
        <h2 id="bcd-title" class="bcd__title">{{ s.heading | escape }}</h2>
        <span class="bcd__label bcd__count">{{ 'blko.cart_drawer.count' | t: count: cart.item_count }}</span>
        <button type="button" class="bcd__close" data-close aria-label="{{ 'blko.cart_drawer.close' | t | escape }}">{%- render 'blko-icon', name: 'x', size: 20 -%}</button>
      </div>

      {%- if cart.item_count > 0 -%}
        {%- if free_c > 0 -%}
        <div class="bcd__ship">
          <p class="bcd__label">
            {%- if left > 0 -%}
              {%- assign left_m = left | money_without_trailing_zeros -%}{{ 'blko.cart_drawer.free_left' | t: amount: left_m }}
            {%- else -%}
              {{ 'blko.cart_drawer.free_done' | t }}
            {%- endif -%}
          </p>
          <div class="bcd__track" role="progressbar" aria-label="{{ 'blko.cart.shipping_progress' | t | escape }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}"><span style="width:{{ pct }}%"></span></div>
        </div>
        {%- endif -%}

        <ul class="bcd__lines" aria-label="{{ 'blko.cart.items' | t | escape }}">
          {%- for it in cart.items -%}
          <li class="bcd__line" data-key="{{ it.key }}">
            <a href="{{ it.url }}" class="bcd__img" tabindex="-1" aria-hidden="true">
              {%- if it.image != blank -%}
                {{ it.image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', widths: '120, 240', sizes: '88px' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <div class="bcd__info">
              {%- if it.vendor != blank -%}<p class="bcd__label bcd__muted">{{ it.vendor | escape }}</p>{%- endif -%}
              <a href="{{ it.url }}" class="bcd__name">{{ it.product.title | escape }}</a>
              {%- unless it.product.has_only_default_variant -%}
                <p class="bcd__meta">{% for o in it.options_with_values %}{{ o.value | escape }}{% unless forloop.last %} · {% endunless %}{% endfor %}</p>
              {%- endunless -%}
              {%- if it.selling_plan_allocation != blank -%}<p class="bcd__meta">{{ it.selling_plan_allocation.selling_plan.name | escape }}</p>{%- endif -%}
              {%- for d in it.line_level_discount_allocations -%}<p class="bcd__meta bcd__off">{{ d.discount_application.title | escape }} (−{{ d.amount | money }})</p>{%- endfor -%}
              <div class="bcd__row">
                <div class="bcd__qty" role="group" aria-label="{{ 'blko.cart.quantity_for' | t: title: it.product.title | escape }}">
                  <button type="button" data-qty="{{ it.quantity | minus: 1 }}" aria-label="{{ 'blko.cart.decrease' | t: title: it.product.title | escape }}">{%- render 'blko-icon', name: 'minus', size: 14 -%}</button>
                  <span>{{ it.quantity }}</span>
                  <button type="button" data-qty="{{ it.quantity | plus: 1 }}" aria-label="{{ 'blko.cart.increase' | t: title: it.product.title | escape }}">{%- render 'blko-icon', name: 'plus', size: 14 -%}</button>
                </div>
                <p class="bcd__price">
                  {%- if it.original_line_price != it.final_line_price -%}<s class="bcd__muted">{{ it.original_line_price | money }}</s> {% endif -%}
                  {{ it.final_line_price | money }}
                </p>
              </div>
              <button type="button" class="bcd__rm" data-qty="0">{{ 'blko.cart.remove' | t }}<span class="bcd__sr"> {{ it.product.title | escape }}</span></button>
            </div>
          </li>
          {%- endfor -%}
        </ul>

        <div class="bcd__foot">
          <dl class="bcd__sum">
            {%- for da in cart.cart_level_discount_applications -%}
              <div><dt class="bcd__muted">{{ da.title | escape }}</dt><dd>−{{ da.total_allocated_amount | money }}</dd></div>
            {%- endfor -%}
            <div class="bcd__total"><dt class="bcd__label">{{ 'blko.cart.subtotal' | t }}</dt><dd>{{ cart.total_price | money }}</dd></div>
          </dl>
          <p class="bcd__label bcd__muted">{% if cart.taxes_included %}{{ 'blko.cart.taxes_included' | t }}{% else %}{{ 'blko.cart.taxes_excluded' | t }}{% endif %}</p>
          <form action="{{ routes.cart_url }}" method="post" class="bcd__actions">
            <button type="submit" name="checkout" class="bcd__btn bcd__btn--main">{%- render 'blko-icon', name: 'lock', size: 16 -%}<span>{{ 'blko.cart.checkout' | t }}</span></button>
            <a href="{{ routes.cart_url }}" class="bcd__btn bcd__btn--ghost">{{ 'blko.cart_drawer.view' | t }}</a>
          </form>
        </div>
      {%- else -%}
        <div class="bcd__empty">
          <p class="bcd__eh">{{ s.empty_heading | escape }}</p>
          {%- if s.empty_text != blank -%}<p class="bcd__muted">{{ s.empty_text | escape }}</p>{%- endif -%}
          <a href="{{ s.empty_link | default: routes.all_products_collection_url }}" class="bcd__btn bcd__btn--main">{{ 'blko.cart.continue' | t }}</a>
        </div>
      {%- endif -%}
      <p class="bcd__sr" role="status" aria-live="polite" data-msg></p>
    </div>
  </dialog>
</blko-cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "tag": "div",
  "class": "blko-cart-drawer-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Panel colours. The head is always the scheme's text colour, inverted."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Open the drawer after add to cart",
      "default": true,
      "info": "Off: the header bag goes to the cart page."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your bag"
    },
    {
      "type": "number",
      "id": "free_over",
      "label": "Free shipping from (store currency, 0 = hide the bar)",
      "default": 45
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty heading",
      "default": "Nothing brewing yet."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "Fresh lots roast every Monday."
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "Empty button link"
    }
  ]
}
{% endschema %}
