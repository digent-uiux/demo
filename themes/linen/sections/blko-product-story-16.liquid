{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-ui-commerce.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-ui-commerce.js' | asset_url }}" defer="defer"></script>
{{ 'blko-product-story-16.css' | asset_url | stylesheet_tag }}
{%- render 'blko-fonts-linen', mode: 'faces', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font -%}
{%- capture blko_style -%}{% render 'blko-fonts-linen', mode: 'vars', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font %}--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px{%- endcapture -%}
{%- capture blko_class -%}bproductstory16{% if s.tokens == 'theme' %} bproductstory16--theme{% endif %}{% if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}{%- endcapture -%}
<script src="{{ 'blko-product-story-16.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign label = s.heading | strip_html
  assign card_label = 'blko.product_story_16.card' | t
  assign units_label = 'blko.product_story_16.units' | t
  assign unit_a = s.unit_a | default: 'Metric'
  assign unit_b = s.unit_b | default: 'Imperial'
  assign units = unit_a | append: '|' | append: unit_b | split: '|'
  assign tabs_id = section.id | append: '-units'
-%}
<blko-product-story-16>
{%- capture blko_body -%}
    <figure class="bproductstory16__collage">
      {%- render 'blko-ui-media', image: s.image, alt: s.image.alt, ratio: 'tall', priority: true, placeholder: 'lifestyle-1', className: 'bproductstory16__main' -%}
      <div class="bproductstory16__close">
        {%- render 'blko-ui-media', image: s.image_2, alt: s.image_2.alt, ratio: 'square', placeholder: 'image' -%}
      </div>
      {%- if s.tag_title != blank or s.tag_text != blank -%}
        <figcaption class="bproductstory16__tag">
          <span class="bproductstory16__tagtitle">{{ s.tag_title | escape }}</span>
          <span class="bproductstory16__tagtext">{{ s.tag_text | escape }}</span>
        </figcaption>
      {%- endif -%}
    </figure>
    <div class="bproductstory16__side">
      <div class="bproductstory16__story">
        <h2 class="bproductstory16__title">{{ s.heading }}</h2>
        <div class="bx-body bx-muted bproductstory16__rte">{{ s.text }}</div>
      </div>
      <div class="bproductstory16__tilt">
        <article aria-label="{{ card_label }}" class="bproductstory16__card">
          <div class="bproductstory16__selvedge">
            <span aria-hidden="true" class="bproductstory16__weave"></span>
            <span class="bx-label bx-muted bproductstory16__no">{{ s.card_label | escape }}</span>
          </div>
          <div class="bproductstory16__cardhead">
            <p class="bproductstory16__cardtitle">{{ s.card_title | escape }}</p>
            {%- render 'blko-ui-tabs', id: tabs_id, items: units, value: unit_a, label: units_label, className: 'bproductstory16__tabs' -%}
          </div>
          <dl class="bproductstory16__nums">
            {%- for b in section.blocks -%}
              {%- if b.type == 'number' -%}
                <div class="bproductstory16__num" data-a="{{ b.settings.value_a | escape }}|{{ b.settings.unit_a | escape }}" data-b="{{ b.settings.value_b | escape }}|{{ b.settings.unit_b | escape }}" {{ b.shopify_attributes }}>
                  <dt class="bproductstory16__nlabel">{{ b.settings.label | escape }}</dt>
                  <dd aria-live="polite" class="bproductstory16__nval"><span class="bproductstory16__big" data-v>{{ b.settings.value_a | escape }}</span><span class="bproductstory16__unit" data-u>{{ b.settings.unit_a | escape }}</span></dd>
                  {%- if b.settings.note != blank -%}<dd class="bx-label bx-muted bproductstory16__note">{{ b.settings.note | escape }}</dd>{%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        </article>
      </div>
      <div class="bproductstory16__pieces">
        {%- if s.pieces_label != blank -%}<p class="bx-label bx-muted">{{ s.pieces_label | escape }}</p>{%- endif -%}
        <ul class="bproductstory16__plist">
          {%- for b in section.blocks -%}
            {%- if b.type == 'piece' -%}
              {%- liquid
                assign pr = b.settings.product
                if pr != blank
                  assign name = pr.title
                  assign href = pr.url
                  assign price = pr.price | money
                  assign pimg = pr.featured_image
                else
                  assign name = b.settings.demo_title
                  assign href = routes.all_products_collection_url
                  assign price = b.settings.demo_price
                  assign pimg = ''
                endif
              -%}
              <li class="bproductstory16__piece" {{ b.shopify_attributes }}>
                <a href="{{ href }}" class="bproductstory16__plink">
                  {%- render 'blko-ui-media', image: pimg, alt: name, ratio: 'portrait', placeholder: 'product-1' -%}
                  <span class="bproductstory16__prow"><span class="bproductstory16__pname">{{ name | escape }}</span><span class="bx-muted bproductstory16__pprice">{{ price }}</span></span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if s.link_label != blank -%}
          {%- assign href = s.link | default: routes.all_products_collection_url -%}
          {%- assign lbl = s.link_label | escape -%}
          {%- render 'blko-ui-arrow-link', href: href, children: lbl -%}
        {%- endif -%}
      </div>
    </div>
{%- endcapture -%}
{%- render 'blko-ui-section', surface: 'soft-4', bleed: true, label: label, className: blko_class, style: blko_style, inner: 'bx-pad bproductstory16__grid', children: blko_body -%}
</blko-product-story-16>

{% schema %}
{
  "name": "Mill story, sample card",
  "tag": "div",
  "class": "blko-product-story-16-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main photo"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Close-up photo"
    },
    {
      "type": "text",
      "id": "tag_title",
      "label": "Photo tag",
      "default": "Loom room"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Photo tag line",
      "default": "Six shuttle looms, since 1962"
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Woven slowly, <em>by the river</em>",
      "info": "Wrap words in <em> to set them in italic."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our cloth comes from one family mill two hours inland. The flax is retted in the field, spun nearby and woven on old shuttle looms that run at half the speed of new ones. Slower looms leave a softer, tighter edge and a cloth that gets better with every wash.</p><p>We buy whole bolts each spring and cut only what you order, so nothing sits in a warehouse.</p>"
    },
    {
      "type": "header",
      "content": "Sample card"
    },
    {
      "type": "text",
      "id": "card_label",
      "label": "Card label",
      "default": "Sample No. 14 · Washed linen"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "The cloth, in numbers"
    },
    {
      "type": "text",
      "id": "unit_a",
      "label": "First unit tab",
      "default": "Metric"
    },
    {
      "type": "text",
      "id": "unit_b",
      "label": "Second unit tab",
      "default": "Imperial"
    },
    {
      "type": "header",
      "content": "Pieces"
    },
    {
      "type": "text",
      "id": "pieces_label",
      "label": "Pieces label",
      "default": "This bolt became"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop washed linen"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Fonts",
      "options": [
        {
          "value": "bundled",
          "label": "Bundled (EB Garamond + Albert Sans)"
        },
        {
          "value": "picker",
          "label": "Pick from the font library"
        },
        {
          "value": "theme",
          "label": "Use the theme's fonts"
        }
      ],
      "default": "bundled"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Colors and shapes"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, corners, type style",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Linen)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-radius-card, --blko-theme-button-case…). Other themes: keep the preset."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blko.linen.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "number",
      "name": "Cloth number",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Cloth weight"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Mid-weight: airy, never see-through"
        },
        {
          "type": "text",
          "id": "value_a",
          "label": "First value",
          "default": "185"
        },
        {
          "type": "text",
          "id": "unit_a",
          "label": "First unit",
          "default": "g/m²"
        },
        {
          "type": "text",
          "id": "value_b",
          "label": "Second value",
          "default": "5.5"
        },
        {
          "type": "text",
          "id": "unit_b",
          "label": "Second unit",
          "default": "oz/yd²"
        }
      ]
    },
    {
      "type": "piece",
      "name": "Piece",
      "limit": 2,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "demo_title",
          "label": "Demo name",
          "default": "Wrap dress",
          "info": "Shown while no product is picked."
        },
        {
          "type": "text",
          "id": "demo_price",
          "label": "Demo price",
          "default": "$168"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mill story, sample card",
      "blocks": [
        {
          "type": "number",
          "settings": {
            "label": "Cloth weight",
            "note": "Mid-weight: airy, never see-through",
            "value_a": "185",
            "unit_a": "g/m²",
            "value_b": "5.5",
            "unit_b": "oz/yd²"
          }
        },
        {
          "type": "number",
          "settings": {
            "label": "Threads",
            "note": "Counted across the warp",
            "value_a": "22",
            "unit_a": "per cm",
            "value_b": "56",
            "unit_b": "per inch"
          }
        },
        {
          "type": "number",
          "settings": {
            "label": "Yarn in one shirt",
            "note": "Spun from flax grown nearby",
            "value_a": "1.6",
            "unit_a": "km",
            "value_b": "1",
            "unit_b": "mile"
          }
        },
        {
          "type": "piece",
          "settings": {
            "demo_title": "Leather holdall",
            "demo_price": "$298"
          }
        },
        {
          "type": "piece",
          "settings": {
            "demo_title": "Wrap dress",
            "demo_price": "$168"
          }
        }
      ]
    }
  ]
}
{% endschema %}
