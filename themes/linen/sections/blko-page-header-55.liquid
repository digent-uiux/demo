{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-page-header-55.css' | asset_url | stylesheet_tag }}
{%- render 'blko-fonts-linen', mode: 'faces', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font -%}
{%- capture blko_style -%}{% render 'blko-fonts-linen', mode: 'vars', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font %}--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px{%- endcapture -%}
{%- capture blko_class -%}bpageheader55{% if s.tokens == 'theme' %} bpageheader55--theme{% endif %}{% if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}{%- endcapture -%}
{%- liquid
  assign crumb = s.crumb | default: page.title | default: s.heading
  assign label = s.heading | strip_html
  assign crumbs_label = 'blko.page_header_55.breadcrumb' | t
  assign hours_label = 'blko.page_header_55.hours' | t
  assign reply_label = 'blko.page_header_55.reply' | t
-%}
{%- capture blko_body -%}
    <div class="bpageheader55__col">
      <nav aria-label="{{ crumbs_label }}">
        <ol class="bpageheader55__crumbs">
          <li><a href="{{ routes.root_url }}">{{ s.home_label | escape }}</a></li>
          <li aria-hidden="true">~</li>
          <li aria-current="page" class="bpageheader55__here">{{ crumb | escape }}</li>
        </ol>
      </nav>
      <h1 class="bpageheader55__title">{{ s.heading | escape }}</h1>
      {%- if s.text != blank -%}<p class="bx-body bx-muted bpageheader55__text">{{ s.text | escape }}</p>{%- endif -%}
      {%- if s.hours != blank or s.reply != blank -%}
        <div class="bpageheader55__tagwrap">
          <svg viewBox="0 0 80 40" aria-hidden="true" class="bpageheader55__string"><path d="M80 20c-14 0-18-14-30-12S36 30 22 26 6 10 0 14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
          <div class="bpageheader55__tag">
            <span aria-hidden="true" class="bpageheader55__eyelet"></span>
            <dl class="bpageheader55__dl">
              {%- if s.hours != blank -%}<div><dt class="bx-sr">{{ hours_label }}</dt><dd>{{ s.hours | escape }}</dd></div>{%- endif -%}
              {%- if s.reply != blank -%}<div><dt class="bx-sr">{{ reply_label }}</dt><dd class="bpageheader55__reply">{{ s.reply | escape }}</dd></div>{%- endif -%}
            </dl>
          </div>
        </div>
      {%- endif -%}
    </div>
{%- endcapture -%}
{%- render 'blko-ui-section', surface: 'bg', bleed: true, label: label, className: blko_class, style: blko_style, inner: 'bx-pad bpageheader55__in', children: blko_body -%}

{% schema %}
{
  "name": "Page header, hang tag",
  "tag": "div",
  "class": "blko-page-header-55-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home crumb",
      "default": "home"
    },
    {
      "type": "text",
      "id": "crumb",
      "label": "Current crumb",
      "default": "write to us",
      "info": "Leave empty to use the page title."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A letter, a question, a mend"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tell us what you are wearing it for, or what tore. We read everything at the cutting table."
    },
    {
      "type": "header",
      "content": "Hang tag"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "Mon – Sat, 9 till 5"
    },
    {
      "type": "text",
      "id": "reply",
      "label": "Reply promise",
      "default": "a reply within one day"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Fonts",
      "options": [
        {
          "value": "bundled",
          "label": "Bundled (EB Garamond + Albert Sans)"
        },
        {
          "value": "picker",
          "label": "Pick from the font library"
        },
        {
          "value": "theme",
          "label": "Use the theme's fonts"
        }
      ],
      "default": "bundled"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Colors and shapes"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, corners, type style",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Linen)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-radius-card, --blko-theme-button-case…). Other themes: keep the preset."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blko.linen.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Page header, hang tag"
    }
  ]
}
{% endschema %}
