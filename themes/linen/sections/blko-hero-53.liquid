{%- liquid
  assign s = section.settings
  assign blko_sid = s.color_scheme.id | default: s.color_scheme | default: 'scheme-1'
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-hero-53.css' | asset_url | stylesheet_tag }}
{%- render 'blko-fonts-linen', mode: 'faces', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font -%}
{%- capture blko_style -%}{% render 'blko-fonts-linen', mode: 'vars', source: s.font_source, heading_font: s.heading_font, body_font: s.body_font %}--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px{%- endcapture -%}
{%- capture blko_class -%}bhero53{% if s.tokens == 'theme' %} bhero53--theme{% endif %}{% if blko_sid != 'scheme-1' %} color-{{ blko_sid }} blko-scheme-pick{% endif %}{%- endcapture -%}
{%- assign label = s.heading | strip_html -%}
{%- capture blko_body -%}
    <div class="bhero53__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 2000 | image_tag: class: 'bhero53__img', loading: 'eager', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: s.image.alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'bhero53__img' }}
      {%- endif -%}
    </div>
    <div class="bhero53__wrap">
      <div class="bhero53__card">
        <h1 class="bhero53__title bx-h1">{{ s.heading }}</h1>
        {%- if s.text != blank -%}<p class="bhero53__text bx-body bx-muted">{{ s.text }}</p>{%- endif -%}
        {%- if s.button_label != blank -%}
          {%- assign href = s.button_link | default: routes.all_products_collection_url -%}
          {%- assign lbl = s.button_label | escape -%}
          {%- render 'blko-ui-button', href: href, shape: 'pill', className: 'bhero53__btn', children: lbl -%}
        {%- endif -%}
      </div>
    </div>
{%- endcapture -%}
{%- render 'blko-ui-section', surface: 'bg', bleed: true, full: true, label: label, className: blko_class, style: blko_style, inner: 'bx-pad--y bhero53__grid', children: blko_body -%}

{% schema %}
{
  "name": "Hero, photo + card",
  "tag": "div",
  "class": "blko-hero-53-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for slow summers"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Washed linen and cotton cut to be worn for years, not seasons."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop summer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Fonts",
      "options": [
        {
          "value": "bundled",
          "label": "Bundled (EB Garamond + Albert Sans)"
        },
        {
          "value": "picker",
          "label": "Pick from the font library"
        },
        {
          "value": "theme",
          "label": "Use the theme's fonts"
        }
      ],
      "default": "bundled"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Colors and shapes"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, corners, type style",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Linen)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-radius-card, --blko-theme-button-case…). Other themes: keep the preset."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blko.linen.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero, photo + card"
    }
  ]
}
{% endschema %}
