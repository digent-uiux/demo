<dialog id="LinenSearch" class="blko-linen-dialog blko-linen-search" data-linen-search aria-labelledby="LinenSearchTitle">
  <header class="blko-linen-dialog__head"><h2 id="LinenSearchTitle">{{ 'blko.header.search' | t }}</h2>{% assign close = 'blko.linen.close' | t %}{% render 'blko-ui-button', type: 'button', variant: 'ghost', size: 'sm', children: close, attrs: 'data-linen-search-close' %}</header>
  <form action="{{ routes.search_url }}" method="get" role="search" class="blko-linen-search__form" data-linen-predictive-form data-endpoint="{{ routes.predictive_search_url }}" data-loading="{{ 'blko.linen.search_loading' | t | escape }}" data-error="{{ 'blko.linen.search_error' | t | escape }}" data-count="{{ 'blko.linen.search_count' | t: count: '[count]' | escape }}">
    <div class="blko-linen-search__field">{% assign label = 'blko.search.label' | t %}{% assign placeholder = 'blko.search.placeholder' | t %}{% render 'blko-ui-input', id: 'LinenSearchInput', name: 'q', type: 'search', autocomplete: 'off', placeholder: placeholder, label: label %}{% assign search_label = 'blko.search.submit' | t %}{% render 'blko-ui-button', type: 'submit', children: search_label %}</div>
    <input type="hidden" name="type" value="product,article"><input type="hidden" name="options[prefix]" value="last">
    <p class="blko-linen-search__status" data-linen-search-status role="status" aria-live="polite"></p>
    <div id="LinenSearchPanel" data-linen-predictive-panel role="listbox" aria-label="{{ 'blko.linen.search_suggestions' | t | escape }}" hidden></div>
    <div class="blko-linen-search__empty" data-search-empty><p>{{ 'blko.linen.popular' | t }}</p><ul>{% if settings.linen_search_menu.links.size > 0 %}{% for link in settings.linen_search_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}{% else %}<li><a href="{{ routes.all_products_collection_url }}">{{ 'blko.cart.continue' | t }}</a></li>{% endif %}</ul>{% assign trending = settings.linen_search_collection | default: collections.all %}{% if trending.products.size > 0 %}<p>{{ 'blko.linen.trending' | t }}</p><ul class="blko-linen-search__trending">{% for piece in trending.products limit: 4 %}<li><a href="{{ piece.url }}">{% if piece.featured_image %}{{ piece.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: piece.featured_image.alt }}{% endif %}<span>{{ piece.title | escape }}</span></a></li>{% endfor %}</ul>{% endif %}</div>
  </form>
</dialog>
