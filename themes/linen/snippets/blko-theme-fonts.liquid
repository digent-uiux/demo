{%- comment -%}
  GENERATED by liquid/_tools/sync-theme.py, do not edit. Self-hosted DS fonts (Google Fonts, SIL OFL), latin subset.
  Used when Theme settings > Typography > Font source is "Theme fonts".
{%- endcomment -%}
<style>
{%- case settings.theme_font_pair -%}
  {%- when 'default' -%}
  @font-face { font-family: 'EB Garamond'; font-style: italic; font-weight: 400 500; font-display: swap; src: url({{ 'blko-font-eb-garamond-bc5f3a.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'EB Garamond'; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'blko-font-eb-garamond-0652b7.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Albert Sans'; font-style: normal; font-weight: 400 700; font-display: swap; src: url({{ 'blko-font-albert-sans-949fc9.woff2' | asset_url }}) format('woff2'); }
  .blko-theme { --font-heading: 'EB Garamond', Georgia, serif; --font-heading-weight: 500; --font-body: 'Albert Sans', system-ui, sans-serif; --font-body-weight: 400; --font-mono: var(--font-body); --blko-font-mono: var(--font-mono); }
  {%- when 'sand' -%}
  @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'blko-font-fraunces-8a38eb.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Jost'; font-style: normal; font-weight: 400 700; font-display: swap; src: url({{ 'blko-font-jost-0428ef.woff2' | asset_url }}) format('woff2'); }
  .blko-theme { --font-heading: 'Fraunces', Georgia, serif; --font-heading-weight: 400; --font-body: 'Jost', system-ui, sans-serif; --font-body-weight: 400; --font-mono: var(--font-body); --blko-font-mono: var(--font-mono); }
  {%- when 'indigo' -%}
  @font-face { font-family: 'EB Garamond'; font-style: italic; font-weight: 400 500; font-display: swap; src: url({{ 'blko-font-eb-garamond-bc5f3a.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'EB Garamond'; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'blko-font-eb-garamond-0652b7.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Albert Sans'; font-style: normal; font-weight: 400 700; font-display: swap; src: url({{ 'blko-font-albert-sans-949fc9.woff2' | asset_url }}) format('woff2'); }
