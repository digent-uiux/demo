  {%- when 'olive' -%}
  @font-face { font-family: 'Newsreader'; font-style: italic; font-weight: 400; font-display: swap; src: url({{ 'blko-font-newsreader-0d8517.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Newsreader'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'blko-font-newsreader-7aea8c.woff2' | asset_url }}) format('woff2'); }
