{%- comment -%}
  Links to the accounts set in Theme settings > Social media, in the footer base line. Renders nothing when none is set.
{%- endcomment -%}
{%- liquid
  assign networks = 'instagram,facebook,tiktok,pinterest,youtube,x' | split: ','
  assign names = 'Instagram,Facebook,TikTok,Pinterest,YouTube,X' | split: ','
  assign any = false
  for n in networks
    assign key = 'social_' | append: n | append: '_link'
    if settings[key] != blank
      assign any = true
    endif
  endfor
-%}
{%- if any -%}
  <ul class="ftr__social" role="list">
    {%- for n in networks -%}
      {%- assign key = 'social_' | append: n | append: '_link' -%}
      {%- if settings[key] != blank -%}
        <li><a href="{{ settings[key] | escape }}" target="_blank" rel="noopener">{{ names[forloop.index0] }}</a></li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
