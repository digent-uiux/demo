<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if request.design_mode %} class="lv3-editor"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_schemes['scheme-5'].settings.background | default: '#2F3A2A' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'blko-lv3-mark.png' | asset_url }}">
    {%- endif -%}
    {%- comment -%} The brand name (Theme settings > Logo > Wordmark), else the store name, in the tab title and share tags. {%- endcomment -%}
    {%- assign lv3_brand = settings.logo_text | strip | default: shop.name -%}
    <title>
      {%- if page_title == blank or page_title == shop.name -%}
        {{ lv3_brand }}
      {%- else -%}
        {{ page_title }}
        {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
        {%- unless page_title contains lv3_brand %} &ndash; {{ lv3_brand }}{% endunless -%}
      {%- endif -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <meta property="og:site_name" content="{{ lv3_brand | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:description" content="{{ page_description | default: shop.description | default: lv3_brand | escape }}">
    {%- if page_image -%}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    {{ content_for_header }}
  </head>
  <body class="lv3 template-{{ template.name | handle }}{% if template.suffix != blank %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}">
    <a class="lv3-skip" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    {%- if request.page_type == 'policy' -%}{{ 'blko-lv3-policy.css' | asset_url | stylesheet_tag }}{%- endif -%}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
  </body>
</html>
