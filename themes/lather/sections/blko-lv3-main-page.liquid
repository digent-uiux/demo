{%- comment -%} Generic page (templates/page.json): title and the page content in the Lather type. {%- endcomment -%}
<div class="lv3-page" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <div class="lv3-page__in">
      {%- if section.settings.show_title -%}<h1 class="h1 lv3-page__title" data-rv="blur">{{ page.title | escape }}</h1>{%- endif -%}
      <div class="lv3-rte">{{ page.content }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lather page",
  "tag": "section",
  "class": "lv3-main-page-sec",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show the title", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
