{%- comment -%} All collections (templates/list-collections.json): image cards with title and product count. {%- endcomment -%}
<div class="lv3-page">
  <div class="wrap">
    {%- if section.settings.title != blank -%}<h1 class="h1" data-rv="blur">{{ section.settings.title }}</h1>{%- endif -%}
    {%- if collections.size > 0 -%}
      <div class="lv3-cols" style="--cols:{{ section.settings.columns }}">
        {%- for c in collections -%}
          <a class="lv3-coll" href="{{ c.url }}" data-rv="settle">
            <div class="lv3-coll__img">
              {%- assign cimg = c.featured_image | default: c.products.first.featured_media.preview_image -%}
              {%- if cimg != blank -%}
                {{ cimg | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 900px) 33vw, 50vw', loading: 'lazy', alt: c.title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'blko-lv3-ph' }}
              {%- endif -%}
            </div>
            <h2>{{ c.title | escape }}</h2>
            {%- if section.settings.show_count -%}<p class="small">{{ section.settings.count_label | replace: '[count]', c.products_count }}</p>{%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="lead" style="margin-top:24px">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Lather collections list",
  "tag": "section",
  "class": "lv3-list-collections-sec",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Shop by <em>need</em>" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "text", "id": "count_label", "label": "Count ([count])", "default": "[count] products" }
  ]
}
{% endschema %}
