{%- comment -%} Password page: logo, message, sign-up ({% form 'customer' %}) and the storefront password form. {%- endcomment -%}
{%- assign lv3_sid = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1' -%}
<div class="lv3-page{%- if lv3_sid != 'scheme-1' %} color-{{ lv3_sid }} lv3-scheme-pick{% endif %}" style="min-height:100svh;display:grid;place-items:center">
  <div class="wrap" style="width:100%">
    <div class="lv3-card" style="max-width:560px;margin:0 auto">
      <span class="logo" style="width:150px;height:56px" aria-label="{{ shop.name | escape }}" role="img"></span>
      <h1 class="h2">{{ section.settings.title }}</h1>
      {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'customer', class: 'lv3-form' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="small" role="status">{{ 'general.password_page.thanks' | t }}</p>
        {%- else -%}
          <label class="sr" for="lv3PwEmail">{{ 'general.password_page.email' | t }}</label>
          <input id="lv3PwEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'general.password_page.email' | t }}" required>
          <button class="btn btn--primary" type="submit">{{ 'general.password_page.notify' | t }}</button>
          {%- if form.errors -%}<p class="lv3-err" style="flex-basis:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <details>
        <summary class="link" style="cursor:pointer">{{ 'general.password_page.login' | t }}</summary>
        {%- form 'storefront_password', class: 'lv3-form' -%}
          <label class="sr" for="lv3Pw">{{ 'general.password_page.password' | t }}</label>
          <input id="lv3Pw" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_page.password' | t }}" style="margin-top:12px">
          <button class="btn btn--ghost" type="submit" style="margin-top:12px">{{ 'general.password_page.submit' | t }}</button>
          {%- if form.errors -%}<p class="lv3-err" style="flex-basis:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
        <p class="small" style="margin-top:12px"><a class="link" href="/admin">{{ 'general.password_page.admin' | t }}</a></p>
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lather password",
  "tag": "section",
  "class": "lv3-password-sec",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Opening <em>soon</em>." }
  ]
}
{% endschema %}
