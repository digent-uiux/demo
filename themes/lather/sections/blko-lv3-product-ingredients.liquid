{%- comment -%}
  Lather v3, product page: ingredients (home-v3/pages/product/20-ingredients.html).
  One photo bleeds off the left edge (image picker, Shopify placeholder until set); heading and intro beside it;
  ingredient blocks in a two-column list, each with a line icon from the theme's set; a details toggle with the complete list.
  The complete list is the product's custom.ingredients metafield when it is set, else the "Complete list" setting.
{%- endcomment -%}
{{ 'blko-lv3-product-ingredients.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign anchor = s.anchor | handleize | default: 'pdp-ingredients'
  assign full = s.full_list
  if product != blank and product.metafields.custom.ingredients != blank
    assign full = product.metafields.custom.ingredients.value | strip_html
  endif
  assign img_pos = ''
  if s.image != blank and s.image.presentation.focal_point != blank
    assign img_pos = 'object-position: ' | append: s.image.presentation.focal_point
  endif
-%}
{%- assign lv3_sid = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-2' -%}
<section class="s-pdp-ingredients{%- if lv3_sid != 'scheme-2' %} color-{{ lv3_sid }} lv3-scheme-pick{% endif %}" id="{{ anchor }}" aria-labelledby="{{ anchor }}-title">
  <div class="s-pdp-ingredients__layout">
    <div class="s-pdp-ingredients__intro">
      <h2 class="h2" id="{{ anchor }}-title" data-rv="line">
        {%- if s.heading_1 != blank -%}<span class="ln"><span>{{ s.heading_1 }}</span></span>{%- endif -%}
        {%- if s.heading_2 != blank -%}<span class="ln"><span>{{ s.heading_2 }}</span></span>{%- endif -%}
      </h2>
      {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <figure class="s-pdp-ingredients__media" data-rv="zoom">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: widths: '500, 700, 900, 1200, 1400', sizes: '(max-width: 760px) 100vw, 44vw', loading: 'lazy', alt: s.image_alt | default: s.image.alt, style: img_pos }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'blko-lv3-ph' }}
      {%- endif -%}
    </figure>
    <div class="s-pdp-ingredients__list">
      {%- for block in section.blocks -%}
        {%- assign odd = forloop.index0 | modulo: 2 -%}
        <article class="s-pdp-ingredients__item" data-rv="blur"{% if odd == 1 %} data-rv-delay="1"{% endif %} {{ block.shopify_attributes }}>
          {%- assign ic = block.settings.icon -%}
          {%- if ic != 'none' -%}
            <span class="s-pdp-ingredients__icon" aria-hidden="true"><svg viewBox="0 0 24 24">
              {%- case ic -%}
                {%- when 'drop' -%}<path d="M12 3.5c3.4 4.2 5.5 7.4 5.5 10.2a5.5 5.5 0 0 1-11 0c0-2.8 2.1-6 5.5-10.2z"/><path d="M9.6 14.4a2.5 2.5 0 0 0 2 2.3"/>
                {%- when 'foam' -%}<circle cx="9.5" cy="14" r="4.5"/><circle cx="16.8" cy="8.6" r="2.7"/><circle cx="17.2" cy="16.6" r="1.7"/><path d="M7.4 12.6a2.4 2.4 0 0 1 1.6-1.2"/>
                {%- when 'no_scent' -%}<path d="M8 10.5h8a1 1 0 0 1 1 1V19a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-7.5a1 1 0 0 1 1-1z"/><path d="M10 10.5V8h4v2.5M9.5 5h5"/><path d="M4.5 4.5l15 15"/>
                {%- when 'bar' -%}<rect x="4" y="9" width="16" height="10" rx="3"/><circle cx="9" cy="5.5" r="1.8"/><circle cx="14.5" cy="4.5" r="1.1"/>
                {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19c3-4 6-7 9-9"/>
                {%- when 'flower' -%}<circle cx="12" cy="9" r="2.2"/><path d="M12 6.8c-.9-2.4-.5-3.6 0-4.3.5.7.9 1.9 0 4.3zM14.2 9c2.4-.9 3.6-.5 4.3 0-.7.5-1.9.9-4.3 0zM9.8 9c-2.4.9-3.6.5-4.3 0 .7-.5 1.9-.9 4.3 0zM12 11.2V21M12 17c-1.8-.2-3.2-1.2-3.8-3 1.9-.1 3.2.9 3.8 3z"/>
                {%- else -%}<path d="M12 21v-9"/><path d="M12 12.5c-.2-3.6.4-6.4 2.2-8.5 1.2 2.7.6 5.6-2.2 8.5z"/><path d="M12 15.5c-2.4-.4-4.4-1.8-5.4-4.3 2.6-.2 4.5.9 5.4 4.3z"/><path d="M12 18.5c2.4-.4 4.4-1.8 5.4-4.3-2.6-.2-4.5.9-5.4 4.3z"/>
              {%- endcase -%}
            </svg></span>
          {%- endif -%}
          <div><h3>{{ block.settings.title | escape }}</h3>{%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}</div>
        </article>
      {%- endfor -%}
      {%- if s.summary != blank and full != blank -%}
        <details class="s-pdp-ingredients__full"><summary>{{ s.summary | escape }}</summary><p id="pdp-full-ingredients">{{ full | escape }}</p>{%- if s.note != blank -%}<p>{{ s.note | escape }}</p>{%- endif -%}</details>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lather PDP ingredients",
  "class": "blko-lv3-section-product-ingredients",
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "inline_richtext", "id": "heading_1", "label": "Heading, line 1", "default": "A list you" },
    { "type": "inline_richtext", "id": "heading_2", "label": "Heading, line 2", "default": "can <em>read.</em>", "info": "Italic text shows in the accent style." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "What goes in matters. So does what we leave out: added fragrance, SLS and colour." },
    { "type": "image_picker", "id": "image", "label": "Ingredient photo", "info": "Shows full height beside the list. A close photo of one key ingredient works best." },
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "A bowl of rolled oats seen from above on a pale stone surface" },
    { "type": "header", "content": "Complete list" },
    { "type": "text", "id": "summary", "label": "Toggle label", "default": "Read the complete ingredient list" },
    { "type": "textarea", "id": "full_list", "label": "Complete list", "default": "Water, glycerin, coco-glucoside, decyl glucoside, colloidal oat, shea butter, sunflower seed oil, xanthan gum, citric acid, sodium benzoate. pH 5.5.", "info": "A product with the custom.ingredients metafield shows that instead." },
    { "type": "textarea", "id": "note", "label": "Allergy note", "default": "Contains oat. Check the full list against your known allergies before using." },
    { "type": "header", "content": "Section" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "pdp-ingredients" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "oat", "options": [
          { "value": "oat", "label": "Oat" },
          { "value": "drop", "label": "Drop" },
          { "value": "foam", "label": "Foam" },
          { "value": "no_scent", "label": "No added scent" },
          { "value": "flower", "label": "Flower" },
          { "value": "bar", "label": "Soap bar" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "none", "label": "None" }
        ] },
        { "type": "text", "id": "title", "label": "Name", "default": "Colloidal oat" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Finely milled oat, in a wash made for everyday dry skin." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lather PDP ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "icon": "oat", "title": "Colloidal oat", "text": "Finely milled oat, in a wash made for everyday dry skin." } },
        { "type": "ingredient", "settings": { "icon": "drop", "title": "Glycerin", "text": "A familiar humectant in the formula, for a comfortable wash." } },
        { "type": "ingredient", "settings": { "icon": "foam", "title": "Gentle cleansers", "text": "Coco-glucoside and decyl glucoside make the soft foam." } },
        { "type": "ingredient", "settings": { "icon": "no_scent", "title": "No added scent", "text": "Fragrance-free means no perfume or essential oil added to Calm wash." } }
      ]
    }
  ]
}
{% endschema %}
