[
  {
    "name": "theme_info",
    "theme_name": "Lather",
    "theme_author": "Blocko",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "text",
        "id": "logo_text",
        "label": "Wordmark",
        "default": "Lather",
        "info": "Shown in the header and footer when no logo image is set and the Lather logo is off in the header. Empty uses the store name."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Used by the header and footer before their own logo setting. Leave empty to keep the Lather logo."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 320,
        "step": 4,
        "unit": "px",
        "default": 120,
        "info": "120 keeps the Lather sizes (header 118px, 100px on phones, footer 132px). Other values set the header logo width."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Blank = the Lather mark."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#EEE8DC"
          },
          {
            "type": "color",
            "id": "background_alt",
            "label": "Alternate background",
            "default": "#F7F3EA"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Replaces the solid background when set."
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#262B22"
          },
          {
            "type": "color",
            "id": "text_muted",
            "label": "Muted text",
            "default": "#5F6354"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Borders",
            "default": "#D3CAB6"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#5E6B4E"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button",
            "default": "#2F3A2A"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#EEE8DC"
          },
          {
            "type": "color",
            "id": "button_hover",
            "label": "Button hover",
            "default": "#262B22"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      },
      {
        "type": "paragraph",
        "content": "Lather ships five schemes: 1 Oat (page), 2 Raised (header, cards, popups), 3 Sage wash, 4 Stone (footer), 5 Deep (announcement, hero, dark bands). Every section has its own scheme picker."
      },
      {
        "type": "color_scheme",
        "id": "page_color_scheme",
        "label": "Page color scheme",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "Shared"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price",
        "default": "#8A4B2A"
      },
      {
        "type": "color",
        "id": "color_input_bg",
        "label": "Input background",
        "default": "#F7F3EA"
      },
      {
        "type": "color",
        "id": "color_input_text",
        "label": "Input text",
        "default": "#262B22"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1320
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Space between sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 0,
        "info": "Added on top of each section's own padding."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "font_source",
        "label": "Font source",
        "options": [
          {
            "value": "theme",
            "label": "Theme fonts"
          },
          {
            "value": "shopify",
            "label": "Shopify library"
          }
        ],
        "default": "theme",
        "info": "Theme fonts uses the bundled Lather files. Shopify library uses the Headings and Body fonts below (the accent word takes the heading font)."
      },
      {
        "type": "select",
        "id": "theme_font_pair",
        "label": "Bundled font pair",
        "options": [
          {
            "value": "default",
            "label": "Default (Urbanist + Yeseva One)"
          }
        ],
        "default": "default",
        "info": "Applies only to Theme fonts: Urbanist for text and headings, Yeseva One for the accent word in headings, Antonio for prices."
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Headings",
        "default": "urbanist_n5"
      },
      {
        "type": "checkbox",
        "id": "heading_italic",
        "label": "Italic accent words in headings",
        "default": false,
        "info": "The accent word in a heading is the text set in italics in the editor."
      },
      {
        "type": "select",
        "id": "heading_case",
        "label": "Heading text",
        "options": [
          {
            "value": "none",
            "label": "As typed"
          },
          {
            "value": "uppercase",
            "label": "Capitals"
          }
        ],
        "default": "none"
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "label": "Heading letter spacing",
        "min": -6,
        "max": 10,
        "step": 0.5,
        "unit": "%",
        "default": -2,
        "info": "Hundredths of an em."
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body",
        "default": "urbanist_n4"
      },
      {
        "type": "range",
        "id": "type_scale",
        "label": "Type scale",
        "min": 90,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Buttons and shapes",
    "settings": [
      {
        "type": "select",
        "id": "button_case",
        "label": "Button text",
        "options": [
          {
            "value": "none",
            "label": "Sentence case"
          },
          {
            "value": "uppercase",
            "label": "Capitals"
          }
        ],
        "default": "none"
      },
      {
        "type": "range",
        "id": "button_tracking",
        "label": "Button letter spacing",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "%",
        "default": 0,
        "info": "Hundredths of an em."
      },
      {
        "type": "select",
        "id": "button_weight",
        "label": "Button weight",
        "options": [
          {
            "value": "400",
            "label": "Regular"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semibold"
          },
          {
            "value": "700",
            "label": "Bold"
          },
          {
            "value": "800",
            "label": "Extra bold"
          }
        ],
        "default": "600"
      },
      {
        "type": "range",
        "id": "radius_button",
        "label": "Button corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 8,
        "info": "40 makes pill buttons."
      },
      {
        "type": "range",
        "id": "radius_card",
        "label": "Card corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 6
      },
      {
        "type": "range",
        "id": "radius_image",
        "label": "Image corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 6
      },
      {
        "type": "range",
        "id": "radius_input",
        "label": "Input corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 8
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "header",
        "content": "Accounts"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/your-shop"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/your-shop"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@your-shop"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "info": "https://pinterest.com/your-shop"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "info": "https://youtube.com/@your-shop"
      },
      {
        "type": "text",
        "id": "social_x_link",
        "label": "X",
        "info": "https://x.com/your-shop"
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Product image ratio",
        "options": [
          {
            "value": "4/5",
            "label": "Portrait 4:5"
          },
          {
            "value": "1/1",
            "label": "Square"
          },
          {
            "value": "3/4",
            "label": "Tall 3:4"
          }
        ],
        "default": "4/5"
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show rating on cards",
        "default": false,
        "info": "Reads the reviews.rating metafield."
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor on cards",
        "default": false
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "text",
        "id": "free_shipping_note",
        "label": "Shipping note under buy buttons",
        "info": "Shown under the buy buttons when the product page has no shipping note block of its own."
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping from",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "$",
        "default": 40,
        "info": "In the shop currency. Drives the bar in the bag drawer; 0 hides it."
      },
      {
        "type": "header",
        "content": "Free gift"
      },
      {
        "type": "range",
        "id": "free_gift_threshold",
        "label": "Free gift from",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "$",
        "default": 60,
        "info": "In the shop currency, gift excluded. The gift is added to the bag at this amount and taken out below it; 0 turns it off. Shares one progress bar with free shipping."
      },
      {
        "type": "product",
        "id": "free_gift_product",
        "label": "Gift product",
        "info": "Added through the cart with the hidden property _gift. Its price only becomes 0 with an automatic discount in Shopify admin: Discounts > Buy X get Y, Customer spends minimum purchase amount = the amount above, Customer gets 1 of this product at 100% off, max 1 use per order. Without a product, only the theme's demo bag shows the gift."
      },
      {
        "type": "text",
        "id": "free_gift_name",
        "label": "Gift name in the progress text",
        "default": "Oat bar",
        "info": "Blank = product title."
      },
      {
        "type": "text",
        "id": "free_gift_value",
        "label": "Demo gift value in cents",
        "default": "900",
        "info": "Used only without a gift product (its price is used instead)."
      },
      {
        "type": "text",
        "id": "free_gift_key",
        "label": "Demo gift product key",
        "default": "bar",
        "info": "Image and size for the demo gift come from this product key (bar = Oat bar)."
      },
      {
        "type": "text",
        "id": "free_gift_msg_empty",
        "label": "Empty bag, both offers",
        "default": "Free shipping over [ship], and a free [name] over [amount]."
      },
      {
        "type": "text",
        "id": "free_gift_msg_left",
        "label": "Gift still to go",
        "default": "[amount] more for a free [name].",
        "info": "After free shipping is reached the shipping message comes first."
      },
      {
        "type": "text",
        "id": "free_gift_msg_done",
        "label": "Gift in the bag",
        "default": "Your free [name] ([value] value) is in your bag."
      },
      {
        "type": "text",
        "id": "free_gift_msg_off",
        "label": "Gift removed by the shopper",
        "default": "Your free [name] is still yours to take."
      },
      {
        "type": "text",
        "id": "free_gift_add",
        "label": "Add the gift back",
        "default": "Add my free [name]"
      },
      {
        "type": "text",
        "id": "free_gift_note",
        "label": "Gift line note",
        "default": "Free gift, [value] value"
      },
      {
        "type": "text",
        "id": "free_gift_free",
        "label": "Gift line price",
        "default": "Free"
      },
      {
        "type": "text",
        "id": "free_gift_remove",
        "label": "Remove the gift (screen readers)",
        "default": "Remove free [name]"
      },
      {
        "type": "text",
        "id": "free_gift_step_ship",
        "label": "Bar label, shipping",
        "default": "Free shipping, [amount]"
      },
      {
        "type": "text",
        "id": "free_gift_step_gift",
        "label": "Bar label, gift",
        "default": "[name], [amount]"
      },
      {
        "type": "text",
        "id": "free_gift_bar_label",
        "label": "Progress bar (screen readers)",
        "default": "Progress toward free shipping and a free gift"
      }
    ]
  }
]
